data: {"index": 2, "title": "Chandra-synergy creatures and token triggers", "explanation": "Small creatures that trigger or benefit from Chandra planeswalker activations increase the deck's damage density and provide consistent extra damage or bodies to push through.", "cards": [{"name": "Keral Keep Disciples", "image_url": "https://cards.scryfall.io/normal/front/7/b/7b862e46-f5a2-4fce-98b5-2c5aa49ec648.jpg?1783930617", "scryfall_url": "https://scryfall.com/card/m21/334/keral-keep-disciples?utm_source=api", "types": ["Creature"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.734, "total": 0.147}, "reason": "Whenever a loyalty ability of a Chandra planeswalker is activated, this creature deals 1 damage to each opponent, turning repeated loyalty activations into incremental global damage.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/puppets-2017-01-25"], "source_titles": ["Puppets"]}, {"name": "Karplusan Hound", "image_url": "https://cards.scryfall.io/normal/front/9/5/95179b31-8cb5-4dd9-ad93-782b8774534d.jpg?1783934935", "scryfall_url": "https://scryfall.com/card/dom/277/karplusan-hound?utm_source=api", "types": ["Creature"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.758, "total": 0.152}, "reason": "Whenever this creature attacks, if a Chandra planeswalker is controlled, it deals 2 damage to any target \u2014 a cheap attacker that converts attack steps into extra burn or spot removal.", "source_urls": [], "source_titles": []}, {"name": "Chandra's Magmutt", "image_url": "https://cards.scryfall.io/normal/front/9/1/91d3e366-4da5-42c8-bbd5-a0c178c0da28.jpg?1783930694", "scryfall_url": "https://scryfall.com/card/m21/137/chandras-magmutt?utm_source=api", "types": ["Creature"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 0.667, "synergy": 0.0, "similarity": 0.194, "total": 0.452}, "reason": "{T}: This creature deals 1 damage to target player or planeswalker, a repeatable one-drop pinger that fits aggressive red curves and helps close low life totals.", "source_urls": [], "source_titles": []}]}

