data: {"index": 3, "title": "Turn extension and toolbox", "explanation": "A single card that grants extra combat phases amplifies the value of haste tokens and multiple attack triggers from the deck's planeswalkers and creatures.", "cards": [{"name": "Full Throttle", "image_url": "https://cards.scryfall.io/normal/front/d/9/d91f7cad-89e8-45cb-a78e-b35b0ee64783.jpg?1783907882", "scryfall_url": "https://scryfall.com/card/dft/127/full-throttle?utm_source=api", "types": ["Sorcery"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 0.667, "synergy": 0.0, "similarity": 0.095, "total": 0.432}, "reason": "Sorcery that creates two additional combat phases after the current main phase and untaps all creatures that attacked this turn at the start of each combat, enabling multiple attack windows to exploit haste tokens, Karplusan Hound triggers, and recurring damage from attacking creatures.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/aetherdrift-episode-4-little-guy-shortcuts"], "source_titles": ["Aetherdrift | Episode 4: Little-Guy Shortcuts"]}]}

