event: explanation
data: {"index": 0, "title": "Chandra planeswalker engines", "explanation": "Several Chandra planeswalkers turn loyalty changes and spellcasting into direct damage or card advantage, forming the deck's core recurring threat and finishers.", "cards": [{"name": "Chandra, Torch of Defiance", "image_url": "https://cards.scryfall.io/normal/front/4/0/40cb22c8-cb03-45c9-bb0e-b8cabdcc43cd.jpg?1788329325", "scryfall_url": "https://scryfall.com/card/fra/244/chandra-torch-of-defiance?utm_source=api", "types": ["Planeswalker"], "color_identity": ["R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 1.0, "similarity": 0.775, "total": 1.155}, "reason": "Provides card advantage and mana: +1 exiles the top card and lets the controller cast it or deal 2 to each opponent; a second +1 produces {R}{R} for explosive turns; \u22123 removes a creature; \u22127 gives an emblem that turns every spell cast into 5 damage to any target, converting the deck's burn into repeatable reach.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/torch-defiance-2016-09-07"], "source_titles": ["Torch of Defiance"]}, {"name": "Chandra, Flamecaller", "image_url": "https://cards.scryfall.io/normal/front/a/8/a83ca3a1-82a9-4f47-b0b8-21687afd705b.jpg?1783931174", "scryfall_url": "https://scryfall.com/card/c20/145/chandra-flamecaller?utm_source=api", "types": ["Planeswalker"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.807, "total": 0.781}, "reason": "+1 creates two 3/1 haste Elementals for immediate pressure; 0 cycles the hand to redraw and dig; \u2212X clears boards by dealing X to each creature, giving flexible board answers and synergy with token pressure.", "source_urls": [], "source_titles": []}, {"name": "Chandra, Fire Artisan", "image_url": "https://cards.scryfall.io/normal/front/d/2/d21a7b23-8827-49f2-ade4-75a602d17743.jpg?1783933433", "scryfall_url": "https://scryfall.com/card/war/119/chandra-fire-artisan?utm_source=api", "types": ["Planeswalker"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.655, "total": 0.751}, "reason": "Whenever loyalty is removed from this Chandra, she deals that much damage to a target opponent or planeswalker, turning activations into direct damage; +1 digs and can smooth into more spells; \u22127 can exile seven cards to cast that turn, enabling huge spell turns.", "source_urls": [], "source_titles": []}, {"name": "Chandra Nalaar", "image_url": "https://cards.scryfall.io/normal/front/4/4/44108e96-1fb5-41e0-a391-0c111e0f4f11.jpg?1783938740", "scryfall_url": "https://scryfall.com/card/jvc/34/chandra-nalaar?utm_source=api", "types": ["Planeswalker"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 1.0, "total": 0.6}, "reason": "+1 provides incremental 1 damage to a player or planeswalker; \u2212X is a flexible creature removal; \u22128 is a large finisher that deals 10 damage to a player/planeswalker and each creature they control, serving as a board- and life-swinging ultimate.", "source_urls": ["https://magic.wizards.com/en/news/feature/chandras-origin-fire-logic-2015-06-10", "https://magic.wizards.com/en/news/magic-story/aetherdrift-episode-4-little-guy-shortcuts", "https://magic.wizards.com/en/news/magic-story/breaking-points-2017-01-18", "https://magic.wizards.com/en/news/magic-story/puppets-2017-01-25"], "source_titles": ["Chandra\u2019s Origin: Fire Logic", "Aetherdrift | Episode 4: Little-Guy Shortcuts", "Breaking Points", "Puppets"]}, {"name": "Chandra, Heart of Fire", "image_url": "https://cards.scryfall.io/normal/front/a/4/a4c3ca8c-c77c-43b8-84ad-796313ecc813.jpg?1783930694", "scryfall_url": "https://scryfall.com/card/m21/135/chandra-heart-of-fire?utm_source=api", "types": ["Planeswalker"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.748, "total": 0.77}, "reason": "+1 can deal 2 damage to any target and the other +1 lets Chandra discard then exile top three cards to play that turn, enabling explosive spell sequencing; \u22129 tutors a large selection of red instants and sorceries as a late-game reset.", "source_urls": [], "source_titles": []}, {"name": "Chandra, Flame's Catalyst", "image_url": "https://cards.scryfall.io/normal/front/1/e/1e49ce44-5286-4310-88c2-f8a1402b113b.jpg?1783930619", "scryfall_url": "https://scryfall.com/card/m21/332/chandra-flames-catalyst?utm_source=api", "types": ["Planeswalker"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.732, "total": 0.766}, "reason": "+1 dents opponents directly by dealing 3 damage to each opponent; \u22122 recurs a red instant or sorcery from the graveyard, extending the deck's burn and tempo; \u22128 is a massive card-draw and free-casting window to finish games.", "source_urls": [], "source_titles": []}, {"name": "Chandra, Bold Pyromancer", "image_url": "https://cards.scryfall.io/normal/front/b/a/ba9d2384-5c3f-4eb1-86b4-26ee13f1c767.jpg?1783934935", "scryfall_url": "https://scryfall.com/card/dom/275/chandra-bold-pyromancer?utm_source=api", "types": ["Planeswalker"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.712, "total": 0.762}, "reason": "+1 ramps with {R}{R} and deals 2 to a player, \u22123 removes threats, and \u22127 is a large symmetrical damage ultimate (10 to each player and each creature/planeswalker they control), a classic fiery finisher.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 1, "title": "Direct burn and sweep", "explanation": "Instants and sorceries that convert spells and loyalty activations into immediate damage or board clears provide reach to finish opponents and answers to opposing creatures.", "cards": [{"name": "Chandra's Pyrohelix", "image_url": "https://cards.scryfall.io/normal/front/1/c/1c482f51-9222-4e9e-a9fd-bb14a0afe156.jpg?1783933431", "scryfall_url": "https://scryfall.com/card/war/120/chandras-pyrohelix?utm_source=api", "types": ["Instant"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.723, "total": 0.145}, "reason": "Instant for 2 damage divided among one or two targets, a cheap flexible piece of reach for finishing life totals or picking off planeswalkers/creatures.", "source_urls": [], "source_titles": []}, {"name": "Chandra's Fury", "image_url": "https://cards.scryfall.io/normal/front/d/2/d2b85237-98a8-4b52-9cc6-6fd14849b069.jpg?1783938332", "scryfall_url": "https://scryfall.com/card/ori/136/chandras-fury?utm_source=api", "types": ["Instant"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.922, "total": 0.184}, "reason": "Instant that deals 4 to a player or planeswalker and 1 to each creature that player controls \u2014 a strong one-card clock and incidental board damage against creature-based defenses.", "source_urls": [], "source_titles": []}, {"name": "Chandra's Outburst", "image_url": "https://cards.scryfall.io/normal/front/f/1/f1e849c3-f357-4e81-a580-be5056bed51b.jpg?1783934936", "scryfall_url": "https://scryfall.com/card/dom/276/chandras-outburst?utm_source=api", "types": ["Sorcery"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.954, "total": 0.191}, "reason": "Sorcery that deals 4 to target player or planeswalker and also tutors Chandra, Bold Pyromancer from library or graveyard, both providing reach and ensuring one of the deck's planeswalkers is available.", "source_urls": [], "source_titles": []}, {"name": "Chandra's Flame Wave", "image_url": "https://cards.scryfall.io/normal/front/5/f/5f13b6a7-fa62-4d94-a56c-f2e64c8c1666.jpg?1783932918", "scryfall_url": "https://scryfall.com/card/m20/295/chandras-flame-wave?utm_source=api", "types": ["Sorcery"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.963, "total": 0.193}, "reason": "Sorcery that deals 2 to a player and each creature they control while also searching for Chandra, Flame's Fury to the hand, combining a small sweep with card recursion for continued pressure.", "source_urls": [], "source_titles": []}, {"name": "Chandra's Outrage", "image_url": "https://cards.scryfall.io/normal/front/e/d/edbfe793-6644-43ed-bbe1-e122c01c5e53.jpg?1783932981", "scryfall_url": "https://scryfall.com/card/m20/130/chandras-outrage?utm_source=api", "types": ["Instant"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.883, "total": 0.177}, "reason": "Instant that handles a creature for 4 and deals 2 to its controller, useful both as removal and tempo to clear blockers or punish attackers.", "source_urls": [], "source_titles": []}, {"name": "Devour in Flames", "image_url": "https://cards.scryfall.io/normal/front/4/3/432dd78b-9520-4c28-8699-d7ff9c477070.jpg?1783937907", "scryfall_url": "https://scryfall.com/card/ogw/106/devour-in-flames?utm_source=api", "types": ["Sorcery"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 0.667, "synergy": 0.0, "similarity": 0.379, "total": 0.489}, "reason": "Sorcery that, as an additional cost returning a land to hand, deals 5 to target creature or planeswalker \u2014 a high-impact removal that leverages the deck's willingness to rebuy lands or run land recursion.", "source_urls": [], "source_titles": []}, {"name": "Spreading Flames", "image_url": "https://cards.scryfall.io/normal/front/c/6/c655b1dc-8df1-44c8-a963-bd0a671ec7e5.jpg?1783937452", "scryfall_url": "https://scryfall.com/card/emn/143/spreading-flames?utm_source=api", "types": ["Instant"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 0.667, "synergy": 0.0, "similarity": 0.391, "total": 0.492}, "reason": "Instant that deals 6 damage divided among any number of creatures, a cheap mass-answer to multiple small blockers or to finish off several planeswalkers/creatures at once.", "source_urls": [], "source_titles": []}]}

