ce": ["lore"], "scores": {"story": 0.882, "synergy": 0.0, "similarity": 0.868, "total": 0.721}}, {"name": "Gideon, Martial Paragon", "image_url": "https://cards.scryfall.io/normal/front/2/c/2c057ca8-9811-4dc3-9b0e-f9f69f752d1d.jpg?1783936437", "scryfall_url": "https://scryfall.com/card/akh/270/gideon-martial-paragon?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.882, "synergy": 0.0, "similarity": 0.811, "total": 0.709}}, {"name": "Gideon the Oathless", "image_url": "https://cards.scryfall.io/normal/front/c/9/c985b0d1-25bd-4069-aab7-a566ff27a8f6.jpg?1789127990", "scryfall_url": "https://scryfall.com/card/fra/230/gideon-the-oathless?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.993, "total": 0.709}}, {"name": "Gideon Blackblade", "image_url": "https://cards.scryfall.io/normal/front/4/1/41326ca6-f815-4af7-b022-67db127bc125.jpg?1783913347", "scryfall_url": "https://scryfall.com/card/rvr/20/gideon-blackblade?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.88, "total": 0.687}}, {"name": "Gideon of the Trials", "image_url": "https://cards.scryfall.io/normal/front/9/5/959ce13f-519f-4472-bbd1-f26a972723d7.jpg?1783936539", "scryfall_url": "https://scryfall.com/card/akh/14/gideon-of-the-trials?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.843, "total": 0.679}}]}

event: explanation
data: {"index": 0, "title": "Those saved by Gideon (defense, rally, sacrifice)", "explanation": "These cards focus on protection, making indestructible creatures, creating allies, or otherwise enabling a last-stand defense that echoes Gideon's act of holding the line to save others. Gideon planeswalker cards here become creatures with indestructible or provide emblematic support; companions and allies provide synergy for rallying and protecting permanents.", "cards": [{"name": "Gideon, Ally of Zendikar", "image_url": "https://cards.scryfall.io/normal/front/1/8/187e887c-c39d-4d25-a506-cdc95fc70316.jpg?1783938219", "scryfall_url": "https://scryfall.com/card/bfz/29/gideon-ally-of-zendikar?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.882, "synergy": 0.0, "similarity": 0.868, "total": 0.721}, "reason": "Creates 2/2 Knight Ally tokens and can become a 5/5 indestructible creature, representing frontline defense and token-based rally effects useful for protecting key planeswalkers or allies.", "source_urls": [], "source_titles": []}, {"name": "Gideon Blackblade", "image_url": "https://cards.scryfall.io/normal/front/4/1/41326ca6-f815-4af7-b022-67db127bc125.jpg?1783913347", "scryfall_url": "https://scryfall.com/card/rvr/20/gideon-blackblade?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.88, "total": 0.687}, "reason": "During its controller's turn it becomes a 4/4 indestructible creature and can grant other creatures vigilance, lifelink, or indestructible to shore up defenders\u2014mechanically fitting a protector who sacrifices himself to save others.", "source_urls": [], "source_titles": []}, {"name": "Gideon of the Trials", "image_url": "https://cards.scryfall.io/normal/front/9/5/959ce13f-519f-4472-bbd1-f26a972723d7.jpg?1783936539", "scryfall_url": "https://scryfall.com/card/akh/14/gideon-of-the-trials?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.843, "total": 0.679}, "reason": "Can prevent damage to permanents and becomes a 4/4 indestructible creature, offering targeted protection that mirrors a sacrificial guardian who absorbs harm to keep others safe.", "source_urls": [], "source_titles": []}, {"name": "Gideon, Martial Paragon", "image_url": "https://cards.scryfall.io/normal/front/2/c/2c057ca8-9811-4dc3-9b0e-f9f69f752d1d.jpg?1783936437", "scryfall_url": "https://scryfall.com/card/akh/270/gideon-martial-paragon?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.882, "synergy": 0.0, "similarity": 0.811, "total": 0.709}, "reason": "Untaps and buffs creatures or becomes a 5/5 indestructible creature, providing both mass recovery and a durable threat that can help turn a desperate board state around.", "source_urls": [], "source_titles": []}, {"name": "Gideon, the Oathsworn", "image_url": "https://cards.scryfall.io/normal/front/4/3/43e7331d-98b8-420f-a346-3f3521c3b258.jpg?1783933361", "scryfall_url": "https://scryfall.com/card/war/265/gideon-the-oathsworn?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.882, "synergy": 0.0, "similarity": 0.953, "total": 0.738}, "reason": "Rewards attacking with multiple creatures and can become a 5/5 indestructible creature that prevents damage to itself, supporting an aggressive-but-resilient approach where allies press forward after Gideon buys them time.", "source_urls": [], "source_titles": []}, {"name": "Hixus, Prison Warden", "image_url": "https://cards.scryfall.io/normal/front/d/0/d0c21a35-4b70-4de4-93ff-c0ccabdc39e0.jpg?1783938361", "scryfall_url": "https://scryfall.com/card/ori/19/hixus-prison-warden?utm_source=api", "types": ["Creature"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.351, "total": 1.09}, "reason": "With flash and an exile-on-damage trigger, Hixus can temporarily remove attacking threats that deal damage, representing the lessons Gideon received in training and offering tactical protection for vulnerable allies.", "source_urls": ["https://magic.wizards.com/en/news/feature/gideons-origin-kytheon-iora-akros-2015-07-01"], "source_titles": ["Gideon\u2019s Origin: Kytheon Iora of Akros"]}, {"name": "General Tazri", "image_url": "https://cards.scryfall.io/normal/front/3/4/34e9aa86-1a31-4c0f-928d-923f066286b6.jpg?1783937927", "scryfall_url": "https://scryfall.com/card/ogw/19/general-tazri?utm_source=api", "types": ["Creature"], "color_identity": ["W", "U", "B", "R", "G"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.445, "total": 1.0}, "reason": "Searches for Ally creatures and can buff an Ally army across colors, supporting a coalition of survivors rallied and organized in the wake of a sacrifice that preserved many lives.", "source_urls": [], "source_titles": []}, {"name": "Munda, Ambush Leader", "image_url": "https://cards.scryfall.io/normal/front/d/8/d8ee09fe-46d7-492b-a2f3-3fb0c3f83f07.jpg?1783938179", "scryfall_url": "https://scryfall.com/card/bfz/215/munda-ambush-leader?utm_source=api", "types": ["Creature"], "color_identity": ["W", "R"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.458, "total": 1.112}, "reason": "Provides haste and a Rally ability that arranges the top of the library for Allies, enabling fast reinforcement and coordinated follow-up after a protective stand.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 1, "title": "Kozilek and the Eldrazi (world-devastating threat)", "explanation": "These cards represent the Eldrazi\u2019s scale, card advantage, and battlefield-altering effects\u2014what Gideon and his allies held back. They provide the deck with massive bodies, annihilator-style pressure, token generation, and graveyard/hand disruption that model a cosmically destructive force.", "cards": [{"name": "Kozilek, Butcher of Truth", "image_url": "https://cards.scryfall.io/normal/front/d/2/d27cf7b7-7982-46bd-a559-7789c0e74bae.jpg?1783921940", "scryfall_url": "https://scryfall.com/card/2x2/2/kozilek-butcher-of-truth?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.917, "similarity": 0.545, "total": 0.857}, "reason": "A huge legendary Eldrazi that draws four cards on cast and has Annihilator 4, representing the scale of the threat that razed Zendikar and required Gideon and others to contain it.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/blight-we-were-born-2016-01-13", "https://magic.wizards.com/en/news/magic-story/rise-kozilek-2015-12-09"], "source_titles": ["The Blight We Were Born For", "The Rise of Kozilek"]}, {"name": "Kozilek, the Great Distortion", "image_url": "https://cards.scryfall.io/normal/front/c/4/c41554e7-2a07-4cc7-b01b-44deed08e588.jpg?1783915732", "scryfall_url": "https://scryfall.com/card/cmm/2/kozilek-the-great-distortion?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.374, "total": 1.095}, "reason": "Provides hand-size catch-up on cast and can counter spells by discarding a matching mana value, modeling reality-warping interference and disruptive answers to opposing plans.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/retaliation-ob-nixilis-2015-12-30"], "source_titles": ["Retaliation of Ob Nixilis"]}, {"name": "Artisan of Kozilek", "image_url": "https://cards.scryfall.io/normal/front/9/3/9312fada-fc31-46ac-b6a1-cfffd776856f.jpg?1783915459", "scryfall_url": "https://scryfall.com/card/cmm/801/artisan-of-kozilek?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.899, "similarity": 0.488, "total": 0.839}, "reason": "When cast may return a creature from a graveyard to the battlefield and has Annihilator 2, enabling both recursion (reassembling forces) and pressure typical of Eldrazi incursions.", "source_urls": [], "source_titles": []}, {"name": "Kozilek's Return", "image_url": "https://cards.scryfall.io/normal/front/7/2/72765559-0a78-4aa3-827e-cb4612720991.jpg?1783937909", "scryfall_url": "https://scryfall.com/card/ogw/98/kozileks-return?utm_source=api", "types": ["Instant"], "color_identity": ["R"], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.753, "similarity": 0.486, "total": 1.294}, "reason": "A mass-damage instant that deals 2 damage to each creature (or 5 if exiled from graveyard when a big Eldrazi was cast), reflecting Eldrazi-based board clearing and catastrophic pulses that reshape the battlefield.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/rise-kozilek-2015-12-09"], "source_titles": ["The Rise of Kozilek"]}, {"name": "Kozilek's Unsealing", "image_url": "https://cards.scryfall.io/normal/front/e/6/e6b44ffe-db9e-4db5-9806-098411c9ece0.jpg?1783911288", "scryfall_url": "https://scryfall.com/card/mh3/65/kozileks-unsealing?utm_source=api", "types": ["Enchantment"], "color_identity": ["U"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.869, "similarity": 0.568, "total": 0.844}, "reason": "Creates Eldrazi Spawn tokens when casting large creature spells and draws three cards for 7+ spells, supporting Eldrazi ramp/token synergies and the engine-like feel of an Eldrazi resurgence.", "source_urls": [], "source_titles": []}, {"name": "Herald of Kozilek", "image_url": "https://cards.scryfall.io/normal/front/2/a/2a4180ae-1fd9-4185-b4f0-9e8f668a5737.jpg?1783938181", "scryfall_url": "https://scryfall.com/card/bfz/205/herald-of-kozilek?utm_source=api", "types": ["Creature"], "color_identity": ["U", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.887, "similarity": 0.355, "total": 1.319}, "reason": "Makes colorless spells cost 1 less, enabling quicker Eldrazi deployments that emulate how Kozilek\u2019s presence accelerated large-scale assaults.", "source_urls": [], "source_titles": []}, {"name": "Kozilek's Channeler", "image_url": "https://cards.scryfall.io/normal/front/c/5/c550d179-32ec-4ad8-91c2-d79320a21cba.jpg?1783938223", "scryfall_url": "https://scryfall.com/card/bfz/10/kozileks-channeler?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.635, "similarity": 0.0, "total": 1.152}, "reason": "Produces two colorless mana when tapped, helping accelerate casting of massive Eldrazi that distort the battlefield.", "source_urls": [], "source_titles": []}, {"name": "Kozilek's Translator", "image_url": "https://cards.scryfall.io/normal/front/d/8/d80665ae-fcb2-48fd-95be-8768293bcef7.jpg?1783937915", "scryfall_url": "https://scryfall.com/card/ogw/74/kozileks-translator?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.437, "total": 0.998}, "reason": "Converts life into colorless mana once per turn, fitting a theme of resource extraction to fuel Eldrazi casting and representing the corrosive cost of summoning such titans.", "source_urls": [], "source_titles": []}, {"name": "Kozilek's Pathfinder", "image_url": "https://cards.scryfall.io/normal/front/b/7/b75585bd-fdd8-44d1-8c7c-b96df5fc473e.jpg?1783937930", "scryfall_url": "https://scryfall.com/card/ogw/5/kozileks-pathfinder?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.205, "total": 0.952}, "reason": "Prevents a creature from blocking it for one colorless mana, modeling the evasive, unstoppable advance of Eldrazi forces.", "source_urls": [], "source_titles": []}, {"name": "Kozilek's Shrieker", "image_url": "https://cards.scryfall.io/normal/front/a/3/a384cd5b-2c6c-4969-bb62-a017e2fc9794.jpg?1783937914", "scryfall_url": "https://scryfall.com/card/ogw/73/kozileks-shrieker?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.359, "total": 0.982}, "reason": "Can pay colorless to gain +1/+0 and menace, offering cheap aggression and evasion that contributes to Eldrazi pressure across the board.", "source_urls": [], "source_titles": []}]}

event: done
data: {"chips": ["Character: Gideon Jura", "Play style: sacrifice"], "characters": [{"name": "Gideon Jura", "role": "opposed", "story_event": "death", "seen_from": "those saved by Gideon Jura"}], "intro": "Two opposing sides for a deck themed on Gideon Jura's sacrifice: one side represents those Gideon saved and the resilient allies he inspired; the other side represents Kozilek and the Eldrazi menace he helped hold back. Cards are chosen for mechanical roles that reflect protection, rallying, and sacrifice on Gideon's side, and for massive, reality-warping threats plus Eldrazi support on Kozilek's side.", "groups": [{"title": "Those saved by Gideon (defense, rally, sacrifice)", "explanation": "These cards focus on protection, making indestructible creatures, creating allies, or otherwise enabling a last-stand defense that echoes Gideon's act of holding the line to save others. Gideon planeswalker cards here become creatures with indestructible or provide emblematic support; companions and allies provide synergy for rallying and protecting permanents.", "cards": [{"name": "Gideon, Ally of Zendikar", "image_url": "https://cards.scryfall.io/normal/front/1/8/187e887c-c39d-4d25-a506-cdc95fc70316.jpg?1783938219", "scryfall_url": "https://scryfall.com/card/bfz/29/gideon-ally-of-zendikar?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.882, "synergy": 0.0, "similarity": 0.868, "total": 0.721}, "reason": "Creates 2/2 Knight Ally tokens and can become a 5/5 indestructible creature, representing frontline defense and token-based rally effects useful for protecting key planeswalkers or allies.", "source_urls": [], "source_titles": []}, {"name": "Gideon Blackblade", "image_url": "https://cards.scryfall.io/normal/front/4/1/41326ca6-f815-4af7-b022-67db127bc125.jpg?1783913347", "scryfall_url": "https://scryfall.com/card/rvr/20/gideon-blackblade?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.88, "total": 0.687}, "reason": "During its controller's turn it becomes a 4/4 indestructible creature and can grant other creatures vigilance, lifelink, or indestructible to shore up defenders\u2014mechanically fitting a protector who sacrifices himself to save others.", "source_urls": [], "source_titles": []}, {"name": "Gideon of the Trials", "image_url": "https://cards.scryfall.io/normal/front/9/5/959ce13f-519f-4472-bbd1-f26a972723d7.jpg?1783936539", "scryfall_url": "https://scryfall.com/card/akh/14/gideon-of-the-trials?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.843, "total": 0.679}, "reason": "Can prevent damage to permanents and becomes a 4/4 indestructible creature, offering targeted protection that mirrors a sacrificial guardian who absorbs harm to keep others safe.", "source_urls": [], "source_titles": []}, {"name": "Gideon, Martial Paragon", "image_url": "https://cards.scryfall.io/normal/front/2/c/2c057ca8-9811-4dc3-9b0e-f9f69f752d1d.jpg?1783936437", "scryfall_url": "https://scryfall.com/card/akh/270/gideon-martial-paragon?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.882, "synergy": 0.0, "similarity": 0.811, "total": 0.709}, "reason": "Untaps and buffs creatures or becomes a 5/5 indestructible creature, providing both mass recovery and a durable threat that can help turn a desperate board state around.", "source_urls": [], "source_titles": []}, {"name": "Gideon, the Oathsworn", "image_url": "https://cards.scryfall.io/normal/front/4/3/43e7331d-98b8-420f-a346-3f3521c3b258.jpg?1783933361", "scryfall_url": "https://scryfall.com/card/war/265/gideon-the-oathsworn?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.882, "synergy": 0.0, "similarity": 0.953, "total": 0.738}, "reason": "Rewards attacking with multiple creatures and can become a 5/5 indestructible creature that prevents damage to itself, supporting an aggressive-but-resilient approach where allies press forward after Gideon buys them time.", "source_urls": [], "source_titles": []}, {"name": "Hixus, Prison Warden", "image_url": "https://cards.scryfall.io/normal/front/d/0/d0c21a35-4b70-4de4-93ff-c0ccabdc39e0.jpg?1783938361", "scryfall_url": "https://scryfall.com/card/ori/19/hixus-prison-warden?utm_source=api", "types": ["Creature"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.351, "total": 1.09}, "reason": "With flash and an exile-on-damage trigger, Hixus can temporarily remove attacking threats that deal damage, representing the lessons Gideon received in training and offering tactical protection for vulnerable allies.", "source_urls": ["https://magic.wizards.com/en/news/feature/gideons-origin-kytheon-iora-akros-2015-07-01"], "source_titles": ["Gideon\u2019s Origin: Kytheon Iora of Akros"]}, {"name": "General Tazri", "image_url": "https://cards.scryfall.io/normal/front/3/4/34e9aa86-1a31-4c0f-928d-923f066286b6.jpg?1783937927", "scryfall_url": "https://scryfall.com/card/ogw/19/general-tazri?utm_source=api", "types": ["Creature"], "color_identity": ["W", "U", "B", "R", "G"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.445, "total": 1.0}, "reason": "Searches for Ally creatures and can buff an Ally army across colors, supporting a coalition of survivors rallied and organized in the wake of a sacrifice that preserved many lives.", "source_urls": [], "source_titles": []}, {"name": "Munda, Ambush Leader", "image_url": "https://cards.scryfall.io/normal/front/d/8/d8ee09fe-46d7-492b-a2f3-3fb0c3f83f07.jpg?1783938179", "scryfall_url": "https://scryfall.com/card/bfz/215/munda-ambush-leader?utm_source=api", "types": ["Creature"], "color_identity": ["W", "R"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.458, "total": 1.112}, "reason": "Provides haste and a Rally ability that arranges the top of the library for Allies, enabling fast reinforcement and coordinated follow-up after a protective stand.", "source_urls": [], "source_titles": []}]}, {"title": "Kozilek and the Eldrazi (world-devastating threat)", "explanation": "These cards represent the Eldrazi\u2019s scale, card advantage, and battlefield-altering effects\u2014what Gideon and his allies held back. They provide the deck with massive bodies, annihilator-style pressure, token generation, and graveyard/hand disruption that model a cosmically destructive force.", "cards": [{"name": "Kozilek, Butcher of Truth", "image_url": "https://cards.scryfall.io/normal/front/d/2/d27cf7b7-7982-46bd-a559-7789c0e74bae.jpg?1783921940", "scryfall_url": "https://scryfall.com/card/2x2/2/kozilek-butcher-of-truth?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.917, "similarity": 0.545, "total": 0.857}, "reason": "A huge legendary Eldrazi that draws four cards on cast and has Annihilator 4, representing the scale of the threat that razed Zendikar and required Gideon and others to contain it.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/blight-we-were-born-2016-01-13", "https://magic.wizards.com/en/news/magic-story/rise-kozilek-2015-12-09"], "source_titles": ["The Blight We Were Born For", "The Rise of Kozilek"]}, {"name": "Kozilek, the Great Distortion", "image_url": "https://cards.scryfall.io/normal/front/c/4/c41554e7-2a07-4cc7-b01b-44deed08e588.jpg?1783915732", "scryfall_url": "https://scryfall.com/card/cmm/2/kozilek-the-great-distortion?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.374, "total": 1.095}, "reason": "Provides hand-size catch-up on cast and can counter spells by discarding a matching mana value, modeling reality-warping interference and disruptive answers to opposing plans.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/retaliation-ob-nixilis-2015-12-30"], "source_titles": ["Retaliation of Ob Nixilis"]}, {"name": "Artisan of Kozilek", "image_url": "https://cards.scryfall.io/normal/front/9/3/9312fada-fc31-46ac-b6a1-cfffd776856f.jpg?1783915459", "scryfall_url": "https://scryfall.com/card/cmm/801/artisan-of-kozilek?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.899, "similarity": 0.488, "total": 0.839}, "reason": "When cast may return a creature from a graveyard to the battlefield and has Annihilator 2, enabling both recursion (reassembling forces) and pressure typical of Eldrazi incursions.", "source_urls": [], "source_titles": []}, {"name": "Kozilek's Return", "image_url": "https://cards.scryfall.io/normal/front/7/2/72765559-0a78-4aa3-827e-cb4612720991.jpg?1783937909", "scryfall_url": "https://scryfall.com/card/ogw/98/kozileks-return?utm_source=api", "types": ["Instant"], "color_identity": ["R"], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.753, "similarity": 0.486, "total": 1.294}, "reason": "A mass-damage instant that deals 2 damage to each creature (or 5 if exiled from graveyard when a big Eldrazi was cast), reflecting Eldrazi-based board clearing and catastrophic pulses that reshape the battlefield.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/rise-kozilek-2015-12-09"], "source_titles": ["The Rise of Kozilek"]}, {"name": "Kozilek's Unsealing", "image_url": "https://cards.scryfall.io/normal/front/e/6/e6b44ffe-db9e-4db5-9806-098411c9ece0.jpg?1783911288", "scryfall_url": "https://scryfall.com/card/mh3/65/kozileks-unsealing?utm_source=api", "types": ["Enchantment"], "color_identity": ["U"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.869, "similari