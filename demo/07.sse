 "source_urls": [], "source_titles": []}, {"name": "Kozilek's Pathfinder", "image_url": "https://cards.scryfall.io/normal/front/b/7/b75585bd-fdd8-44d1-8c7c-b96df5fc473e.jpg?1783937930", "scryfall_url": "https://scryfall.com/card/ogw/5/kozileks-pathfinder?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.205, "total": 0.952}, "reason": "Prevents a creature from blocking it for one colorless mana, modeling the evasive, unstoppable advance of Eldrazi forces.", "source_urls": [], "source_titles": []}, {"name": "Kozilek's Shrieker", "image_url": "https://cards.scryfall.io/normal/front/a/3/a384cd5b-2c6c-4969-bb62-a017e2fc9794.jpg?1783937914", "scryfall_url": "https://scryfall.com/card/ogw/73/kozileks-shrieker?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.359, "total": 0.982}, "reason": "Can pay colorless to gain +1/+0 and menace, offering cheap aggression and evasion that contributes to Eldrazi pressure across the board.", "source_urls": [], "source_titles": []}]}]}

