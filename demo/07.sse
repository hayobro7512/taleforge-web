data: {"cards": [{"name": "Herald of Kozilek", "image_url": "https://cards.scryfall.io/normal/front/2/a/2a4180ae-1fd9-4185-b4f0-9e8f668a5737.jpg?1783938181", "scryfall_url": "https://scryfall.com/card/bfz/205/herald-of-kozilek?utm_source=api", "types": ["Creature"], "color_identity": ["U", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.887, "similarity": 0.355, "total": 1.319}}, {"name": "Kozilek's Return", "image_url": "https://cards.scryfall.io/normal/front/7/2/72765559-0a78-4aa3-827e-cb4612720991.jpg?1783937909", "scryfall_url": "https://scryfall.com/card/ogw/98/kozileks-return?utm_source=api", "types": ["Instant"], "color_identity": ["R"], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.753, "similarity": 0.486, "total": 1.294}}, {"name": "Kozilek's Channeler", "image_url": "https://cards.scryfall.io/normal/front/c/5/c550d179-32ec-4ad8-91c2-d79320a21cba.jpg?1783938223", "scryfall_url": "https://scryfall.com/card/bfz/10/kozileks-channeler?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.635, "similarity": 0.0, "total": 1.152}}, {"name": "Djeru, With Eyes Open", "image_url": "https://cards.scryfall.io/normal/front/2/2/2234df89-0835-4a17-b5d8-2334ee8f692d.jpg?1783936062", "scryfall_url": "https://scryfall.com/card/hou/10/djeru-with-eyes-open?utm_source=api", "types": ["Creature"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.495, "total": 1.119}}, {"name": "Munda, Ambush Leader", "image_url": "https://cards.scryfall.io/normal/front/d/8/d8ee09fe-46d7-492b-a2f3-3fb0c3f83f07.jpg?1783938179", "scryfall_url": "https://scryfall.com/card/bfz/215/munda-ambush-leader?utm_source=api", "types": ["Creature"], "color_identity": ["W", "R"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.458, "total": 1.112}}, {"name": "Kozilek, the Great Distortion"