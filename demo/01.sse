data: {"cards": [{"name": "Aurelia, the Warleader", "image_url": "https://cards.scryfall.io/normal/front/b/c/bc6ffc1c-575b-4116-83c9-d13b29886c35.jpg?1783908915", "scryfall_url": "https://scryfall.com/card/fdn/651/aurelia-the-warleader?utm_source=api", "types": ["Creature"], "color_identity": ["W", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.875, "similarity": 0.225, "total": 1.145}}, {"name": "Etrata, the Silencer", "image_url": "https://cards.scryfall.io/normal/front/f/a/fa36b142-e67e-49da-9080-c5994e275266.jpg?1783934135", "scryfall_url": "https://scryfall.com/card/grn/170/etrata-the-silencer?utm_source=api", "types": ["Creature"], "color_identity": ["U", "B"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.712, "similarity": 0.133, "total": 0.996}}, {"name": "Desmond Miles", "image_url": "https://cards.scryfall.io/normal/front/c/9/c9523cd1-c3cf-4745-af09-77c1a83ac86f.jpg?1783910981", "scryfall_url": "https://scryfall.com/card/acr/24/desmond-miles?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 1.0, "similarity": 0.702, "total": 0.94}}, {"name": "Jacob Frye", "image_url": "https://cards.scryfall.io/normal/front/2/3/23422e75-e1c7-484b-aa1f-155ef9a998ec.jpg?1783910980", "scryfall_url": "https://scryfall.com/card/acr/27/jacob-frye?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.789, "similarity": 0.773, "total": 0.785}}, {"name": "Aurelia, the Law Above", "image_url": "https://cards.scryfall.io/normal/front/8/f/8f80c6e7-e9f9-4ca6-87f7-a52c96079e4a.jpg?1783912856", "scryfall_url": "https://scryfall.com/card/mkm/188/aurelia-the-law-above?utm_source=api", "types": ["Creature"], "color_identity": ["W", "R"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.638, "total": 0.728}}, {"name": "Etrata, Deadly Fugitive", "image_url": "h