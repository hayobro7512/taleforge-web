event: explanation
data: {"index": 0, "title": "Investigators & clue engines", "explanation": "These cards generate, use, or copy Clues and investigations, or otherwise support the deck's detective theme by converting clues and death triggers into card advantage and board tools.", "cards": [{"name": "Alquist Proft, Master Sleuth", "image_url": "https://cards.scryfall.io/normal/front/4/1/41129b44-4fa7-473b-b2b7-48c6a58be03c.jpg?1783912857", "scryfall_url": "https://scryfall.com/card/mkm/185/alquist-proft-master-sleuth?utm_source=api", "types": ["Creature"], "color_identity": ["W", "U"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.522, "total": 0.704}, "reason": "Alquist creates a Clue when entering and can spend Sacrificed Clues to draw cards and gain life, feeding investigation-based value and fueling further plays.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-2-monsters-we-became", "https://magic.wizards.com/en/news/magic-story/episode-6-explosions-of-genius", "https://magic.wizards.com/en/news/magic-story/episode-8-gods-of-chaos"], "source_titles": ["Murders at Karlov Manor | Episode 2: Monsters We Became", "Murders at Karlov Manor | Episode 6: Explosions of Genius", "Murders at Karlov Manor | Episode 8: Gods of Chaos"]}, {"name": "Ezrim, Agency Chief", "image_url": "https://cards.scryfall.io/normal/front/9/5/9554d5f2-7a33-4734-8cf3-dfae2ccc3596.jpg?1783912850", "scryfall_url": "https://scryfall.com/card/mkm/202/ezrim-agency-chief?utm_source=api", "types": ["Creature"], "color_identity": ["W", "U"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.386, "total": 0.677}, "reason": "Ezrim investigates twice on entry, producing multiple Clues quickly; it can also sacrifice artifacts (including Clues) to grant key combat keywords, turning investigation value into protection or offense.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-6-explosions-of-genius", "https://magic.wizards.com/en/news/magic-story/episode-2-monsters-we-became"], "source_titles": ["Murders at Karlov Manor | Episode 6: Explosions of Genius", "Murders at Karlov Manor | Episode 2: Monsters We Became"]}, {"name": "Kellan, Inquisitive Prodigy // Tail the Suspect", "image_url": "https://cards.scryfall.io/normal/front/c/4/c49690c7-c282-4eb4-8da3-5e0c46a80fc4.jpg?1783912845", "scryfall_url": "https://scryfall.com/card/mkm/212/kellan-inquisitive-prodigy-tail-the-suspect?utm_source=api", "types": ["Creature", "Sorcery"], "color_identity": ["U", "G"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.451, "total": 0.69}, "reason": "Kellan fits the theme mechanically and narratively: as a Murders at Karlov Manor card, it attacks with vigilance and produces disruptive value (artifact destruction and card draw) while its Adventure helps investigate and thin the deck.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-2-monsters-we-became"], "source_titles": ["Murders at Karlov Manor | Episode 2: Monsters We Became"]}, {"name": "Kellan Joins Up", "image_url": "https://cards.scryfall.io/normal/front/2/e/2e7f95d5-b279-4469-9c89-1e02630d61e6.jpg?1783911793", "scryfall_url": "https://scryfall.com/card/otj/212/kellan-joins-up?utm_source=api", "types": ["Enchantment"], "color_identity": ["W", "U", "G"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.515, "total": 0.503}, "reason": "Triggers on legendary creatures entering to grow the board and also plots a small card for later; it supports a legend-heavy investigator deck that repeatedly brings detectives or allies onto the battlefield.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 1, "title": "Suspects, hunters, and lethal threats", "explanation": "Cards that represent dangerous suspects or provide assassination-style effects and face-down/assassin synergies\u2014useful for thematic removal, surprise attacks, and capitalizing on combat damage triggers common to the storyline.", "cards": [{"name": "Etrata, Deadly Fugitive", "image_url": "https://cards.scryfall.io/normal/front/4/4/4410db5a-62af-43ac-979d-88a7c975f7bd.jpg?1783912850", "scryfall_url": "https://scryfall.com/card/mkm/200/etrata-deadly-fugitive?utm_source=api", "types": ["Creature"], "color_identity": ["U", "B"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.609, "total": 0.722}, "reason": "Etrata provides deathtouch and face-down mechanics that let creatures be concealed then flipped; she also has an ability that interacts when Assassins deal combat damage to opponents, fitting the suspect/assassin motif present in the Manor story.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-2-monsters-we-became", "https://magic.wizards.com/en/news/magic-story/episode-5-chains-of-expectation", "https://magic.wizards.com/en/news/magic-story/episode-9-beauty-in-destruction"], "source_titles": ["Murders at Karlov Manor | Episode 2: Monsters We Became", "Murders at Karlov Manor | Episode 5: Chains of Expectation", "Murders at Karlov Manor | Episode 9: Beauty in Destruction"]}, {"name": "Etrata, the Silencer", "image_url": "https://cards.scryfall.io/normal/front/f/a/fa36b142-e67e-49da-9080-c5994e275266.jpg?1783934135", "scryfall_url": "https://scryfall.com/card/grn/170/etrata-the-silencer?utm_source=api", "types": ["Creature"], "color_identity": ["U", "B"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.712, "similarity": 0.133, "total": 0.996}, "reason": "Etrata can't be blocked and exiles opposing creatures when she deals combat damage; that exile-based removal and the library shuffle/replacement effect make her a potent, story-appropriate threat to close out games and simulate targeted eliminations.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-2-monsters-we-became", "https://magic.wizards.com/en/news/magic-story/episode-3-shadows-of-regret"], "source_titles": ["Murders at Karlov Manor | Episode 2: Monsters We Became", "Murders at Karlov Manor | Episode 3: Shadows of Regret"]}, {"name": "Desmond Miles", "image_url": "https://cards.scryfall.io/normal/front/c/9/c9523cd1-c3cf-4745-af09-77c1a83ac86f.jpg?1783910981", "scryfall_url": "https://scryfall.com/card/acr/24/desmond-miles?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 1.0, "similarity": 0.702, "total": 0.94}, "reason": "Desmond scales with other Assassins and Assassin cards in graveyards and surveils when dealing combat damage, offering a self-reinforcing Assassin package that pairs well with Etrata and other sacrifice/recursion themes.", "source_urls": [], "source_titles": []}, {"name": "Jacob Frye", "image_url": "https://cards.scryfall.io/normal/front/2/3/23422e75-e1c7-484b-aa1f-155ef9a998ec.jpg?1783910980", "scryfall_url": "https://scryfall.com/card/acr/27/jacob-frye?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.789, "similarity": 0.773, "total": 0.785}, "reason": "Jacob's partner mechanic and trigger that can exile Assassin cards from the graveyard on Assassin combat damage supports an assassin-based midrange plan and recursion of key pieces.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 2, "title": "Combat finishers, extra combats, and wide aggression", "explanation": "These cards support extra-combat steps, anthem effects, or punish opponents when creatures enter\u2014useful for converting clue advantage into lethal pressure or for recreating story moments of large-scale conflict tied to Murders at Karlov Manor.", "cards": [{"name": "Aurelia's Vindicator", "image_url": "https://cards.scryfall.io/normal/front/5/9/5901dff4-e09b-4747-9297-797a1a057cd5.jpg?1783912930", "scryfall_url": "https://scryfall.com/card/mkm/4/aurelias-vindicator?utm_source=api", "types": ["Creature"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.318, "total": 0.628}, "reason": "Aurelia's Vindicator provides flying and lifelink with ward, and its disguise face-up trigger can exile other creatures from battlefield or graveyards\u2014offering powerful removal/tempo swings that return those cards when it leaves, matching a narrative of temporary banishment.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-7-rot-before-recovery"], "source_titles": ["Murders at Karlov Manor | Episode 7: Rot before Recovery"]}, {"name": "Aurelia, the Law Above", "image_url": "https://cards.scryfall.io/normal/front/8/f/8f80c6e7-e9f9-4ca6-87f7-a52c96079e4a.jpg?1783912856", "scryfall_url": "https://scryfall.com/card/mkm/188/aurelia-the-law-above?utm_source=api", "types": ["Creature"], "color_identity": ["W", "R"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.638, "total": 0.728}, "reason": "Aurelia rewards wide attacks by drawing cards at three-plus attackers and dealing/ding life at five-plus attackers, enabling aggressive, multi-attack finishes and reflecting the set's faction-driven battles.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-7-rot-before-recovery"], "source_titles": ["Murders at Karlov Manor | Episode 7: Rot before Recovery"]}, {"name": "Anzrag, the Quake-Mole", "image_url": "https://cards.scryfall.io/normal/front/7/0/70e9d8b8-4b32-4414-b32f-1f47523239c5.jpg?1783912855", "scryfall_url": "https://scryfall.com/card/mkm/186/anzrag-the-quake-mole?utm_source=api", "types": ["Creature"], "color_identity": ["R", "G"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.116, "total": 0.623}, "reason": "Anzrag creates extra combat phases when it becomes blocked and can force itself to be blocked each combat; those extra-phase synergies let an aggression-focused deck apply pressure or trigger combat-on-die effects multiple times.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-7-rot-before-recovery"], "source_titles": ["Murders at Karlov Manor | Episode 7: Rot before Recovery"]}, {"name": "Warleader's Call", "image_url": "https://cards.scryfall.io/normal/front/b/3/b3e8f8bd-1c8b-4a7c-96c4-57a247ce9ccc.jpg?1783912831", "scryfall_url": "https://scryfall.com/card/mkm/242/warleaders-call?utm_source=api", "types": ["Enchantment"], "color_identity": ["W", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 0.588, "synergy": 0.558, "similarity": 0.384, "total": 0.641}, "reason": "This Murders at Karlov Manor enchantment gives creatures +1/+1 and pings opponents whenever a creature enters, turning token creation and creature recursion into incremental burn and board growth.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-1-ghosts-of-our-past"], "source_titles": ["Murders at Karlov Manor | Episode 1: Ghosts of Our Past"]}, {"name": "Anzrag's Rampage", "image_url": "https://cards.scryfall.io/normal/front/9/d/9dc52b53-3e4f-4d7d-851f-86c6e0ac67b2.jpg?1783912887", "scryfall_url": "https://scryfall.com/card/mkm/111/anzrags-rampage?utm_source=api", "types": ["Sorcery"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 0.941, "synergy": 0.0, "similarity": 0.354, "total": 0.659}, "reason": "Useful as a focused sweep against opposing artifacts while exiling and potentially cheating a creature from the top of the library onto the battlefield with haste\u2014offers a one-shot swing that can change board states drastically.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-7-rot-before-recovery"], "source_titles": ["Murders at Karlov Manor | Episode 7: Rot before Recovery"]}]}

event: explanation
data: {"index": 3, "title": "Grave, exile, and token recursion tools", "explanation": "These cards help preserve important creatures or turn exile/grave events into tokens and repeatable value\u2014handy for a deck that wants to reuse key investigators, detectives, or assassination threats after they die.", "cards": [{"name": "Kaya's Ghostform", "image_url": "https://cards.scryfall.io/normal/front/9/8/98f3be88-24e2-433f-9138-f0cb59d09a0f.jpg?1783933444", "scryfall_url": "https://scryfall.com/card/war/94/kayas-ghostform?utm_source=api", "types": ["Enchantment"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.315, "total": 0.463}, "reason": "As an Aura, Ghostform returns an enchanted creature or planeswalker to the battlefield under the controller's control if that permanent dies or is exiled, enabling repeatable recursion for signature creatures.", "source_urls": [], "source_titles": []}, {"name": "Kaya, Spirits' Justice", "image_url": "https://cards.scryfall.io/normal/front/a/2/a2827593-4951-4ba7-b73e-c27de56f2606.jpg?1783912848", "scryfall_url": "https://scryfall.com/card/mkm/211/kaya-spirits-justice?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W", "B"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.427, "total": 0.685}, "reason": "Kaya's loyalty abilities surveil and create tokens; importantly, her static ability can turn creatures or creature cards that are exiled into token copies (with flying) for a turn, converting exile events into reusable attackers\u2014an ideal fit for a deck that trades creatures for clues or exile-based effects.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-1-ghosts-of-our-past", "https://magic.wizards.com/en/news/magic-story/episode-3-shadows-of-regret", "https://magic.wizards.com/en/news/magic-story/episode-10-roots-of-decay"], "source_titles": ["Murders at Karlov Manor | Episode 1: Ghosts of Our Past", "Murders at Karlov Manor | Episode 3: Shadows of Regret", "Murders at Karlov Manor | Episode 10: Roots of Decay"]}, {"name": "Kaya, Geist Hunter", "image_url": "https://cards.scryfall.io/normal/front/5/2/52faa78e-252e-465b-91b5-6f64d828da81.jpg?1783907026", "scryfall_url": "https://scryfall.com/card/tdc/294/kaya-geist-hunter?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W", "B"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.541, "total": 0.508}, "reason": "Kaya can grant deathtouch to creatures, double token creation, and has a large ultimate that exiles all graveyards\u2014its token-doubling is especially valuable for generating extra bodies from clue or death triggers.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-1-ghosts-of-our-past"], "source_titles": ["Murders at Karlov Manor | Episode 1: Ghosts of Our Past"]}]}

