data: {"cards": [{"name": "Nicol Bolas, God-Pharaoh", "image_url": "https://cards.scryfall.io/normal/front/5/9/597ca22d-2f08-47b3-9d93-c4d685cefb5f.jpg?1783921810", "scryfall_url": "https://scryfall.com/card/2x2/260/nicol-bolas-god-pharaoh?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.85, "similarity": 0.919, "total": 1.527}}, {"name": "Nicol Bolas, Dragon-God", "image_url": "https://cards.scryfall.io/normal/front/c/5/c5408607-af8f-48fe-bc40-32828d1976de.jpg?1783913282", "scryfall_url": "https://scryfall.com/card/rvr/205/nicol-bolas-dragon-god?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.85, "similarity": 0.846, "total": 1.512}}, {"name": "Nicol Bolas, the Ravager // Nicol Bolas, the Arisen", "image_url": "https://cards.scryfall.io/normal/front/7/b/7b215968-93a6-4278-ac61-4e3e8c3c3943.jpg?1783934524", "scryfall_url": "https://scryfall.com/card/m19/218/nicol-bolas-the-ravager-nicol-bolas-the-arisen?utm_source=api", "types": ["Creature", "Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.793, "similarity": 0.881, "total": 1.497}}, {"name": "Liliana, Heretical Healer // Liliana, Defiant Necromancer", "image_url": "https://cards.scryfall.io/normal/front/d/8/d8b718d8-fca3-4b3e-9448-6067c8656a9a.jpg?1783924142", "scryfall_url": "https://scryfall.com/card/cc2/1/liliana-heretical-healer-liliana-defiant-necromancer?utm_source=api", "types": ["Creature", "Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 0.882, "synergy": 0.476, "similarity": 0.859, "total": 1.3}}, {"name": "Liliana, Dreadhorde General", "image_url": "https://cards.scryfall.io/normal/front/c/b/cb28d217-795e-4320-a032-cd713f7ecc8a.jpg?1783909073", "scryfall_url": "https://scryfall.com/card/fdn/176/liliana-dreadhorde-general?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 0.882, "synergy": 0.481, "similarity": 0.432, "total": 1.216}}, {"name": "Nicol Bolas, the Deceiver", "image_url": "https://cards.scryfall.io/normal/front/7/4/74239d78-1608-4b27-b2fd-8c7453f6b86b.jpg?1783935986", "scryfall_url": "https://scryfall.com/card/hou/205/nicol-bolas-the-deceiver?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.942, "total": 1.208}}, {"name": "Liliana the Repentant", "image_url": "https://cards.scryfall.io/normal/front/1/e/1eb25a6c-d6b4-465d-990e-f1ab86b26b69.jpg?1788329273", "scryfall_url": "https://scryfall.com/card/fra/231/liliana-the-repentant?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.772, "total": 1.065}}, {"name": "Liliana, Death Mage", "image_url": "https://cards.scryfall.io/normal/front/9/2/921e3dc3-f8eb-4498-a6a8-b424952230cd.jpg?1783930620", "scryfall_url": "https://scryfall.com/card/m21/328/liliana-death-mage?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.882, "synergy": 0.0, "similarity": 0.463, "total": 1.04}}, {"name": "Liliana, Waker of the Dead", "image_url": "https://cards.scryfall.io/normal/front/e/3/e329a3e2-6702-4758-8aac-c3017e77b619.jpg?1783930705", "scryfall_url": "https://scryfall.com/card/m21/108/liliana-waker-of-the-dead?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.882, "synergy": 0.0, "similarity": 0.442, "total": 1.036}}, {"name": "Liliana, the Necromancer", "image_url": "https://cards.scryfall.io/normal/front/4/d/4d2cbc2c-dbe3-4ecb-8fbe-785cb80b9e76.jpg?1783934485", "scryfall_url": "https://scryfall.com/card/m19/291/lil