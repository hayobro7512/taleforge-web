scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.88, "total": 0.576}}, {"name": "Liliana's Scorn", "image_url": "https://cards.scryfall.io/normal/front/b/2/b231f941-4acb-46f2-81ae-16e5a28e65af.jpg?1783930620", "scryfall_url": "https://scryfall.com/card/m21/329/lilianas-scorn?utm_source=api", "types": ["Sorcery"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.869, "total": 0.574}}, {"name": "Liliana's Scrounger", "image_url": "https://cards.scryfall.io/normal/front/5/a/5a64625f-937a-449e-b1fc-cd0f25b033f6.jpg?1783930619", "scryfall_url": "https://scryfall.com/card/m21/330/lilianas-scrounger?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.839, "total": 0.568}}, {"name": "Desiccated Naga", "image_url": "https://cards.scryfall.io/normal/front/2/1/21f31e96-bb66-4b28-b14a-426d1d5839a6.jpg?1783936437", "scryfall_url": "https://scryfall.com/card/akh/276/desiccated-naga?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.987, "total": 0.562}}, {"name": "Liliana's Influence", "image_url": "https://cards.scryfall.io/normal/front/2/8/28cdf48e-e0d4-45ca-b48d-74ada54ba62e.jpg?1783936436", "scryfall_url": "https://scryfall.com/card/akh/277/lilianas-influence?utm_source=api", "types": ["Sorcery"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.803, "total": 0.561}}, {"name": "Visage of Bolas", "image_url": "https://cards.scryfall.io/normal/front/f/2/f29bbfe2-d59f-4361-8ea4-6a8d1b909769.jpg?1783935983", "scryfall_url": "https://scryfall.com/card/hou/208/visage-of-bolas?utm_source=api", "types": ["Artifact"], "color_identity": ["U", "B", "R"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.902, "total": 0.545}}, {"name": "Arisen Gorgon", "image_url": "https://cards.scryfall.io/normal/front/e/3/e39502fd-193c-4526-8dd8-0cd8c822552c.jpg?1783934483", "scryfall_url": "https://scryfall.com/card/m19/292/arisen-gorgon?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.883, "total": 0.541}}, {"name": "Liliana's Spoils", "image_url": "https://cards.scryfall.io/normal/front/e/9/e960fb5a-70cc-490d-99cf-99bc65485cfb.jpg?1783934485", "scryfall_url": "https://scryfall.com/card/m19/294/lilianas-spoils?utm_source=api", "types": ["Sorcery"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.603, "total": 0.521}}, {"name": "Wasp of the Bitter End", "image_url": "https://cards.scryfall.io/normal/front/4/6/46d348eb-7db0-4209-8960-c6adc473417d.jpg?1783935984", "scryfall_url": "https://scryfall.com/card/hou/206/wasp-of-the-bitter-end?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.744, "total": 0.514}}, {"name": "Hour of Devastation", "image_url": "https://cards.scryfall.io/normal/front/d/4/d420cc12-cfd7-4007-a0c2-b16c8f63a754.jpg?1783936028", "scryfall_url": "https://scryfall.com/card/hou/97/hour-of-devastation?utm_source=api", "types": ["Sorcery"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.669, "total": 0.499}}, {"name": "Liliana's Steward", "image_url": "https://cards.scryfall.io/normal/front/1/9/1945fc78-8aa4-46fb-9571-eaa1c4729e3d.jpg?1783930705", "scryfall_url": "https://scryfall.com/card/m21/111/lilianas-steward?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.491, "total": 0.498}}]}

event: explanation
data: {"index": 0, "title": "Liliana's Rebellion (undead, sacrifice, redirection)", "explanation": "These cards provide Liliana-focused tools for making and using Zombies, forcing sacrifices and discard, and reanimating creatures \u2014 fitting a build that reflects Liliana raising and controlling undead, redirecting loyalty, and breaking from Bolas's control.", "cards": [{"name": "Liliana, Dreadhorde General", "image_url": "https://cards.scryfall.io/normal/front/c/b/cb28d217-795e-4320-a032-cd713f7ecc8a.jpg?1783909073", "scryfall_url": "https://scryfall.com/card/fdn/176/liliana-dreadhorde-general?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 0.882, "synergy": 0.481, "similarity": 0.432, "total": 1.216}, "reason": "Produces 2/2 Zombie tokens with her +1, draws cards whenever creatures die, and provides mass-sacrifice effects to clear boards; her -9 is a brutal ultimate that forces opponents to keep only one permanent of each type. Mechanically central to an undead, sacrifice-driven deck.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-ashes-2019-06-12"], "source_titles": ["War of the Spark: Ravnica\u2014Ashes"]}, {"name": "Liliana, Waker of the Dead", "image_url": "https://cards.scryfall.io/normal/front/e/3/e329a3e2-6702-4758-8aac-c3017e77b619.jpg?1783930705", "scryfall_url": "https://scryfall.com/card/m21/108/liliana-waker-of-the-dead?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.882, "synergy": 0.0, "similarity": 0.442, "total": 1.036}, "reason": "Encourages graveyard use and discard with +1 that pressures opponents' hands, uses graveyard size to weaken creatures with \u22123, and can emblematically reanimate creatures at the beginning of combat with \u22127 \u2014 supporting an ongoing army of reanimated threats.", "source_urls": [], "source_titles": []}, {"name": "Oath of Liliana", "image_url": "https://cards.scryfall.io/normal/front/2/0/2028f577-e0fb-48dd-89c6-f4a000b0a881.jpg?1783937481", "scryfall_url": "https://scryfall.com/card/emn/99/oath-of-liliana?utm_source=api", "types": ["Enchantment"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.538, "similarity": 0.759, "total": 0.756}, "reason": "Enters forcing each opponent to sacrifice a creature and then steadily creates 2/2 Zombie tokens when planeswalkers enter under the player's control, directly fueling a Liliana-led undead army and recurring token generation.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/return-dominaria-episode-11-2018-05-23"], "source_titles": ["Return to Dominaria: Episode 11"]}, {"name": "Liliana's Scrounger", "image_url": "https://cards.scryfall.io/normal/front/5/a/5a64625f-937a-449e-b1fc-cd0f25b033f6.jpg?1783930619", "scryfall_url": "https://scryfall.com/card/m21/330/lilianas-scrounger?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.839, "total": 0.568}, "reason": "Provides a recurring way to add loyalty counters to a Liliana planeswalker whenever creatures die, enabling plane\u00adswalker growth that complements sacrifice and death themes.", "source_urls": [], "source_titles": []}, {"name": "Desiccated Naga", "image_url": "https://cards.scryfall.io/normal/front/2/1/21f31e96-bb66-4b28-b14a-426d1d5839a6.jpg?1783936437", "scryfall_url": "https://scryfall.com/card/akh/276/desiccated-naga?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.987, "total": 0.562}, "reason": "Can convert board presence into incremental life-loss for opponents and life gain for the controller, but only when a Liliana planeswalker is controlled, making it a flavorful synergist for Liliana-centric decks.", "source_urls": [], "source_titles": []}, {"name": "Arisen Gorgon", "image_url": "https://cards.scryfall.io/normal/front/e/3/e39502fd-193c-4526-8dd8-0cd8c822552c.jpg?1783934483", "scryfall_url": "https://scryfall.com/card/m19/292/arisen-gorgon?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.883, "total": 0.541}, "reason": "Has deathtouch while a Liliana planeswalker is controlled, serving as a potent defensive or removal threat that scales with a Liliana-centric board state.", "source_urls": [], "source_titles": []}, {"name": "Liliana's Triumph", "image_url": "https://cards.scryfall.io/normal/front/8/4/84803db8-fdb0-462b-92f6-33d591593d2d.jpg?1783933442", "scryfall_url": "https://scryfall.com/card/war/98/lilianas-triumph?utm_source=api", "types": ["Instant"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 1.0, "total": 0.6}, "reason": "A cheap instant that forces each opponent to sacrifice a creature and has an added discard effect if a Liliana planeswalker is controlled \u2014 strong removal that leverages Liliana's presence.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-ashes-2019-06-12"], "source_titles": ["War of the Spark: Ravnica\u2014Ashes"]}, {"name": "Liliana's Spoils", "image_url": "https://cards.scryfall.io/normal/front/e/9/e960fb5a-70cc-490d-99cf-99bc65485cfb.jpg?1783934485", "scryfall_url": "https://scryfall.com/card/m19/294/lilianas-spoils?utm_source=api", "types": ["Sorcery"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.603, "total": 0.521}, "reason": "A hand-attack spell that also tutors a black card from among the top five, helping keep the graveyard and engine fueled while disrupting opponents.", "source_urls": [], "source_titles": []}, {"name": "Liliana, Death Mage", "image_url": "https://cards.scryfall.io/normal/front/9/2/921e3dc3-f8eb-4498-a6a8-b424952230cd.jpg?1783930620", "scryfall_url": "https://scryfall.com/card/m21/328/liliana-death-mage?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.882, "synergy": 0.0, "similarity": 0.463, "total": 1.04}, "reason": "Returns creatures from the graveyard to the hand with +1, can destroy creatures with \u22123 (costing opponent life), and has a \u22127 that punishes opponents with graveyards \u2014 fitting a resurrection- and attrition-oriented Liliana plan.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 1, "title": "Nicol Bolas (domination and planeswalker tyranny)", "explanation": "These cards represent Nicol Bolas's overwhelming planeswalker power, hand- and board-disruption, and tools that enable or echo his imposed control \u2014 targets Liliana either resisted or was claimed by during story events.", "cards": [{"name": "Nicol Bolas, Dragon-God", "image_url": "https://cards.scryfall.io/normal/front/c/5/c5408607-af8f-48fe-bc40-32828d1976de.jpg?1783913282", "scryfall_url": "https://scryfall.com/card/rvr/205/nicol-bolas-dragon-god?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.85, "similarity": 0.846, "total": 1.512}, "reason": "Copies the loyalty abilities of all other planeswalkers on the battlefield and provides strong removal and hand/board disruption (+1 draws and forces exiles, \u22123 destroys a creature or planeswalker), representing an overriding planeswalker authority that Liliana ultimately opposed.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-ashes-2019-06-12", "https://magic.wizards.com/en/news/magic-story/return-dominaria-episode-12-2018-05-30"], "source_titles": ["War of the Spark: Ravnica\u2014Ashes", "Return to Dominaria: Episode 12"]}, {"name": "Nicol Bolas, the Ravager // Nicol Bolas, the Arisen", "image_url": "https://cards.scryfall.io/normal/front/7/b/7b215968-93a6-4278-ac61-4e3e8c3c3943.jpg?1783934524", "scryfall_url": "https://scryfall.com/card/m19/218/nicol-bolas-the-ravager-nicol-bolas-the-arisen?utm_source=api", "types": ["Creature", "Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.793, "similarity": 0.881, "total": 1.497}, "reason": "As a creature this card forces card discard when it enters and can be transformed into a planeswalker form that draws cards and deals heavy removal damage \u2014 a compact representation of Bolas's threat both as elder dragon and as planeswalker.", "source_urls": [], "source_titles": []}, {"name": "Nicol Bolas, God-Pharaoh", "image_url": "https://cards.scryfall.io/normal/front/5/9/597ca22d-2f08-47b3-9d93-c4d685cefb5f.jpg?1783921810", "scryfall_url": "https://scryfall.com/card/2x2/260/nicol-bolas-god-pharaoh?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.85, "similarity": 0.919, "total": 1.527}, "reason": "Exiles opponent library cards for potential free casting (+2 mills/exile), strips opponent hands with +1, and deals heavy damage with \u22124 \u2014 a planeswalker that enacts wide-reaching advantage and punishment befitting Bolas's domination of others.", "source_urls": [], "source_titles": []}, {"name": "Visage of Bolas", "image_url": "https://cards.scryfall.io/normal/front/f/2/f29bbfe2-d59f-4361-8ea4-6a8d1b909769.jpg?1783935983", "scryfall_url": "https://scryfall.com/card/hou/208/visage-of-bolas?utm_source=api", "types": ["Artifact"], "color_identity": ["U", "B", "R"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.902, "total": 0.545}, "reason": "An artifact that tutors for Nicol Bolas, the Deceiver, enabling Bolas-focused decks to assemble the elder dragon; it also provides the U/B/R mana Bolas values, representing Bolas-supporting infrastructure.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/return-dominaria-episode-12-2018-05-30"], "source_titles": ["Return to Dominaria: Episode 12"]}, {"name": "Wasp of the Bitter End", "image_url": "https://cards.scryfall.io/normal/front/4/6/46d348eb-7db0-4209-8960-c6adc473417d.jpg?1783935984", "scryfall_url": "https://scryfall.com/card/hou/206/wasp-of-the-bitter-end?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.744, "total": 0.514}, "reason": "Synergizes with casting Bolas planeswalker spells by offering a sacrifice-triggered destruction when sacrificed after casting a Bolas planeswalker spell, representing small enablers that support Bolas's oppressive plays.", "source_urls": [], "source_titles": []}]}

event: done
data: {"chips": ["Character: Liliana", "Character: Nicol Bolas"], "characters": [{"name": "Liliana", "role": "central"}, {"name": "Nicol Bolas", "role": "central"}], "intro": "Two opposing sides for a Liliana-versus-Bolas themed deck. One side contains Liliana cards and supporting undead/loyalty-manipulation pieces that represent her turning on or manipulating forces; the other side contains Nicol Bolas cards and Bolas-supporting artifacts and effects representing his domination and threats Liliana opposed or broke from.", "groups": [{"title": "Liliana's Rebellion (undead, sacrifice, redirection)", "explanation": "These cards provide Liliana-focused tools for making and using Zombies, forcing sacrifices and discard, and reanimating creatures \u2014 fitting a build that reflects Liliana raising and controlling undead, redirecting loyalty, and breaking from Bolas's control.", "cards": [{"name": "Liliana, Dreadhorde General", "image_url": "https://cards.scryfall.io/normal/front/c/b/cb28d217-795e-4320-a032-cd713f7ecc8a.jpg?1783909073", "scryfall_url": "https://scryfall.com/card/fdn/176/liliana-dreadhorde-general?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 0.882, "synergy": 0.481, "similarity": 0.432, "total": 1.216}, "reason": "Produces 2/2 Zombie tokens with her +1, draws cards whenever creatures die, and provides mass-sacrifice effects to clear boards; her -9 is a brutal ultimate that forces opponents to keep only one permanent of each type. Mechanically central to an undead, sacrifice-driven deck.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-ashes-2019-06-12"], "source_titles": ["War of the Spark: Ravnica\u2014Ashes"]}, {"name": "Liliana, Waker of the Dead", "image_url": "https://cards.scryfall.io/normal/front/e/3/e329a3e2-6702-4758-8aac-c3017e77b619.jpg?1783930705", "scryfall_url": "https://scryfall.com/card/m21/108/liliana-waker-of-the-dead?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.882, "synergy": 0.0, "similarity": 0.442, "total": 1.036}, "reason": "Encourages graveyard use and discard with +1 that pressures opponents' hands, uses graveyard size to weaken creatures with \u22123, and can emblematically reanimate creatures at the beginning of combat with \u22127 \u2014 supporting an ongoing army of reanimated threats.", "source_urls": [], "source_titles": []}, {"name": "Oath of Liliana", "image_url": "https://cards.scryfall.io/normal/front/2/0/2028f577-e0fb-48dd-89c6-f4a000b0a881.jpg?1783937481", "scryfall_url": "https://scryfall.com/card/emn/99/oath-of-liliana?utm_source=api", "types": ["Enchantment"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.538, "similarity": 0.759, "total": 0.756}, "reason": "Enters forcing each opponent to sacrifice a creature and then steadily creates 2/2 Zombie tokens when planeswalkers enter under the player's control, directly fueling a Liliana-led undead army and recurring token generation.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/return-dominaria-episode-11-2018-05-23"], "source_titles": ["Return to Dominaria: Episode 11"]}, {"name": "Liliana's Scrounger", "image_url": "https://cards.scryfall.io/normal/front/5/a/5a64625f-937a-449e-b1fc-cd0f25b033f6.jpg?1783930619", "scryfall_url": "https://scryfall.com/card/m21/330/lilianas-scrounger?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.839, "total": 0.568}, "reason": "Provides a recurring way to add loyalty counters to a Liliana planeswalker whenever creatures die, enabling plane\u00adswalker growth that complements sacrifice and death themes.", "source_urls": [], "source_titles": []}, {"name": "Desiccated Naga", "image_url": "https://cards.scryfall.io/normal/front/2/1/21f31e96-bb66-4b28-b14a-426d1d5839a6.jpg?1783936437", "scryfall_url": "https://scryfall.com/card/akh/276/desiccated-naga?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.987, "total": 0.562}, "reason": "Can convert board presence into incremental life-loss for opponents and life gain for the controller, but only when a Liliana planeswalker is controlled, making it a flavorful synergist for Liliana-centric decks.", "source_urls": [], "source_titles": []}, {"name": "Arisen Gorgon", "image_url": "https://cards.scryfall.io/normal/front/e/3/e39502fd-193c-4526-8dd8-0cd8c822552c.jpg?1783934483", "scryfall_url": "https://scryfall.com/card/m19/292/arisen-gorgon?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.883, "total": 0.541}, "reason": "Has deathtouch while a Liliana planeswalker is controlled, serving as a potent defensive or removal threat that scales with a Liliana-centric board state.", "source_urls": [], "source_titles": []}, {"name": "Liliana's Triumph", "image_url": "https://cards.scryfall.io/normal/front/8/4/84803db8-fdb0-462b-92f6-33d591593d2d.jpg?1783933442", "scryfall_url": "https://scryfall.com/card/war/98/lilianas-triumph?utm_source=api", "types": ["Instant"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 1.0, "total": 0.6}, "reason": "A cheap instant that forces each opponent to sacrifice a creature and has an added discard effect if a Liliana planeswalker is controlled \u2014 strong removal that leverages Liliana's presence.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-ashes-2019-06-12"], "source_titles": ["War of the Spark: Ravnica\u2014Ashes"]}, {"name": "Liliana's Spoils", "image_url": "https://cards.scryfall.io/normal/front/e/9/e960fb5a-70cc-490d-99cf-99bc65485cfb.jpg?1783934485", "scryfall_url": "https://scryfall.com/card/m19/294/lilianas-spoils?utm_source=api", "types": ["Sorcery"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.603, "total": 0.521}, "reason": "A hand-attack spell that also tutors a black card from among the top five, helping keep the graveyard and engine fueled while disrupting opponents.", "source_urls": [], "source_titles": []}, {"name": "Liliana, Death Mage", "image_url": "https://cards.scryfall.io/normal/front/9/2/921e3dc3-f8eb-4498-a6a8-b424952230cd.jpg?1783930620", "scryfall_url": "https://scryfall.com/card/m21/328/liliana-death-mage?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.882, "synergy": 0.0, "similarity": 0.463, "total": 1.04}, "reason": "Returns creatures from the graveyard to the hand with +1, can destroy creatures with \u22123 (costing opponent life), and has a \u22127 that punishes opponents with graveyards \u2014 fitting a resurrection- and attrition-oriented Liliana plan.", "source_urls": [], "source_titles": []}]}, {"title": "Nicol Bolas (domination and planeswalker tyranny)", "explanation": "These cards represent Nicol Bolas's overwhelming planeswalker power, hand- and board-disruption, and tools that enable or echo his imposed control \u2014 targets Liliana either resisted or was claimed by during story events.", "cards": [{"name": "Nicol Bolas, Dragon-God", "image_url": "https://cards.scryfall.io/normal/front/c/5/c5408607-af8f-48fe-bc40-32828d1976de.jpg?1783913282", "scryfall_url": "https://scryfall.com/card/rvr/205/nicol-bolas-dragon-god?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.85, "similarity": 0.846, "total": 1.512}, "reason": "Copies the loyalty abilities of all other planeswalkers on the battlefield and provides strong removal and hand/board disruption (+1 draws and forces exiles, \u22123 destroys a creature or planeswalker), representing an overriding planeswalker authority that Liliana ultimately opposed.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-ashes-2019-06-12", "https://magic.wizards.com/en/news/magic-story/return-dominaria-episode-12-2018-05-30"], "source_titles": ["War of the Spark: Ravnica\u2014Ashes", "Return to Dominaria: Episode 12"]}, {"name": "Nicol Bolas, the Ravager // Nicol Bolas, the Arisen", "image_url": "https://cards.scryfall.io/normal/front/7/b/7b215968-93a6-4278-ac61-4e3e8c3c3943.jpg?1783934524", "scryfall_url": "https://scryfall.com/card/m19/218/nicol-bolas-the-ravager-nicol-bolas-the-arisen?utm_source=api", "types": ["Creature", "Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.793, "similarity": 0.881, "total": 1.497}, "reason": "As a creature this card forces card discard when it enters and can be transformed into a planeswalker form that draws cards and deals heavy removal damage \u2014 a compact representation of Bolas's threat both as elder dragon and as planeswalker.", "source_urls": [], "source_titles": []}, {"name": "Nicol Bolas, God-Pharaoh", "image_url": "https://cards.scryfall.io/normal/front/5/9/597ca22d-2f08-47b3-9d93-c4d685cefb5f.jpg?1783921810", "scryfall_url": "https://scryfall.com/card/2x2/260/nicol-bolas-god-pharaoh?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.85, "similarity": 0.919, "total": 1.527}, "reason": "Exiles opponent library cards for potential free casting (+2 mills/exile), strips opponent hands with +1, and deals heavy damage with \u22124 \u2014 a planeswalker that enacts wide-reaching advantage and punishment befitting Bolas's domination of others.", "source_urls": [], "source_titles": []}, {"name": "Visage of Bolas", "image_url": "https://cards.scryfall.io/normal/front/f/2/f29bbfe2-d59f-4361-8ea4-6a8d1b909769.jpg?1783935983", "scryfall_url": "https://scryfall.com/card/hou/208/visage-of-bolas?utm_source=api", "types": ["Artifact"], "color_identity": ["U", "B", "R"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.902, "total": 0.545}, "reason": "An artifact that tutors for Nicol Bolas, the Deceiver, enabling Bolas-focused decks to assemble the elder dragon; it also provides the U/B/R mana Bolas values, representing Bolas-supporting infrastructure.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/return-dominaria-episode-12-2018-05-30"], "source_titles": ["Return to Dominaria: Episode 12"]}, {"name": "Wasp of the Bitter End", "image_url": "https://cards.scryfall.io/normal/front/4/6/46d348eb-7db0-4209-8960-c6adc473417d.jpg?1783935984", "scryfall_url": "https://scryfall.com/card/hou/206/wasp-of-the-bitter-end?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.744, "total": 0.514}, "reason": "Synergizes with casting Bolas planeswalker spells by offering a sacrifice-triggered destruction when sacrificed after casting a Bolas planeswalker spell, representing small enablers that support Bolas's oppressive plays.", "source_urls": [], "source_titles": []}]}]}

