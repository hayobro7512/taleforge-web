otal": 0.131}}, {"name": "Nahiri's Warcrafting", "image_url": "https://cards.scryfall.io/normal/front/a/0/a0453fea-3c88-4eb1-818a-9efa01986852.jpg?1783916985", "scryfall_url": "https://scryfall.com/card/mom/155/nahiris-warcrafting?utm_source=api", "types": ["Sorcery"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.643, "total": 0.129}}, {"name": "The Rise of Sozin // Fire Lord Sozin", "image_url": "https://cards.scryfall.io/normal/front/1/4/14eadf46-90c2-4376-8183-6a922a60174d.jpg?1783904970", "scryfall_url": "https://scryfall.com/card/tla/117/the-rise-of-sozin-fire-lord-sozin?utm_source=api", "types": ["Creature", "Enchantment"], "color_identity": ["B"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.642, "total": 0.128}}, {"name": "Silkweaver Elite", "image_url": "https://cards.scryfall.io/normal/front/d/1/d10938c8-6fc4-495f-912a-1d3f12278f78.jpg?1783936737", "scryfall_url": "https://scryfall.com/card/aer/125/silkweaver-elite?utm_source=api", "types": ["Creature"], "color_identity": ["G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.638, "total": 0.128}}, {"name": "Sarkhan the Mad", "image_url": "https://cards.scryfall.io/normal/front/2/6/26c1ba92-556e-4da9-8e3a-a4a82612cb29.jpg?1783941958", "scryfall_url": "https://scryfall.com/card/roe/214/sarkhan-the-mad?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B", "R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.636, "total": 0.127}}]}

event: explanation
data: {"index": 0, "title": "Nissa's Zendikar Fury (landbond, tokens, ramp)", "explanation": "This group builds around Nissa Revane as the deck's emotional and mechanical anchor: cards that search for lands or Nissa cards, animate or buff creatures via lands or planeswalker presence, and replace cards with value when playing creatures or tapping lands. It includes cards that explicitly reference Nissa mechanically and cards that support the land- and token-based strategy Zendikar favors in story and play.", "cards": [{"name": "Nissa Revane", "image_url": "https://cards.scryfall.io/normal/front/1/b/1b4c26ab-0f7b-4163-b9e4-a415b91352a6.jpg?1783942134", "scryfall_url": "https://scryfall.com/card/zen/170/nissa-revane?utm_source=api", "types": ["Planeswalker"], "color_identity": ["G"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.48, "total": 0.496}, "reason": "Nissa Revane is the commander/central planeswalker: her +1 finds Nissa's Chosen, another identity-focused tool; her other +1 gains life tied to Elf counts; her \u22127 deploys a set of Elf creatures from the library to the battlefield, enabling a dramatic land-and-creature payoff. Storywise, Nissa is deeply connected to Zendikar, has at times lost and later reconnected to the plane, has released and later fought the Eldrazi, and has merged elemental magic with artifacts such as the Lithoform Core \u2014 all of which justify a deck themed to animate and defend Zendikar.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/brink-extinction-2016-02-10", "https://magic.wizards.com/en/news/magic-story/episode-5-two-guardians-2020-09-30", "https://magic.wizards.com/en/news/magic-story/nissas-origin-home-2015-07-08"], "source_titles": ["Brink of Extinction", "Episode 5: The Two Guardians", "Nissa's Origin: Home"]}, {"name": "Nissa, Voice of Zendikar", "image_url": "https://cards.scryfall.io/normal/front/6/d/6de97cf1-49b6-40b2-ab7f-1c8eb98f92af.jpg?1783937273", "scryfall_url": "https://scryfall.com/card/ddr/1/nissa-voice-of-zendikar?utm_source=api", "types": ["Planeswalker"], "color_identity": ["G"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.018, "total": 0.624}, "reason": "This planeswalker generates 0/1 Plant tokens (+1), can pump the whole team with +1/+1 counters (\u22122), and offers a big land-count payoff (\u22127). These abilities support producing a board of small defenders that become larger threats \u2014 a natural fit for a Zendikar theme that animates the land.", "source_urls": [], "source_titles": []}, {"name": "Zendikar Resurgent", "image_url": "https://cards.scryfall.io/normal/front/3/3/33f64032-1e87-4d22-a211-c37e11ffa247.jpg?1783935887", "scryfall_url": "https://scryfall.com/card/c17/160/zendikar-resurgent?utm_source=api", "types": ["Enchantment"], "color_identity": ["G"], "evidence": ["lore"], "scores": {"story": 0.933, "synergy": 0.0, "similarity": 0.016, "total": 0.582}, "reason": "Zendikar Resurgent converts land-taps into bonus mana and gives card draw whenever a creature is cast, fueling large land-driven turns and refilling the hand after mass token deployment or elf-drops.", "source_urls": [], "source_titles": []}, {"name": "Nissa's Triumph", "image_url": "https://cards.scryfall.io/normal/front/7/9/7946b256-ae79-4b99-8bf4-0d627baf9044.jpg?1783933409", "scryfall_url": "https://scryfall.com/card/war/170/nissas-triumph?utm_source=api", "types": ["Sorcery"], "color_identity": ["G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.658, "total": 0.132}, "reason": "Nissa's Triumph tutors multiple basic Forests (or more lands if a Nissa planeswalker is present), accelerating land drops and enabling land-count thresholds that several Nissa cards care about.", "source_urls": [], "source_titles": []}, {"name": "Verdant Crescendo", "image_url": "https://cards.scryfall.io/normal/front/e/a/ea890019-f48f-4164-b057-773499ef273f.jpg?1783937135", "scryfall_url": "https://scryfall.com/card/kld/273/verdant-crescendo?utm_source=api", "types": ["Sorcery"], "color_identity": ["G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.675, "total": 0.135}, "reason": "Verdant Crescendo puts a basic land onto the battlefield tapped and searches for a specific Nissa card, enabling repeatable land ramp and directly finding key Nissa tools for the deck\u2019s theme.", "source_urls": [], "source_titles": []}, {"name": "Guardian of the Great Conduit", "image_url": "https://cards.scryfall.io/normal/front/7/2/72638ac5-84fd-4688-9b81-0eea3c05e53e.jpg?1783937136", "scryfall_url": "https://scryfall.com/card/kld/271/guardian-of-the-great-conduit?utm_source=api", "types": ["Creature"], "color_identity": ["G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.791, "total": 0.158}, "reason": "This Elemental gets bonuses while a Nissa planeswalker is controlled (becoming stronger and gaining vigilance), providing a resilient midrange creature that benefits from Nissa being on the battlefield.", "source_urls": [], "source_titles": []}, {"name": "Silkweaver Elite", "image_url": "https://cards.scryfall.io/normal/front/d/1/d10938c8-6fc4-495f-912a-1d3f12278f78.jpg?1783936737", "scryfall_url": "https://scryfall.com/card/aer/125/silkweaver-elite?utm_source=api", "types": ["Creature"], "color_identity": ["G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.638, "total": 0.128}, "reason": "An Elf with reach and a revolt-trigger that draws when a permanent left the battlefield that turn. It supports the Elf subtheme and provides card advantage when the deck sacrifices or otherwise churns permanents.", "source_urls": [], "source_titles": []}, {"name": "Reclaiming Vines", "image_url": "https://cards.scryfall.io/normal/front/1/8/18be4c1a-58d7-409e-b7e0-aadb5ccf814d.jpg?1783938185", "scryfall_url": "https://scryfall.com/card/bfz/185/reclaiming-vines?utm_source=api", "types": ["Sorcery"], "color_identity": ["G"], "evidence": ["lore"], "scores": {"story": 0.667, "synergy": 0.0, "similarity": 0.078, "total": 0.429}, "reason": "A one-shot removal spell that destroys an artifact, enchantment, or land \u2014 useful for clearing opposing permanents that block Zendikar\u2019s resurgence or that hinder land-based synergies.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 1, "title": "Zendikar's Fury \u2014 Aggression and Elemental Rupture", "explanation": "This group supplies the deck with haste, cascade/tempo extras, and enrage-style violence to represent Zendikar\u2019s unleashed fury: ways to push damage through, create big swings on the turn lands animate into attackers, and cascade into additional threats.", "cards": [{"name": "Rhythm of the Wild", "image_url": "https://cards.scryfall.io/normal/front/c/2/c2a6453e-a373-44ec-807a-15c0c8b1af57.jpg?1783913277", "scryfall_url": "https://scryfall.com/card/rvr/217/rhythm-of-the-wild?utm_source=api", "types": ["Enchantment"], "color_identity": ["R", "G"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.548, "similarity": 0.469, "total": 0.302}, "reason": "Rhythm of the Wild prevents opponents from countering the deck\u2019s creature spells and gives non-token creatures riot (entering with a choice of +1/+1 counters or haste), which enables explosive creature-based turns when Zendikar animates or when Nissa\u2019s effects put creatures into play.", "source_urls": [], "source_titles": []}, {"name": "Maelstrom Wanderer", "image_url": "https://cards.scryfall.io/normal/front/5/6/5685b28a-b943-4143-b9ed-4796c1ffbf9c.jpg?1783904536", "scryfall_url": "https://scryfall.com/card/ecc/127/maelstrom-wanderer?utm_source=api", "types": ["Creature"], "color_identity": ["U", "R", "G"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.484, "similarity": 0.418, "total": 0.267}, "reason": "Maelstrom Wanderer grants haste to all creatures and provides two cascade triggers on casting, which can cascade into additional threats or support spells and creates immediate impact befitting a deck themed on sudden elemental surges.", "source_urls": [], "source_titles": []}, {"name": "Frilled Deathspitter", "image_url": "https://cards.scryfall.io/normal/front/e/3/e3825798-f673-4d8a-9997-ccb73681cbf2.jpg?1783935298", "scryfall_url": "https://scryfall.com/card/rix/104/frilled-deathspitter?utm_source=api", "types": ["Creature"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.703, "total": 0.141}, "reason": "This Dinosaur has Enrage: whenever it is dealt damage, it deals 2 damage to an opponent or planeswalker. It turns combat damage taken by the creature into direct reach to opponents, representing Zendikar\u2019s violent retaliation.", "source_urls": [], "source_titles": []}, {"name": "Sun-Crowned Hunters", "image_url": "https://cards.scryfall.io/normal/front/3/c/3cab793e-0e17-4940-9cab-a30d62df5c20.jpg?1783935737", "scryfall_url": "https://scryfall.com/card/xln/164/sun-crowned-hunters?utm_source=api", "types": ["Creature"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.718, "total": 0.144}, "reason": "Another Dinosaur with Enrage that deals 3 damage when it is dealt damage, offering a larger enrage payoff for aggressive, creature-forward lines and synergy with effects that ping or bounce blockers.", "source_urls": [], "source_titles": []}, {"name": "Sarkhan the Mad", "image_url": "https://cards.scryfall.io/normal/front/2/6/26c1ba92-556e-4da9-8e3a-a4a82612cb29.jpg?1783941958", "scryfall_url": "https://scryfall.com/card/roe/214/sarkhan-the-mad?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B", "R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.636, "total": 0.127}, "reason": "Sarkhan provides card advantage through a 0 ability that draws the top card at the cost of life equal to its mana value, a \u22122 that can replace a creature with a 5/5 Dragon token, and a \u22124 that boosts Dragon damage; he supports a dragon/elemental subtheme and can convert slower board pieces into immediate flying threats.", "source_urls": [], "source_titles": []}]}

event: done
data: {"chips": ["Character: Nissa Revane", "Plane: Zendikar"], "characters": [{"name": "Nissa Revane", "role": "central"}], "intro": "Two themed sides focused on a Nissa Revane deck that channels Zendikar's fury: one group centers on Nissa herself, landfall/land synergy, and token/board growth; the other supplies aggressive elementals, haste, and enrage-style beaters to represent Zendikar\u2019s violent wilds.", "groups": [{"title": "Nissa's Zendikar Fury (landbond, tokens, ramp)", "explanation": "This group builds around Nissa Revane as the deck's emotional and mechanical anchor: cards that search for lands or Nissa cards, animate or buff creatures via lands or planeswalker presence, and replace cards with value when playing creatures or tapping lands. It includes cards that explicitly reference Nissa mechanically and cards that support the land- and token-based strategy Zendikar favors in story and play.", "cards": [{"name": "Nissa Revane", "image_url": "https://cards.scryfall.io/normal/front/1/b/1b4c26ab-0f7b-4163-b9e4-a415b91352a6.jpg?1783942134", "scryfall_url": "https://scryfall.com/card/zen/170/nissa-revane?utm_source=api", "types": ["Planeswalker"], "color_identity": ["G"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.48, "total": 0.496}, "reason": "Nissa Revane is the commander/central planeswalker: her +1 finds Nissa's Chosen, another identity-focused tool; her other +1 gains life tied to Elf counts; her \u22127 deploys a set of Elf creatures from the library to the battlefield, enabling a dramatic land-and-creature payoff. Storywise, Nissa is deeply connected to Zendikar, has at times lost and later reconnected to the plane, has released and later fought the Eldrazi, and has merged elemental magic with artifacts such as the Lithoform Core \u2014 all of which justify a deck themed to animate and defend Zendikar.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/brink-extinction-2016-02-10", "https://magic.wizards.com/en/news/magic-story/episode-5-two-guardians-2020-09-30", "https://magic.wizards.com/en/news/magic-story/nissas-origin-home-2015-07-08"], "source_titles": ["Brink of Extinction", "Episode 5: The Two Guardians", "Nissa's Origin: Home"]}, {"name": "Nissa, Voice of Zendikar", "image_url": "https://cards.scryfall.io/normal/front/6/d/6de97cf1-49b6-40b2-ab7f-1c8eb98f92af.jpg?1783937273", "scryfall_url": "https://scryfall.com/card/ddr/1/nissa-voice-of-zendikar?utm_source=api", "types": ["Planeswalker"], "color_identity": ["G"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.018, "total": 0.624}, "reason": "This planeswalker generates 0/1 Plant tokens (+1), can pump the whole team with +1/+1 counters (\u22122), and offers a big land-count payoff (\u22127). These abilities support producing a board of small defenders that become larger threats \u2014 a natural fit for a Zendikar theme that animates the land.", "source_urls": [], "source_titles": []}, {"name": "Zendikar Resurgent", "image_url": "https://cards.scryfall.io/normal/front/3/3/33f64032-1e87-4d22-a211-c37e11ffa247.jpg?1783935887", "scryfall_url": "https://scryfall.com/card/c17/160/zendikar-resurgent?utm_source=api", "types": ["Enchantment"], "color_identity": ["G"], "evidence": ["lore"], "scores": {"story": 0.933, "synergy": 0.0, "similarity": 0.016, "total": 0.582}, "reason": "Zendikar Resurgent converts land-taps into bonus mana and gives card draw whenever a creature is cast, fueling large land-driven turns and refilling the hand after mass token deployment or elf-drops.", "source_urls": [], "source_titles": []}, {"name": "Nissa's Triumph", "image_url": "https://cards.scryfall.io/normal/front/7/9/7946b256-ae79-4b99-8bf4-0d627baf9044.jpg?1783933409", "scryfall_url": "https://scryfall.com/card/war/170/nissas-triumph?utm_source=api", "types": ["Sorcery"], "color_identity": ["G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.658, "total": 0.132}, "reason": "Nissa's Triumph tutors multiple basic Forests (or more lands if a Nissa planeswalker is present), accelerating land drops and enabling land-count thresholds that several Nissa cards care about.", "source_urls": [], "source_titles": []}, {"name": "Verdant Crescendo", "image_url": "https://cards.scryfall.io/normal/front/e/a/ea890019-f48f-4164-b057-773499ef273f.jpg?1783937135", "scryfall_url": "https://scryfall.com/card/kld/273/verdant-crescendo?utm_source=api", "types": ["Sorcery"], "color_identity": ["G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.675, "total": 0.135}, "reason": "Verdant Crescendo puts a basic land onto the battlefield tapped and searches for a specific Nissa card, enabling repeatable land ramp and directly finding key Nissa tools for the deck\u2019s theme.", "source_urls": [], "source_titles": []}, {"name": "Guardian of the Great Conduit", "image_url": "https://cards.scryfall.io/normal/front/7/2/72638ac5-84fd-4688-9b81-0eea3c05e53e.jpg?1783937136", "scryfall_url": "https://scryfall.com/card/kld/271/guardian-of-the-great-conduit?utm_source=api", "types": ["Creature"], "color_identity": ["G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.791, "total": 0.158}, "reason": "This Elemental gets bonuses while a Nissa planeswalker is controlled (becoming stronger and gaining vigilance), providing a resilient midrange creature that benefits from Nissa being on the battlefield.", "source_urls": [], "source_titles": []}, {"name": "Silkweaver Elite", "image_url": "https://cards.scryfall.io/normal/front/d/1/d10938c8-6fc4-495f-912a-1d3f12278f78.jpg?1783936737", "scryfall_url": "https://scryfall.com/card/aer/125/silkweaver-elite?utm_source=api", "types": ["Creature"], "color_identity": ["G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.638, "total": 0.128}, "reason": "An Elf with reach and a revolt-trigger that draws when a permanent left the battlefield that turn. It supports the Elf subtheme and provides card advantage when the deck sacrifices or otherwise churns permanents.", "source_urls": [], "source_titles": []}, {"name": "Reclaiming Vines", "image_url": "https://cards.scryfall.io/normal/front/1/8/18be4c1a-58d7-409e-b7e0-aadb5ccf814d.jpg?1783938185", "scryfall_url": "https://scryfall.com/card/bfz/185/reclaiming-vines?utm_source=api", "types": ["Sorcery"], "color_identity": ["G"], "evidence": ["lore"], "scores": {"story": 0.667, "synergy": 0.0, "similarity": 0.078, "total": 0.429}, "reason": "A one-shot removal spell that destroys an artifact, enchantment, or land \u2014 useful for clearing opposing permanents that block Zendikar\u2019s resurgence or that hinder land-based synergies.", "source_urls": [], "source_titles": []}]}, {"title": "Zendikar's Fury \u2014 Aggression and Elemental Rupture", "explanation": "This group supplies the deck with haste, cascade/tempo extras, and enrage-style violence to represent Zendikar\u2019s unleashed fury: ways to push damage through, create big swings on the turn lands animate into attackers, and cascade into additional threats.", "cards": [{"name": "Rhythm of the Wild", "image_url": "https://cards.scryfall.io/normal/front/c/2/c2a6453e-a373-44ec-807a-15c0c8b1af57.jpg?1783913277", "scryfall_url": "https://scryfall.com/card/rvr/217/rhythm-of-the-wild?utm_source=api", "types": ["Enchantment"], "color_identity": ["R", "G"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.548, "similarity": 0.469, "total": 0.302}, "reason": "Rhythm of the Wild prevents opponents from countering the deck\u2019s creature spells and gives non-token creatures riot (entering with a choice of +1/+1 counters or haste), which enables explosive creature-based turns when Zendikar animates or when Nissa\u2019s effects put creatures into play.", "source_urls": [], "source_titles": []}, {"name": "Maelstrom Wanderer", "image_url": "https://cards.scryfall.io/normal/front/5/6/5685b28a-b943-4143-b9ed-4796c1ffbf9c.jpg?1783904536", "scryfall_url": "https://scryfall.com/card/ecc/127/maelstrom-wanderer?utm_source=api", "types": ["Creature"], "color_identity": ["U", "R", "G"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.484, "similarity": 0.418, "total": 0.267}, "reason": "Maelstrom Wanderer grants haste to all creatures and provides two cascade triggers on casting, which can cascade into additional threats or support spells and creates immediate impact befitting a deck themed on sudden elemental surges.", "source_urls": [], "source_titles": []}, {"name": "Frilled Deathspitter", "image_url": "https://cards.scryfall.io/normal/front/e/3/e3825798-f673-4d8a-9997-ccb73681cbf2.jpg?1783935298", "scryfall_url": "https://scryfall.com/card/rix/104/frilled-deathspitter?utm_source=api", "types": ["Creature"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.703, "total": 0.141}, "reason": "This Dinosaur has Enrage: whenever it is dealt damage, it deals 2 damage to an opponent or planeswalker. It turns combat damage taken by the creature into direct reach to opponents, representing Zendikar\u2019s violent retaliation.", "source_urls": [], "source_titles": []}, {"name": "Sun-Crowned Hunters", "image_url": "https://cards.scryfall.io/normal/front/3/c/3cab793e-0e17-4940-9cab-a30d62df5c20.jpg?1783935737", "scryfall_url": "https://scryfall.com/card/xln/164/sun-crowned-hunters?utm_source=api", "types": ["Creature"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.718, "total": 0.144}, "reason": "Another Dinosaur with Enrage that deals 3 damage when it is dealt damage, offering a larger enrage payoff for aggressive, creature-forward lines and synergy with effects that ping or bounce blockers.", "source_urls": [], "source_titles": []}, {"name": "Sarkhan the Mad", "image_url": "https://cards.scryfall.io/normal/front/2/6/26c1ba92-556e-4da9-8e3a-a4a82612cb29.jpg?1783941958", "scryfall_url": "https://scryfall.com/card/roe/214/sarkhan-the-mad?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B", "R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.636, "total": 0.127}, "reason": "Sarkhan provides card advantage through a 0 ability that draws the top card at the cost of life equal to its mana value, a \u22122 that can replace a creature with a 5/5 Dragon token, and a \u22124 that boosts Dragon damage; he supports a dragon/elemental subtheme and can convert slower board pieces into immediate flying threats.", "source_urls": [], "source_titles": []}]}]}

