data: {"cards": [{"name": "Nissa, Voice of Zendikar", "image_url": "https://cards.scryfall.io/normal/front/6/d/6de97cf1-49b6-40b2-ab7f-1c8eb98f92af.jpg?1783937273", "scryfall_url": "https://scryfall.com/card/ddr/1/nissa-voice-of-zendikar?utm_source=api", "types": ["Planeswalker"], "color_identity": ["G"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.018, "total": 0.624}}, {"name": "Zendikar Resurgent", "image_url": "https://cards.scryfall.io/normal/front/3/3/33f64032-1e87-4d22-a211-c37e11ffa247.jpg?1783935887", "scryfall_url": "https://scryfall.com/card/c17/160/zendikar-resurgent?utm_source=api", "types": ["Enchantment"], "color_identity": ["G"], "evidence": ["lore"], "scores": {"story": 0.933, "synergy": 0.0, "similarity": 0.016, "total": 0.582}}, {"name": "Gideon, Ally of Zendikar", "image_url": "https://cards.scryfall.io/normal/front/1/8/187e887c-c39d-4d25-a506-cdc95fc70316.jpg?1783938219", "scryfall_url": "https://scryfall.com/card/bfz/29/gideon-ally-of-zendikar?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.933, "synergy": 0.0, "similarity": 0.0, "total": 0.579}}, {"name": "Nissa Revane", "image_url": "https://cards.scryfall.io/normal/front/1/b/1b4c26ab-0f7b-4163-b9e4-a415b91352a6.jpg?1783942134", "scryfall_url": "https://scryfall.com/card/zen/170/nissa-revane?utm_source=api", "types": ["Planeswalker"], "color_identity": ["G"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.48, "total": 0.496}}, {"name": "Vivien Reid", "image_url": "https://cards.scryfall.io/normal/front/3/8/38769247-42a1-4571-9071-6d59fe28650a.jpg?1783909055", "scryfall_url": "https://scryfall.com/card/fdn/234/vivien-reid?utm_source=api", "types": ["Planeswalker"], "color_identity": ["G"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 1.0, "similarity": 0.459, "total": 0.472}}, {"name": "Reclaiming Vines", "image_url": "https://cards.scryfall.io/nor