ergy"], "scores": {"story": 0.0, "synergy": 0.902, "similarity": 0.646, "total": 0.472}}, {"name": "Master of Dark Rites", "image_url": "https://cards.scryfall.io/normal/front/6/3/6394a522-37bb-4cf3-b434-5121c8000ac6.jpg?1783913910", "scryfall_url": "https://scryfall.com/card/lcc/83/master-of-dark-rites?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.917, "similarity": 0.614, "total": 0.471}}, {"name": "Deadly Wanderings", "image_url": "https://cards.scryfall.io/normal/front/2/3/23bb5d9f-9b12-482a-91b4-6786e8310805.jpg?1783938599", "scryfall_url": "https://scryfall.com/card/dtk/94/deadly-wanderings?utm_source=api", "types": ["Enchantment"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.667, "synergy": 0.0, "similarity": 0.279, "total": 0.469}}, {"name": "Voldaren Estate", "image_url": "https://cards.scryfall.io/normal/front/1/f/1fcbc704-4fb3-49c3-9040-aa1681e86e2c.jpg?1783913817", "scryfall_url": "https://scryfall.com/card/lcc/369/voldaren-estate?utm_source=api", "types": ["Land"], "color_identity": [], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.845, "similarity": 0.735, "total": 0.468}}, {"name": "Clavile\u00f1o, First of the Blessed", "image_url": "https://cards.scryfall.io/normal/front/9/f/9f55b648-b1ec-407a-a0c7-7647755793d1.jpg?1783913936", "scryfall_url": "https://scryfall.com/card/lcc/2/clavile%C3%B1o-first-of-the-blessed?utm_source=api", "types": ["Creature"], "color_identity": ["W", "B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.889, "similarity": 0.644, "total": 0.467}}]}

event: explanation
data: {"index": 0, "title": "Sorin's leadership and support", "explanation": "Planeswalker Sorin and Vampire-support pieces that enable recursion, lifegain, and sacrifice/mana lines to power big Vampire plays. Story connections highlight Sorin's central role on Innistrad and his interactions with other key figures.", "cards": [{"name": "Sorin Markov", "image_url": "https://cards.scryfall.io/normal/front/e/2/e25b3a89-3a99-4e02-bf0c-a3cf450da1a1.jpg?1783941077", "scryfall_url": "https://scryfall.com/card/m12/109/sorin-markov?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.793, "total": 0.559}, "reason": "The namesake commander: a high-impact planeswalker with a +2 damage/life ability, a \u22123 that sets an opponent's life total to 10 (a strong midgame finisher), and a \u22127 ultimate that seizes a player's turn. Story facts: Sorin has imprisoned and been imprisoned by Nahiri, discovered Edgar missing, read an invitation to Olivia Voldaren's wedding, attacked and was attacked by other major figures, created Avacyn, and later destroyed Avacyn.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/campaign-vengeance-2016-07-06", "https://magic.wizards.com/en/news/magic-story/emrakul-rises", "https://magic.wizards.com/en/news/magic-story/episode-1-tithes-and-invitations-2021-10-28", "https://magic.wizards.com/en/news/magic-story/episode-4-wedding-crashers-2021-11-17", "https://magic.wizards.com/en/news/magic-story/episode-5-till-death-do-us-part-2021-11-24", "https://magic.wizards.com/en/news/magic-story/i-am-avacyn-2016-05-18"], "source_titles": ["Campaign of Vengeance", "Emrakul Rises", "Episode 1: Tithes and Invitations", "Episode 4: The Wedding Crashers", "Episode 5: Till Death Do Us Part", "I Am Avacyn"]}, {"name": "Sorin, Imperious Bloodlord", "image_url": "https://cards.scryfall.io/normal/front/2/1/219d3e48-e0b1-472d-ac45-11c14b292c9e.jpg?1790212178", "scryfall_url": "https://scryfall.com/card/inr/133/sorin-imperious-bloodlord?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.872, "similarity": 0.986, "total": 0.529}, "reason": "Provides repeated small token/recursion support: +1 grants deathtouch and lifelink (and a counter if the creature is a Vampire), another +1 lets Sorin sacrifice a Vampire to deal 3 damage and gain 3 life, and \u22123 can cheat a Vampire creature from hand onto the battlefield\u2014strong synergy with token generators and sacrifice outlets.", "source_urls": [], "source_titles": []}, {"name": "Sorin, Vengeful Bloodlord", "image_url": "https://cards.scryfall.io/normal/front/3/5/354fe9bd-4ec8-409c-8ce5-b29393f3d169.jpg?1783933388", "scryfall_url": "https://scryfall.com/card/war/217/sorin-vengeful-bloodlord?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W", "B"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.868, "total": 0.794}, "reason": "Auras-style global lifelink for the player's creatures during their turn and a powerful \u2212X that can return a creature from the graveyard as a Vampire\u2014excellent for recurring key creatures and turning dead threats back into battlefield Vampires.", "source_urls": [], "source_titles": []}, {"name": "Sorin the Mirthless", "image_url": "https://cards.scryfall.io/normal/front/c/c/cc7ff5f4-a7cc-41a1-a22b-8cf67ad18707.jpg?1783924850", "scryfall_url": "https://scryfall.com/card/vow/131/sorin-the-mirthless?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.933, "synergy": 0.0, "similarity": 1.0, "total": 0.779}, "reason": "Card selection + looting on +1, a \u22122 that creates a 2/3 flying lifelink Vampire token (providing bodies and lifegain), and a large \u22127 damage/ life swing ultimate\u2014good for token generation and steady card advantage.", "source_urls": [], "source_titles": []}, {"name": "Master of Dark Rites", "image_url": "https://cards.scryfall.io/normal/front/6/3/6394a522-37bb-4cf3-b434-5121c8000ac6.jpg?1783913910", "scryfall_url": "https://scryfall.com/card/lcc/83/master-of-dark-rites?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.917, "similarity": 0.614, "total": 0.471}, "reason": "A cheap sacrifice engine that can convert a sacrificed creature into {B}{B}{B} usable only for Vampire/Cleric/Demon spells. Works well with token producers and sacrifice loops to accelerate big Vampires or planeswalker plays.", "source_urls": [], "source_titles": []}, {"name": "Preacher of the Schism", "image_url": "https://cards.scryfall.io/normal/front/8/9/89345f55-2b32-4356-945a-d56dded39909.jpg?1783913774", "scryfall_url": "https://scryfall.com/card/lci/113/preacher-of-the-schism?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.947, "similarity": 0.66, "total": 0.492}, "reason": "A deathtouch attacker that creates 1/1 lifelink Vampire tokens when attacking the player with the most life, and draws when attacking while the controller has the most life\u2014trades and life-swing utility that complements Sorin's lifegain toolkit.", "source_urls": [], "source_titles": []}, {"name": "Markov Baron", "image_url": "https://cards.scryfall.io/normal/front/a/1/a1dc6b0f-09bb-4489-8022-42c700eb1191.jpg?1783916524", "scryfall_url": "https://scryfall.com/card/mat/14/markov-baron?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.933, "synergy": 0.0, "similarity": 0.801, "total": 0.739}, "reason": "A convoke lifelink creature that gives other Vampires +1/+1; its convoke option accelerates casting in creature-heavy builds and its synergy with discards (madness) and lifelink supports the deck's sustain strategy.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 1, "title": "Markov warband \u2014 token & beatdown core", "explanation": "Aggressive Vampire creatures, anthem effects, and token makers that push damage while benefiting from Sorin's support and the deck's sacrifice/recursion tools. Several cards are tied to the Markov family and Innistrad events involving Sorin and Edgar.", "cards": [{"name": "Edgar Markov", "image_url": "https://cards.scryfall.io/normal/front/a/5/a577ba08-0aa8-45be-aa83-d5078770127c.jpg?1783908078", "scryfall_url": "https://scryfall.com/card/inr/234/edgar-markov?utm_source=api", "types": ["Creature"], "color_identity": ["W", "B", "R"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.93, "similarity": 0.756, "total": 0.505}, "reason": "A signature Vampire leader with Eminence: whenever another Vampire is cast while Edgar is in the command zone or on the battlefield, a 1/1 Vampire token is created; he has first strike and haste, and gives a global +1/+1 on attack. Story fact: Edgar is a central Markov family figure who confronts Sorin during Innistrad events and was missing from the mausoleum that Sorin discovered.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-1-tithes-and-invitations-2021-10-28", "https://magic.wizards.com/en/news/magic-story/episode-4-wedding-crashers-2021-11-17", "https://magic.wizards.com/en/news/magic-story/episode-5-till-death-do-us-part-2021-11-24"], "source_titles": ["Episode 1: Tithes and Invitations", "Episode 4: The Wedding Crashers", "Episode 5: Till Death Do Us Part"]}, {"name": "Edgar, Charmed Groom // Edgar Markov's Coffin", "image_url": "https://cards.scryfall.io/normal/front/6/3/63ba8eef-b834-4031-b0a1-0f8505d53813.jpg?1783924799", "scryfall_url": "https://scryfall.com/card/vow/236/edgar-charmed-groom-edgar-markovs-coffin?utm_source=api", "types": ["Creature", "Artifact"], "color_identity": ["W", "B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.912, "similarity": 0.792, "total": 0.505}, "reason": "A two-sided piece that buffs other Vampires with +1/+1 while Edgar is active and produces recurring 1/1 lifelink Vampire tokens during upkeep as the artifact side accumulates counters; fits the Markov-family narrative and token strategy.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-1-tithes-and-invitations-2021-10-28", "https://magic.wizards.com/en/news/magic-story/episode-4-wedding-crashers-2021-11-17"], "source_titles": ["Episode 1: Tithes and Invitations", "Episode 4: The Wedding Crashers"]}, {"name": "Bloodline Keeper // Lord of Lineage", "image_url": "https://cards.scryfall.io/normal/front/6/0/60658907-dd63-478d-a66a-123e4e9d2a00.jpg?1783908156", "scryfall_url": "https://scryfall.com/card/inr/98/bloodline-keeper-lord-of-lineage?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.938, "similarity": 0.595, "total": 0.475}, "reason": "A transformable Vampire that makes 2/2 flying Vampire tokens and, when transformed, gives other Vampires +2/+2 while continuing token production\u2014excellent for steady bodies and anthem power.", "source_urls": [], "source_titles": []}, {"name": "Captivating Vampire", "image_url": "https://cards.scryfall.io/normal/front/0/f/0f87aadf-7638-4691-b5a5-86f928e98462.jpg?1783908149", "scryfall_url": "https://scryfall.com/card/inr/100/captivating-vampire?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.909, "similarity": 0.671, "total": 0.48}, "reason": "Grants other Vampires +1/+1 and has a five-Vampire tap ability to take control of a target creature and make it a Vampire\u2014powerful late-game top-end that turns opposing creatures into more Vampires.", "source_urls": [], "source_titles": []}, {"name": "Vampire Nocturnus", "image_url": "https://cards.scryfall.io/normal/front/8/d/8daccbbb-6600-4467-810f-277f01a11771.jpg?1783940488", "scryfall_url": "https://scryfall.com/card/m13/113/vampire-nocturnus?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 1.0, "similarity": 0.701, "total": 0.52}, "reason": "A build-around card that reads the top card of the library; if it is black, Vampire Nocturnus and other Vampires get +2/+1 and flying\u2014an anthem that can dramatically increase board power when the library is set up.", "source_urls": [], "source_titles": []}, {"name": "Sanctum Seeker", "image_url": "https://cards.scryfall.io/normal/front/8/9/893279fb-6f51-4d1e-b2fd-a0cdb603785f.jpg?1783913869", "scryfall_url": "https://scryfall.com/card/lcc/209/sanctum-seeker?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.902, "similarity": 0.646, "total": 0.472}, "reason": "An aggressive anthem that drains each opponent for 1 and gains 1 life whenever a Vampire attacks; scales well in multiplayer and with token swarms to turn attacks into life swings.", "source_urls": [], "source_titles": []}, {"name": "Stromkirk Captain", "image_url": "https://cards.scryfall.io/normal/front/2/f/2f053406-d2e4-4443-81f1-025e3b27c65a.jpg?1783924943", "scryfall_url": "https://scryfall.com/card/voc/157/stromkirk-captain?utm_source=api", "types": ["Creature"], "color_identity": ["B", "R"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.901, "similarity": 0.682, "total": 0.479}, "reason": "A cheap first-strike Vampire that grants other Vampires +1/+1 and first strike\u2014excellent early-game aggression and combat advantage.", "source_urls": [], "source_titles": []}, {"name": "Markov Crusader", "image_url": "https://cards.scryfall.io/normal/front/8/7/87d8354b-df56-4294-9f8a-b7c92e31b88e.jpg?1783937481", "scryfall_url": "https://scryfall.com/card/emn/95/markov-crusader?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.933, "synergy": 0.0, "similarity": 0.656, "total": 0.71}, "reason": "A lifelink attacker that gains haste while another Vampire is present\u2014provides immediate pressure and life sustain in coordinated Vampire boards.", "source_urls": [], "source_titles": []}, {"name": "Markov Dreadknight", "image_url": "https://cards.scryfall.io/normal/front/f/a/fa3ed9d2-9053-4583-a226-0ab49bbdab6e.jpg?1783937770", "scryfall_url": "https://scryfall.com/card/soi/122/markov-dreadknight?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.933, "synergy": 0.0, "similarity": 0.044, "total": 0.587}, "reason": "A flying Vampire Knight that can be pumped by discarding to put two +1/+1 counters on it, offering a resilient midrange threat that grows with hand/dump synergy.", "source_urls": [], "source_titles": []}, {"name": "Markov Waltzer", "image_url": "https://cards.scryfall.io/normal/front/2/3/231f4da2-8756-4f99-a46f-b8afe9adb80d.jpg?1783908075", "scryfall_url": "https://scryfall.com/card/inr/245/markov-waltzer?utm_source=api", "types": ["Creature"], "color_identity": ["W", "R"], "evidence": ["lore"], "scores": {"story": 0.933, "synergy": 0.0, "similarity": 0.0, "total": 0.579}, "reason": "A flying haste Vampire that can boost two creatures at the beginning of combat\u2014useful for surprise damage and synergy with token attackers.", "source_urls": [], "source_titles": []}, {"name": "Voldaren Estate", "image_url": "https://cards.scryfall.io/normal/front/1/f/1fcbc704-4fb3-49c3-9040-aa1681e86e2c.jpg?1783913817", "scryfall_url": "https://scryfall.com/card/lcc/369/voldaren-estate?utm_source=api", "types": ["Land"], "color_identity": [], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.845, "similarity": 0.735, "total": 0.468}, "reason": "A utility land that can produce colorless mana, pay 1 life to add any color only for casting Vampire spells, and can make Blood tokens with a cost reduced by the number of Vampires controlled\u2014supports both color-fixing for a multicolor Vampire suite and token-synergy mana generation.", "source_urls": [], "source_titles": []}, {"name": "Olivia's Wrath", "image_url": "https://cards.scryfall.io/normal/front/3/e/3eb5cc8d-a198-43cd-a2bd-9c9414d815b2.jpg?1783913871", "scryfall_url": "https://scryfall.com/card/lcc/205/olivias-wrath?utm_source=api", "types": ["Sorcery"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.893, "similarity": 0.676, "total": 0.475}, "reason": "A one-sided board control sorcery that gives non-Vampire creatures -X/-X until end of turn, where X is the number of Vampires controlled\u2014an efficient sweeper against non-Vampire boards that protects a Vampire swarm.", "source_urls": [], "source_titles": []}, {"name": "Falkenrath Pit Fighter", "image_url": "https://cards.scryfall.io/normal/front/a/7/a743a3b6-3278-4644-a2d5-acf495c273ed.jpg?1783925603", "scryfall_url": "https://scryfall.com/card/mid/137/falkenrath-pit-fighter?utm_source=api", "types": ["Creature"], "color_identity": ["R"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.965, "similarity": 0.888, "total": 0.544}, "reason": "A cheap red splash option for card draw: discard + sacrifice a Vampire to draw two cards (activation only if an opponent lost life this turn). Works as a sacrificial outlet and card-advantage engine in aggressive Vampire builds.", "source_urls": [], "source_titles": []}, {"name": "Voldaren Estate", "image_url": "https://cards.scryfall.io/normal/front/1/f/1fcbc704-4fb3-49c3-9040-aa1681e86e2c.jpg?1783913817", "scryfall_url": "https://scryfall.com/card/lcc/369/voldaren-estate?utm_source=api", "types": ["Land"], "color_identity": [], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.845, "similarity": 0.735, "total": 0.468}, "reason": "Provides the deck with flexible mana for Vampire spells and an activated ability to create Blood tokens; scales with the number of Vampires and supports casting and recursion.", "source_urls": [], "source_titles": []}]}

event: done
data: {"chips": ["Character: Sorin Markov", "Card type: Planeswalker", "Card type: Vampire", "Play style: vampire tribal"], "characters": [{"name": "Sorin Markov", "role": "central"}], "intro": "A focused Vampire deck built around Sorin Markov's themes: cards that support Vampire tribal synergies, provide token generation and pump effects, and represent characters and events tied to Sorin's story. Cards are grouped into Sorin's leadership and the Markov/warband combat core.", "groups": [{"title": "Sorin's leadership and support", "explanation": "Planeswalker Sorin and Vampire-support pieces that enable recursion, lifegain, and sacrifice/mana lines to power big Vampire plays. Story connections highlight Sorin's central role on Innistrad and his interactions with other key figures.", "cards": [{"name": "Sorin Markov", "image_url": "https://cards.scryfall.io/normal/front/e/2/e25b3a89-3a99-4e02-bf0c-a3cf450da1a1.jpg?1783941077", "scryfall_url": "https://scryfall.com/card/m12/109/sorin-markov?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.793, "total": 0.559}, "reason": "The namesake commander: a high-impact planeswalker with a +2 damage/life ability, a \u22123 that sets an opponent's life total to 10 (a strong midgame finisher), and a \u22127 ultimate that seizes a player's turn. Story facts: Sorin has imprisoned and been imprisoned by Nahiri, discovered Edgar missing, read an invitation to Olivia Voldaren's wedding, attacked and was attacked by other major figures, created Avacyn, and later destroyed Avacyn.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/campaign-vengeance-2016-07-06", "https://magic.wizards.com/en/news/magic-story/emrakul-rises", "https://magic.wizards.com/en/news/magic-story/episode-1-tithes-and-invitations-2021-10-28", "https://magic.wizards.com/en/news/magic-story/episode-4-wedding-crashers-2021-11-17", "https://magic.wizards.com/en/news/magic-story/episode-5-till-death-do-us-part-2021-11-24", "https://magic.wizards.com/en/news/magic-story/i-am-avacyn-2016-05-18"], "source_titles": ["Campaign of Vengeance", "Emrakul Rises", "Episode 1: Tithes and Invitations", "Episode 4: The Wedding Crashers", "Episode 5: Till Death Do Us Part", "I Am Avacyn"]}, {"name": "Sorin, Imperious Bloodlord", "image_url": "https://cards.scryfall.io/normal/front/2/1/219d3e48-e0b1-472d-ac45-11c14b292c9e.jpg?1790212178", "scryfall_url": "https://scryfall.com/card/inr/133/sorin-imperious-bloodlord?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.872, "similarity": 0.986, "total": 0.529}, "reason": "Provides repeated small token/recursion support: +1 grants deathtouch and lifelink (and a counter if the creature is a Vampire), another +1 lets Sorin sacrifice a Vampire to deal 3 damage and gain 3 life, and \u22123 can cheat a Vampire creature from hand onto the battlefield\u2014strong synergy with token generators and sacrifice outlets.", "source_urls": [], "source_titles": []}, {"name": "Sorin, Vengeful Bloodlord", "image_url": "https://cards.scryfall.io/normal/front/3/5/354fe9bd-4ec8-409c-8ce5-b29393f3d169.jpg?1783933388", "scryfall_url": "https://scryfall.com/card/war/217/sorin-vengeful-bloodlord?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W", "B"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.868, "total": 0.794}, "reason": "Auras-style global lifelink for the player's creatures during their turn and a powerful \u2212X that can return a creature from the graveyard as a Vampire\u2014excellent for recurring key creatures and turning dead threats back into battlefield Vampires.", "source_urls": [], "source_titles": []}, {"name": "Sorin the Mirthless", "image_url": "https://cards.scryfall.io/normal/front/c/c/cc7ff5f4-a7cc-41a1-a22b-8cf67ad18707.jpg?1783924850", "scryfall_url": "https://scryfall.com/card/vow/131/sorin-the-mirthless?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.933, "synergy": 0.0, "similarity": 1.0, "total": 0.779}, "reason": "Card selection + looting on +1, a \u22122 that creates a 2/3 flying lifelink Vampire token (providing bodies and lifegain), and a large \u22127 damage/ life swing ultimate\u2014good for token generation and steady card advantage.", "source_urls": [], "source_titles": []}, {"name": "Master of Dark Rites", "image_url": "https://cards.scryfall.io/normal/front/6/3/6394a522-37bb-4cf3-b434-5121c8000ac6.jpg?1783913910", "scryfall_url": "https://scryfall.com/card/lcc/83/master-of-dark-rites?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.917, "similarity": 0.614, "total": 0.471}, "reason": "A cheap sacrifice engine that can convert a sacrificed creature into {B}{B}{B} usable only for Vampire/Cleric/Demon spells. Works well with token producers and sacrifice loops to accelerate big Vampires or planeswalker plays.", "source_urls": [], "source_titles": []}, {"name": "Preacher of the Schism", "image_url": "https://cards.scryfall.io/normal/front/8/9/89345f55-2b32-4356-945a-d56dded39909.jpg?1783913774", "scryfall_url": "https://scryfall.com/card/lci/113/preacher-of-the-schism?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.947, "similarity": 0.66, "total": 0.492}, "reason": "A deathtouch attacker that creates 1/1 lifelink Vampire tokens when attacking the player with the most life, and draws when attacking while the controller has the most life\u2014trades and life-swing utility that complements Sorin's lifegain toolkit.", "source_urls": [], "source_titles": []}, {"name": "Markov Baron", "image_url": "https://cards.scryfall.io/normal/front/a/1/a1dc6b0f-09bb-4489-8022-42c700eb1191.jpg?1783916524", "scryfall_url": "https://scryfall.com/card/mat/14/markov-baron?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.933, "synergy": 0.0, "similarity": 0.801, "total": 0.739}, "reason": "A convoke lifelink creature that gives other Vampires +1/+1; its convoke option accelerates casting in creature-heavy builds and its synergy with discards (madness) and lifelink supports the deck's sustain strategy.", "source_urls": [], "source_titles": []}]}, {"title": "Markov warband \u2014 token & beatdown core", "explanation": "Aggressive Vampire creatures, anthem effects, and token makers that push damage while benefiting from Sorin's support and the deck's sacrifice/recursion tools. Several cards are tied to the Markov family and Innistrad events involving Sorin and Edgar.", "cards": [{"name": "Edgar Markov", "image_url": "https://cards.scryfall.io/normal/front/a/5/a577ba08-0aa8-45be-aa83-d5078770127c.jpg?1783908078", "scryfall_url": "https://scryfall.com/card/inr/234/edgar-markov?utm_source=api", "types": ["Creature"], "color_identity": ["W", "B", "R"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.93, "similarity": 0.756, "total": 0.505}, "reason": "A signature Vampire leader with Eminence: whenever another Vampire is cast while Edgar is in the command zone or on the battlefield, a 1/1 Vampire token is created; he has first strike and haste, and gives a global +1/+1 on attack. Story fact: Edgar is a central Markov family figure who confronts Sorin during Innistrad events and was missing from the mausoleum that Sorin discovered.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-1-tithes-and-invitations-2021-10-28", "https://magic.wizards.com/en/news/magic-story/episode-4-wedding-crashers-2021-11-17", "https://magic.wizards.com/en/news/magic-story/episode-5-till-death-do-us-part-2021-11-24"], "source_titles": ["Episode 1: Tithes and Invitations", "Episode 4: The Wedding Crashers", "Episode