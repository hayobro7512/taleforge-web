data: {"cards": [{"name": "Niv-Mizzet, Parun", "image_url": "https://cards.scryfall.io/normal/front/8/6/86c5c337-d25f-4c3e-9762-09ed0c2d36d7.jpg?1783911897", "scryfall_url": "https://scryfall.com/card/otc/235/niv-mizzet-parun?utm_source=api", "types": ["Creature"], "color_identity": ["U", "R"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.474, "total": 1.115}}, {"name": "Niv-Mizzet Reborn", "image_url": "https://cards.scryfall.io/normal/front/5/6/56a2609d-b535-400b-81d9-72989a33c70f.jpg?1783933391", "scryfall_url": "https://scryfall.com/card/war/208/niv-mizzet-reborn?utm_source=api", "types": ["Creature"], "color_identity": ["W", "U", "B", "R", "G"], "evidence": ["lore"], "scores": {"story": 0.941, "synergy": 0.0, "similarity": 0.409, "total": 1.065}}, {"name": "Gideon Blackblade", "image_url": "https://cards.scryfall.io/normal/front/4/1/41326ca6-f815-4af7-b022-67db127bc125.jpg?1783913347", "scryfall_url": "https://scryfall.com/card/rvr/20/gideon-blackblade?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.434, "total": 0.997}}, {"name": "Nicol Bolas, Dragon-God", "image_url": "https://cards.scryfall.io/normal/front/c/5/c5408607-af8f-48fe-bc40-32828d1976de.jpg?1783913282", "scryfall_url": "https://scryfall.com/card/rvr/205/nicol-bolas-dragon-god?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.866, "total": 0.793}}, {"name": "Niv-Mizzet, the Firemind", "image_url": "https://cards.scryfall.io/normal/front/3/9/395465b8-f5ed-4668-9e6a-82257150c52c.jpg?1783931145", "scryfall_url": "https://scryfall.com/card/c20/225/niv-mizzet-the-firemind?utm_source=api", "types": ["Creature"], "color_identity": ["U", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.695, "similarity": 0.415, "total": 0.747}}, {"name": "N