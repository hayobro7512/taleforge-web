"types": ["Creature"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.59, "total": 0.518}}, {"name": "Eldrazi Devastator", "image_url": "https://cards.scryfall.io/normal/front/0/4/04b13e32-01b9-4a86-a3df-ca8b784c6a6c.jpg?1783938225", "scryfall_url": "https://scryfall.com/card/bfz/7/eldrazi-devastator?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.0, "total": 0.511}}, {"name": "Nahiri's Warcrafting", "image_url": "https://cards.scryfall.io/normal/front/a/0/a0453fea-3c88-4eb1-818a-9efa01986852.jpg?1783916985", "scryfall_url": "https://scryfall.com/card/mom/155/nahiris-warcrafting?utm_source=api", "types": ["Sorcery"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.542, "total": 0.508}}, {"name": "Nahiri's Resolve", "image_url": "https://cards.scryfall.io/normal/front/d/f/df9acf30-b4f4-4e99-9763-a3055e91fefb.jpg?1783916513", "scryfall_url": "https://scryfall.com/card/mat/37/nahiris-resolve?utm_source=api", "types": ["Enchantment"], "color_identity": ["W", "R"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.535, "total": 0.507}}, {"name": "Kiora of Fire and Ashes", "image_url": "https://cards.scryfall.io/normal/front/0/8/08657053-86f9-4c52-abf0-d9cdd443ae3b.jpg?1789127995", "scryfall_url": "https://scryfall.com/card/fra/247/kiora-of-fire-and-ashes?utm_source=api", "types": ["Creature"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.534, "total": 0.507}}, {"name": "Eye of Ugin", "image_url": "https://cards.scryfall.io/normal/front/d/2/d2d5124b-4d73-4aa9-9331-88e03779ffad.jpg?1790304976", "scryfall_url": "https://scryfall.com/card/mm2/242/eye-of-ugin?utm_source=api", "types": ["Land"], "color_identity": [], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.982, "similarity": 0.666, "total": 0.506}}, {"name": "Kiora, the Rising Tide", "image_url": "https://cards.scryfall.io/normal/front/8/3/83f20a32-9f5d-4a68-8995-549e57554da2.jpg?1783909116", "scryfall_url": "https://scryfall.com/card/fdn/45/kiora-the-rising-tide?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.523, "total": 0.505}}, {"name": "The Theorist, Jace Beleren", "image_url": "https://cards.scryfall.io/normal/front/2/0/20bb8c55-4b0b-425f-8201-b54fa2fdde86.jpg?1788329228", "scryfall_url": "https://scryfall.com/card/fra/43/the-theorist-jace-beleren?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.493, "total": 0.499}}, {"name": "Kiora, the Crashing Wave", "image_url": "https://cards.scryfall.io/normal/front/0/c/0c5c6b15-b72d-4341-92c2-7469210452da.jpg?1783938631", "scryfall_url": "https://scryfall.com/card/ddo/34/kiora-the-crashing-wave?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "G"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.453, "total": 0.491}}, {"name": "Kiora, Behemoth Beckoner", "image_url": "https://cards.scryfall.io/normal/front/7/a/7a61b1a6-a75f-47b0-b215-de9708b6d773.jpg?1783933378", "scryfall_url": "https://scryfall.com/card/war/232/kiora-behemoth-beckoner?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "G"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.452, "total": 0.49}}]}

event: explanation
data: {"index": 0, "title": "Zendikar's defenders", "explanation": "These cards represent the Planeswalker-led and native forces that fought to stop the Eldrazi onslaught and to trap or hold back the Eldrazi titans. Mechanics shown include token generation and creature support, battlefield defense, and graveyard/resource advantage to sustain repeated defenses.", "cards": [{"name": "Gideon, Ally of Zendikar", "image_url": "https://cards.scryfall.io/normal/front/1/8/187e887c-c39d-4d25-a506-cdc95fc70316.jpg?1783938219", "scryfall_url": "https://scryfall.com/card/bfz/29/gideon-ally-of-zendikar?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.882, "synergy": 0.0, "similarity": 0.247, "total": 0.597}, "reason": "Gideon provides battlefield defense and creature production: he can become a 5/5 indestructible attacker/defender for a turn, make 2/2 Knight Ally tokens, and grant a global +1/+1 emblem. Storywise, Gideon organized the trap and helped hold back Ulamog while the hedron network was assembled, making him central to Zendikar's defense efforts.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/catching-2015-07-22", "https://magic.wizards.com/en/news/magic-story/hedron-alignment-2015-11-18"], "source_titles": ["Catching Up", "Hedron Alignment"]}, {"name": "Kiora, Master of the Depths", "image_url": "https://cards.scryfall.io/normal/front/4/b/4b63c228-3265-4029-9bc0-36b3e31dfb53.jpg?1783938179", "scryfall_url": "https://scryfall.com/card/bfz/213/kiora-master-of-the-depths?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "G"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.286, "total": 1.077}, "reason": "Kiora offers mana- and creature-advantage support: she can untap a creature and a land, and can dig for creatures or lands from the top four cards of the library. She is part of the set of Zendikari who tried to confront or contain Eldrazi threats and has a narrative presence on Zendikar during the invasion.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/drop-drop-2015-05-20", "https://magic.wizards.com/en/news/magic-story/home-waters-2015-09-30"], "source_titles": ["Drop for Drop", "Home Waters"]}, {"name": "Drana's Emissary", "image_url": "https://cards.scryfall.io/normal/front/9/9/99e82d47-9bbb-4bf9-a935-2c0b27b64a84.jpg?1783938180", "scryfall_url": "https://scryfall.com/card/bfz/210/dranas-emissary?utm_source=api", "types": ["Creature"], "color_identity": ["W", "B"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.092, "total": 0.929}, "reason": "Drana's Emissary is a small recurring life-drain engine: flying and an upkeep trigger that drains each opponent for 1 and gains controller 1 life. This represents the vampire forces mobilized on Zendikar that supported the defense.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/memories-blood-2015-09-16"], "source_titles": ["Memories of Blood"]}, {"name": "Drana, Liberator of Malakir", "image_url": "https://cards.scryfall.io/normal/front/0/8/0850b41d-3589-40cd-ae22-cc5b4ddee1c4.jpg?1783913874", "scryfall_url": "https://scryfall.com/card/lcc/193/drana-liberator-of-malakir?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.348, "total": 1.09}, "reason": "Drana is a combat-focused ally who buffs attacking creatures: flying and first strike, and whenever she deals combat damage to a player she puts a +1/+1 counter on each attacking creature the controller controls. This suits frontline Vampire forces that lured and fought Eldrazi attackers.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/memories-blood-2015-09-16"], "source_titles": ["Memories of Blood"]}, {"name": "Ulamog's Reclaimer", "image_url": "https://cards.scryfall.io/normal/front/2/9/29a237a6-0e72-47ce-b28d-a0260963f406.jpg?1783938210", "scryfall_url": "https://scryfall.com/card/bfz/68/ulamogs-reclaimer?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.343, "total": 0.979}, "reason": "Mechanically, Ulamog's Reclaimer interacts with exile to recur value: when it enters, it may move a card an opponent owns from exile to their graveyard and, if it does, return an instant or sorcery from the controller's graveyard to their hand. This represents tools to exploit Eldrazi-exile interactions and recover answers during the campaign.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 1, "title": "Eldrazi and their agents", "explanation": "These cards form the invading Eldrazi force and cards that manipulate or awaken those titans. Mechanics include annihilator effects, Scion/Spawn token generation, exile/manipulation of cards, and effects that punish opponents \u2014 matching the destructive role of Eldrazi in the story and Ob Nixilis's role in reigniting and collapsing hedron defenses.", "cards": [{"name": "Ulamog, the Ceaseless Hunger", "image_url": "https://cards.scryfall.io/normal/front/c/7/c74ae706-b3b3-4097-a387-6f6c38a9b603.jpg?1783915730", "scryfall_url": "https://scryfall.com/card/cmm/5/ulamog-the-ceaseless-hunger?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.626, "total": 1.145}, "reason": "Ulamog is the Eldrazi titan centerpiece: when cast it exiles two target permanents, is indestructible, and whenever it attacks the defending player exiles the top twenty cards of their library. In the story Ulamog moved toward and consumed Zendikar's life and mana and was the target of the hedron trap assembled at Sea Gate.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/believers-pilgrimage-2015-09-02", "https://magic.wizards.com/en/news/magic-story/hedron-alignment-2015-11-18"], "source_titles": ["The Believers' Pilgrimage", "Hedron Alignment"]}, {"name": "Eldrazi Skyspawner", "image_url": "https://cards.scryfall.io/normal/front/9/c/9c9c1a10-446e-492a-95cc-a459dc6c08a0.jpg?1783938213", "scryfall_url": "https://scryfall.com/card/bfz/58/eldrazi-skyspawner?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.612, "total": 0.633}, "reason": "Eldrazi Skyspawner is an evasive Eldrazi that creates an Eldrazi Scion token on entry; the Scion can be sacrificed for colorless mana. This models the Eldrazi's ability to flood the battlefield with expendable spawn to fuel larger threats.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/home-waters-2015-09-30"], "source_titles": ["Home Waters"]}, {"name": "Eldrazi Devastator", "image_url": "https://cards.scryfall.io/normal/front/0/4/04b13e32-01b9-4a86-a3df-ca8b784c6a6c.jpg?1783938225", "scryfall_url": "https://scryfall.com/card/bfz/7/eldrazi-devastator?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.0, "total": 0.511}, "reason": "Eldrazi Devastator is a large trample Eldrazi that presses damage and board presence, representative of the massive destructive creatures that overran Sea Gate and threatened Zendikar's regions.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/limits-2015-07-15", "https://magic.wizards.com/en/news/magic-story/home-waters-2015-09-30"], "source_titles": ["Limits", "Home Waters"]}, {"name": "Ulamog's Despoiler", "image_url": "https://cards.scryfall.io/normal/front/5/5/55b6b7f0-d7fc-46b6-99ff-ba8206ecd628.jpg?1783938222", "scryfall_url": "https://scryfall.com/card/bfz/16/ulamogs-despoiler?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.443, "total": 0.999}, "reason": "Ulamog's Despoiler has an enter-the-battlefield clause that lets an opponent return two cards they own from exile to their graveyard to make this creature enter with four +1/+1 counters. It represents processors that manipulate exile and grow Eldrazi presence on the battlefield.", "source_urls": [], "source_titles": []}, {"name": "Ulamog's Reclaimer", "image_url": "https://cards.scryfall.io/normal/front/2/9/29a237a6-0e72-47ce-b28d-a0260963f406.jpg?1783938210", "scryfall_url": "https://scryfall.com/card/bfz/68/ulamogs-reclaimer?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.343, "total": 0.979}, "reason": "Ulamog's Reclaimer (included here for its Eldrazi Processor identity) can put an opponent's exiled card into their graveyard and return an instant or sorcery from the controller's graveyard to hand, reflecting the Eldrazi's disruptive interactions with exile and resource denial.", "source_urls": [], "source_titles": []}, {"name": "Ob Nixilis Reignited", "image_url": "https://cards.scryfall.io/normal/front/5/a/5af237ad-9294-47f5-a338-f9ca4fce3e70.jpg?1783909616", "scryfall_url": "https://scryfall.com/card/dsc/152/ob-nixilis-reignited?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.263, "total": 0.963}, "reason": "Ob Nixilis is a damaged-but-dangerous planeswalker who reignited his spark and took actions that directly caused the hedron network to collapse and awakened an Eldrazi titan. His card offers card draw at a life cost, creature removal, and a game-altering emblem \u2014 matching his destructive role in the story.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/any-cost-2015-11-25", "https://magic.wizards.com/en/news/magic-story/catching-2015-07-22"], "source_titles": ["At Any Cost", "Catching Up"]}]}

event: done
data: {"chips": ["Story: Battle for Zendikar", "Plane: Zendikar", "Card type: Eldrazi"], "intro": "Recommendations split into Zendikar's defenders and the Eldrazi/agents that threaten Zendikar. Each group's reasoning ties cards' mechanical roles to their roles in the Battle for Zendikar storyline.", "groups": [{"title": "Zendikar's defenders", "explanation": "These cards represent the Planeswalker-led and native forces that fought to stop the Eldrazi onslaught and to trap or hold back the Eldrazi titans. Mechanics shown include token generation and creature support, battlefield defense, and graveyard/resource advantage to sustain repeated defenses.", "cards": [{"name": "Gideon, Ally of Zendikar", "image_url": "https://cards.scryfall.io/normal/front/1/8/187e887c-c39d-4d25-a506-cdc95fc70316.jpg?1783938219", "scryfall_url": "https://scryfall.com/card/bfz/29/gideon-ally-of-zendikar?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.882, "synergy": 0.0, "similarity": 0.247, "total": 0.597}, "reason": "Gideon provides battlefield defense and creature production: he can become a 5/5 indestructible attacker/defender for a turn, make 2/2 Knight Ally tokens, and grant a global +1/+1 emblem. Storywise, Gideon organized the trap and helped hold back Ulamog while the hedron network was assembled, making him central to Zendikar's defense efforts.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/catching-2015-07-22", "https://magic.wizards.com/en/news/magic-story/hedron-alignment-2015-11-18"], "source_titles": ["Catching Up", "Hedron Alignment"]}, {"name": "Kiora, Master of the Depths", "image_url": "https://cards.scryfall.io/normal/front/4/b/4b63c228-3265-4029-9bc0-36b3e31dfb53.jpg?1783938179", "scryfall_url": "https://scryfall.com/card/bfz/213/kiora-master-of-the-depths?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "G"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.286, "total": 1.077}, "reason": "Kiora offers mana- and creature-advantage support: she can untap a creature and a land, and can dig for creatures or lands from the top four cards of the library. She is part of the set of Zendikari who tried to confront or contain Eldrazi threats and has a narrative presence on Zendikar during the invasion.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/drop-drop-2015-05-20", "https://magic.wizards.com/en/news/magic-story/home-waters-2015-09-30"], "source_titles": ["Drop for Drop", "Home Waters"]}, {"name": "Drana's Emissary", "image_url": "https://cards.scryfall.io/normal/front/9/9/99e82d47-9bbb-4bf9-a935-2c0b27b64a84.jpg?1783938180", "scryfall_url": "https://scryfall.com/card/bfz/210/dranas-emissary?utm_source=api", "types": ["Creature"], "color_identity": ["W", "B"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.092, "total": 0.929}, "reason": "Drana's Emissary is a small recurring life-drain engine: flying and an upkeep trigger that drains each opponent for 1 and gains controller 1 life. This represents the vampire forces mobilized on Zendikar that supported the defense.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/memories-blood-2015-09-16"], "source_titles": ["Memories of Blood"]}, {"name": "Drana, Liberator of Malakir", "image_url": "https://cards.scryfall.io/normal/front/0/8/0850b41d-3589-40cd-ae22-cc5b4ddee1c4.jpg?1783913874", "scryfall_url": "https://scryfall.com/card/lcc/193/drana-liberator-of-malakir?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.348, "total": 1.09}, "reason": "Drana is a combat-focused ally who buffs attacking creatures: flying and first strike, and whenever she deals combat damage to a player she puts a +1/+1 counter on each attacking creature the controller controls. This suits frontline Vampire forces that lured and fought Eldrazi attackers.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/memories-blood-2015-09-16"], "source_titles": ["Memories of Blood"]}, {"name": "Ulamog's Reclaimer", "image_url": "https://cards.scryfall.io/normal/front/2/9/29a237a6-0e72-47ce-b28d-a0260963f406.jpg?1783938210", "scryfall_url": "https://scryfall.com/card/bfz/68/ulamogs-reclaimer?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.343, "total": 0.979}, "reason": "Mechanically, Ulamog's Reclaimer interacts with exile to recur value: when it enters, it may move a card an opponent owns from exile to their graveyard and, if it does, return an instant or sorcery from the controller's graveyard to their hand. This represents tools to exploit Eldrazi-exile interactions and recover answers during the campaign.", "source_urls": [], "source_titles": []}]}, {"title": "Eldrazi and their agents", "explanation": "These cards form the invading Eldrazi force and cards that manipulate or awaken those titans. Mechanics include annihilator effects, Scion/Spawn token generation, exile/manipulation of cards, and effects that punish opponents \u2014 matching the destructive role of Eldrazi in the story and Ob Nixilis's role in reigniting and collapsing hedron defenses.", "cards": [{"name": "Ulamog, the Ceaseless Hunger", "image_url": "https://cards.scryfall.io/normal/front/c/7/c74ae706-b3b3-4097-a387-6f6c38a9b603.jpg?1783915730", "scryfall_url": "https://scryfall.com/card/cmm/5/ulamog-the-ceaseless-hunger?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.626, "total": 1.145}, "reason": "Ulamog is the Eldrazi titan centerpiece: when cast it exiles two target permanents, is indestructible, and whenever it attacks the defending player exiles the top twenty cards of their library. In the story Ulamog moved toward and consumed Zendikar's life and mana and was the target of the hedron trap assembled at Sea Gate.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/believers-pilgrimage-2015-09-02", "https://magic.wizards.com/en/news/magic-story/hedron-alignment-2015-11-18"], "source_titles": ["The Believers' Pilgrimage", "Hedron Alignment"]}, {"name": "Eldrazi Skyspawner", "image_url": "https://cards.scryfall.io/normal/front/9/c/9c9c1a10-446e-492a-95cc-a459dc6c08a0.jpg?1783938213", "scryfall_url": "https://scryfall.com/card/bfz/58/eldrazi-skyspawner?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.612, "total": 0.633}, "reason": "Eldrazi Skyspawner is an evasive Eldrazi that creates an Eldrazi Scion token on entry; the Scion can be sacrificed for colorless mana. This models the Eldrazi's ability to flood the battlefield with expendable spawn to fuel larger threats.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/home-waters-2015-09-30"], "source_titles": ["Home Waters"]}, {"name": "Eldrazi Devastator", "image_url": "https://cards.scryfall.io/normal/front/0/4/04b13e32-01b9-4a86-a3df-ca8b784c6a6c.jpg?1783938225", "scryfall_url": "https://scryfall.com/card/bfz/7/eldrazi-devastator?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.0, "total": 0.511}, "reason": "Eldrazi Devastator is a large trample Eldrazi that presses damage and board presence, representative of the massive destructive creatures that overran Sea Gate and threatened Zendikar's regions.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/limits-2015-07-15", "https://magic.wizards.com/en/news/magic-story/home-waters-2015-09-30"], "source_titles": ["Limits", "Home Waters"]}, {"name": "Ulamog's Despoiler", "image_url": "https://cards.scryfall.io/normal/front/5/5/55b6b7f0-d7fc-46b6-99ff-ba8206ecd628.jpg?1783938222", "scryfall_url": "https://scryfall.com/card/bfz/16/ulamogs-despoiler?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.443, "total": 0.999}, "reason": "Ulamog's Despoiler has an enter-the-battlefield clause that lets an opponent return two cards they own from exile to their graveyard to make this creature enter with four +1/+1 counters. It represents processors that manipulate exile and grow Eldrazi presence on the battlefield.", "source_urls": [], "source_titles": []}, {"name": "Ulamog's Reclaimer", "image_url": "https://cards.scryfall.io/normal/front/2/9/29a237a6-0e72-47ce-b28d-a0260963f406.jpg?1783938210", "scryfall_url": "https://scryfall.com/card/bfz/68/ulamogs-reclaimer?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.343, "total": 0.979}, "reason": "Ulamog's Reclaimer (included here for its Eldrazi Processor identity) can put an opponent's exiled card into their graveyard and return an instant or sorcery from the controller's graveyard to hand, reflecting the Eldrazi's disruptive interactions with exile and resource denial.", "source_urls": [], "source_titles": []}, {"name": "Ob Nixilis Reignited", "image_url": "https://cards.scryfall.io/normal/front/5/a/5af237ad-9294-47f5-a338-f9ca4fce3e70.jpg?1783909616", "scryfall_url": "https://scryfall.com/card/dsc/152/ob-nixilis-reignited?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.263, "total": 0.963}, "reason": "Ob Nixilis is a damaged-but-dangerous planeswalker who reignited his spark and took actions that directly caused the hedron network to collapse and awakened an Eldrazi titan. His card offers card draw at a life cost, creature removal, and a game-altering emblem \u2014 matching his destructive role in the story.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/any-cost-2015-11-25", "https://magic.wizards.com/en/news/magic-story/catching-2015-07-22"], "source_titles": ["At Any Cost", "Catching Up"]}]}]}

