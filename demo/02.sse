data: {"index": 1, "title": "Nicol Bolas and His Assets", "explanation": "These cards represent Nicol Bolas himself and related manifestations of his power or prior incarnations; the story places Bolas and his controlled Dreadhorde/Eternals as the main antagonistic force.", "cards": [{"name": "Nicol Bolas, Dragon-God", "image_url": "https://cards.scryfall.io/normal/front/c/5/c5408607-af8f-48fe-bc40-32828d1976de.jpg?1783913282", "scryfall_url": "https://scryfall.com/card/rvr/205/nicol-bolas-dragon-god?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.672, "total": 1.154}, "reason": "Nicol Bolas is the central antagonist of the War of the Spark campaign; this printing has Bolas inherit the loyalty abilities of other planeswalkers on the battlefield and includes removal, exile/ransoming effects, and card-draw control that fit his domineering role.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-ashes-2019-06-12"], "source_titles": ["War of the Spark: Ravnica\u2014Ashes"]}, {"name": "Nicol Bolas, the Ravager // Nicol Bolas, the Arisen", "image_url": "https://cards.scryfall.io/normal/front/7/b/7b215968-93a6-4278-ac61-4e3e8c3c3943.jpg?1783934524", "scryfall_url": "https://scryfall.com/card/m19/218/nicol-bolas-the-ravager-nicol-bolas-the-arisen?utm_source=api", "types": ["Creature", "Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.762, "similarity": 0.517, "total": 0.793}, "reason": "This double-faced card represents an earlier form of Bolas who enters by forcing opponents to discard and can transform into a planeswalker with powerful draw and removal loyalty abilities, reflecting Bolas's battlefield entrance and escalation.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-ashes-2019-06-12"], "source_titles": ["War of the Spark: Ravnica\u2014Ashes"]}, {"name": "Nicol Bolas, God-Pharaoh", "image_url": "https://cards.scryfall.io/normal/front/5/9/597ca22d-2f08-47b3-9d93-c4d685cefb5f.jpg?1783921810", "scryfall_url": "https://scryfall.com/card/2x2/260/nicol-bolas-god-pharaoh?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.961, "similarity": 0.667, "total": 0.899}, "reason": "An earlier God-Pharaoh incarnation of Bolas that punishes opponents by letting the controller cast exiled cards and forces opponent hand disruption, thematically consistent with Bolas's manipulative domination.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-path-opulent-2019-05-15", "https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-ashes-2019-06-12"], "source_titles": ["War of the Spark: Ravnica \u2013 The Path to Opulent", "War of the Spark: Ravnica\u2014Ashes"]}, {"name": "Nicol Bolas, Planeswalker", "image_url": "https://cards.scryfall.io/normal/front/9/e/9e80f2fc-06d4-4ce9-b23b-3e4af1208fa5.jpg?1783936137", "scryfall_url": "https://scryfall.com/card/e01/85/nicol-bolas-planeswalker?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 1.0, "similarity": 0.544, "total": 0.889}, "reason": "A classic Bolas planeswalker printing with large-scale destructive loyalty abilities, representing Bolas's established capacity for wide-reaching devastation and control.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-ashes-2019-06-12"], "source_titles": ["War of the Spark: Ravnica\u2014Ashes"]}, {"name": "Vraska, Swarm's Eminence", "image_url": "https://cards.scryfall.io/normal/front/5/9/59ee2974-07e9-4506-903c-457cb7327dd8.jpg?1783933375", "scryfall_url": "https://scryfall.com/card/war/236/vraska-swarms-eminence?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B", "G"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.474, "total": 1.115}, "reason": "Vraska acted antagonistically toward the Eternals in parts of the story but is included here to represent the Golgari's lethal, assassination-style tools that Bolas's forces and counterforces both interacted with; mechanically, this Vraska produces deathtouch tokens that can threaten planeswalkers.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-desperate-operatives-2019-05-29"], "source_titles": ["War of the Spark: Ravnica\u2014Desperate Operatives"]}, {"name": "Attendant of Vraska", "image_url": "https://cards.scryfall.io/normal/front/7/f/7f4840f1-3db3-4ba6-b75b-bbd87251a3af.jpg?1783934093", "scryfall_url": "https://scryfall.com/card/grn/271/attendant-of-vraska?utm_source=api", "types": ["Creature"], "color_identity": ["B", "G"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.229, "total": 0.956}, "reason": "This creature has a synergy with Vraska planeswalkers, providing life gain on death if a Vraska is present, representing Golgari loyalty ties and battlefield persistence.", "source_urls": [], "source_titles": []}, {"name": "Vraska, Relic Seeker", "image_url": "https://cards.scryfall.io/normal/front/9/6/967b7272-33a6-46e9-b0aa-4757aee54b3a.jpg?1783935707", "scryfall_url": "https://scryfall.com/card/xln/232/vraska-relic-seeker?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B", "G"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.471, "similarity": 0.377, "total": 0.654}, "reason": "A later Golgari Vraska who can destroy artifacts, creatures, or enchantments and generate Treasure tokens\u2014useful as a source of removal and ramping treasure that fits a Bolas-supporting or control-oriented board plan.", "source_urls": [], "source_titles": []}]}

