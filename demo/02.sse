data: {"cards": [{"name": "Nicol Bolas, Dragon-God", "image_url": "https://cards.scryfall.io/normal/front/c/5/c5408607-af8f-48fe-bc40-32828d1976de.jpg?1783913282", "scryfall_url": "https://scryfall.com/card/rvr/205/nicol-bolas-dragon-god?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.672, "total": 1.154}}, {"name": "Niv-Mizzet, Parun", "image_url": "https://cards.scryfall.io/normal/front/8/6/86c5c337-d25f-4c3e-9762-09ed0c2d36d7.jpg?1783911897", "scryfall_url": "https://scryfall.com/card/otc/235/niv-mizzet-parun?utm_source=api", "types": ["Creature"], "color_identity": ["U", "R"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.596, "total": 1.139}}, {"name": "Vraska, Golgari Queen", "image_url": "https://cards.scryfall.io/normal/front/a/3/a36d3ea7-0f18-4865-b47b-755673db065e.jpg?1783934118", "scryfall_url": "https://scryfall.com/card/grn/213/vraska-golgari-queen?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B", "G"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.512, "total": 1.122}}, {"name": "Vraska, Swarm's Eminence", "image_url": "https://cards.scryfall.io/normal/front/5/9/59ee2974-07e9-4506-903c-457cb7327dd8.jpg?1783933375", "scryfall_url": "https://scryfall.com/card/war/236/vraska-swarms-eminence?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B", "G"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.474, "total": 1.115}}, {"name": "Kaya, Bane of the Dead", "image_url": "https://cards.scryfall.io/normal/front/a/9/a9b575d3-f3f9-4ff4-8e5c-da7c2ec69882.jpg?1783933378", "scryfall_url": "https://scryfall.com/card/war/231/kaya-bane-of-the-dead?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W", "B"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.352, "total": 1.09}}, {"name": "Niv-M