data: {"cards": [{"name": "Ulamog, the Ceaseless Hunger", "image_url": "https://cards.scryfall.io/normal/front/c/7/c74ae706-b3b3-4097-a387-6f6c38a9b603.jpg?1783915730", "scryfall_url": "https://scryfall.com/card/cmm/5/ulamog-the-ceaseless-hunger?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.626, "total": 1.145}}, {"name": "Drana, Liberator of Malakir", "image_url": "https://cards.scryfall.io/normal/front/0/8/0850b41d-3589-40cd-ae22-cc5b4ddee1c4.jpg?1783913874", "scryfall_url": "https://scryfall.com/card/lcc/193/drana-liberator-of-malakir?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.348, "total": 1.09}}, {"name": "Kiora, Master of the Depths", "image_url": "https://cards.scryfall.io/normal/front/4/b/4b63c228-3265-4029-9bc0-36b3e31dfb53.jpg?1783938179", "scryfall_url": "https://scryfall.com/card/bfz/213/kiora-master-of-the-depths?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "G"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.286, "total": 1.077}}, {"name": "Ulamog's Despoiler", "image_url": "https://cards.scryfall.io/normal/front/5/5/55b6b7f0-d7fc-46b6-99ff-ba8206ecd628.jpg?1783938222", "scryfall_url": "https://scryfall.com/card/bfz/16/ulamogs-despoiler?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.443, "total": 0.999}}, {"name": "Ulamog's Nullifier", "image_url": "https://cards.scryfall.io/normal/front/a/c/acd482ad-ca4a-470f-8a76-14ec7b58316a.jpg?1783938181", "scryfall_url": "https://scryfall.com/card/bfz/207/ulamogs-nullifier?utm_source=api", "types": ["Creature"], "color_identity": ["U", "B"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.416, "total": 0.994}}, {"name": "Ulamog's Reclaimer"