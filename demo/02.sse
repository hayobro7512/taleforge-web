event: explanation
data: {"index": 0, "title": "The Resistance (planeswalkers and allies who fought Bolas)", "explanation": "These cards represent planeswalkers and allies who arrived to resist Nicol Bolas on Ravnica or otherwise participated in efforts against the Eternals and Bolas's forces during the War of the Spark.", "cards": [{"name": "Gideon, the Oathsworn", "image_url": "https://cards.scryfall.io/normal/front/4/3/43e7331d-98b8-420f-a346-3f3521c3b258.jpg?1783933361", "scryfall_url": "https://scryfall.com/card/war/265/gideon-the-oathsworn?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.882, "synergy": 0.0, "similarity": 0.395, "total": 0.626}, "reason": "Gideon led a frontline effort against Bolas's forces and performed direct sacrifice-level heroics in the story; in game terms, Gideon becomes a 5/5 attacker and can protect himself while bolstering other attackers.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-ashes-2019-06-12", "https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-old-friends-and-new-2019-05-08"], "source_titles": ["War of the Spark: Ravnica\u2014Ashes", "War of the Spark: Ravnica\u2014Old Friends and New"]}, {"name": "Jace, Wielder of Mysteries", "image_url": "https://cards.scryfall.io/normal/front/6/a/6adb7d73-4482-4930-8497-cffd169b57e2.jpg?1783933463", "scryfall_url": "https://scryfall.com/card/war/54/jace-wielder-of-mysteries?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["lore", "synergy"], "scores": {"story": 0.882, "synergy": 0.073, "similarity": 0.31, "total": 0.637}, "reason": "Jace appears among the planeswalkers who rallied against the Eternals; this Jace provides an alternate win condition tied to an empty library and also mills and draws to advance that plan.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-old-friends-and-new-2019-05-08"], "source_titles": ["War of the Spark: Ravnica\u2014Old Friends and New"]}, {"name": "Jace, Arcane Strategist", "image_url": "https://cards.scryfall.io/normal/front/b/6/b6a857fb-159f-40c4-8988-da91d8521a60.jpg?1783933359", "scryfall_url": "https://scryfall.com/card/war/270/jace-arcane-strategist?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.882, "synergy": 0.0, "similarity": 0.339, "total": 0.615}, "reason": "Another Jace from the War of the Spark era who supports drawing and rewards additional draws with creature growth, fitting a strategy that leverages card draw and planeswalker support.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-old-friends-and-new-2019-05-08"], "source_titles": ["War of the Spark: Ravnica\u2014Old Friends and New"]}, {"name": "Ral, Storm Conduit", "image_url": "https://cards.scryfall.io/normal/front/6/7/678ce3bf-152d-45ca-87ae-ad46c921328b.jpg?1783933390", "scryfall_url": "https://scryfall.com/card/war/211/ral-storm-conduit?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 0.882, "synergy": 0.644, "similarity": 0.559, "total": 0.904}, "reason": "Ral was involved in operative-style actions on Ravnica and here punishes casting instants and sorceries by dealing direct damage, while also offering spell-copying utility to escalate a control/tempo plan.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-desperate-operatives-2019-05-29"], "source_titles": ["War of the Spark: Ravnica\u2014Desperate Operatives"]}, {"name": "Ral Zarek", "image_url": "https://cards.scryfall.io/normal/front/3/b/3bdd2b4b-5ba3-4984-8d48-c4c1d75dd177.jpg?1783913277", "scryfall_url": "https://scryfall.com/card/rvr/216/ral-zarek?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.37, "similarity": 0.45, "total": 0.631}, "reason": "Ral appears among the group that took action against the Eternals; this older Ral provides tapped/untap utility and a powerful ultimate that can grant extra turns.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-old-friends-and-new-2019-05-08"], "source_titles": ["War of the Spark: Ravnica\u2014Old Friends and New"]}, {"name": "Niv-Mizzet Reborn", "image_url": "https://cards.scryfall.io/normal/front/5/6/56a2609d-b535-400b-81d9-72989a33c70f.jpg?1783933391", "scryfall_url": "https://scryfall.com/card/war/208/niv-mizzet-reborn?utm_source=api", "types": ["Creature"], "color_identity": ["W", "U", "B", "R", "G"], "evidence": ["lore"], "scores": {"story": 0.941, "synergy": 0.0, "similarity": 0.516, "total": 1.087}, "reason": "Niv-Mizzet was reborn during the War of the Spark events and aided in striking at Bolas; this card represents that rebirth and provides a strong multi-color card-selection effect on entry.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-operation-desperation-2019-06-05", "https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-ashes-2019-06-12"], "source_titles": ["War of the Spark: Ravnica\u2014Operation Desperation", "War of the Spark: Ravnica\u2014Ashes"]}, {"name": "Niv-Mizzet, the Firemind", "image_url": "https://cards.scryfall.io/normal/front/3/9/395465b8-f5ed-4668-9e6a-82257150c52c.jpg?1783931145", "scryfall_url": "https://scryfall.com/card/c20/225/niv-mizzet-the-firemind?utm_source=api", "types": ["Creature"], "color_identity": ["U", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.695, "similarity": 0.444, "total": 0.753}, "reason": "Niv-Mizzet historically figures into the conflict around the Firemind concept and supports a draw-damage synergy and a tap-to-draw ability useful in a spell-focused deck.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-operation-desperation-2019-06-05"], "source_titles": ["War of the Spark: Ravnica\u2014Operation Desperation"]}, {"name": "Kaya, Bane of the Dead", "image_url": "https://cards.scryfall.io/normal/front/a/9/a9b575d3-f3f9-4ff4-8e5c-da7c2ec69882.jpg?1783933378", "scryfall_url": "https://scryfall.com/card/war/231/kaya-bane-of-the-dead?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W", "B"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.352, "total": 1.09}, "reason": "Kaya fought Eternals and was tasked by others during the war; mechanically she allows targeting hexproof permanents and provides exile removal, reflecting her role as an operative against difficult threats.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-old-friends-and-new-2019-05-08", "https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-desperate-operatives-2019-05-29"], "source_titles": ["War of the Spark: Ravnica\u2014Old Friends and New", "War of the Spark: Ravnica\u2014Desperate Operatives"]}, {"name": "Oath of Kaya", "image_url": "https://cards.scryfall.io/normal/front/f/a/faba010d-5b1b-4562-91d6-ec55303c4dcd.jpg?1783933391", "scryfall_url": "https://scryfall.com/card/war/209/oath-of-kaya?utm_source=api", "types": ["Enchantment"], "color_identity": ["W", "B"], "evidence": ["lore"], "scores": {"story": 0.941, "synergy": 0.0, "similarity": 0.343, "total": 1.052}, "reason": "An enchantment tied to Kaya thematically that punishes attacks on planeswalkers and provides small removal plus life gain\u2014useful for protecting the resisting planeswalkers.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-old-friends-and-new-2019-05-08"], "source_titles": ["War of the Spark: Ravnica\u2014Old Friends and New"]}, {"name": "Vraska's Finisher", "image_url": "https://cards.scryfall.io/normal/front/f/8/f89fa379-7fae-4fbf-8e31-0ef3645353c5.jpg?1783933435", "scryfall_url": "https://scryfall.com/card/war/112/vraskas-finisher?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.419, "total": 0.994}, "reason": "Vraska's forces acted against the Eternals; this two-mana assassin lets the side cleanly finish off damaged opposing creatures or planeswalkers, representing surgical strikes in play.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-desperate-operatives-2019-05-29"], "source_titles": ["War of the Spark: Ravnica\u2014Desperate Operatives"]}]}

