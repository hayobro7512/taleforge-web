event: explanation
data: {"index": 0, "title": "Teferi \u2014 Time engines and planeswalker synergies", "explanation": "This group centers on Teferi planeswalkers and cards that amplify their loyalty use, card advantage, and extra-turn/tempo abilities. Use these to generate repeated value from loyalty activations, draw chains, and eventual game-ending emblems or extra turns.", "cards": [{"name": "Teferi, Master of Time", "image_url": "https://cards.scryfall.io/normal/front/9/c/9c0c61e3-9f3d-4e7f-9046-0ea336dd8a2d.jpg?1783930718", "scryfall_url": "https://scryfall.com/card/m21/75/teferi-master-of-time?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.749, "similarity": 0.93, "total": 1.49}, "reason": "Lets loyalty abilities be used on any player's turn and provides a repeatable card-selection engine (+1 draw/discard) plus a -3 that phases out an opposing creature. It supports reactive plays and tempo by enabling instant-speed loyalty play and temporary removal.", "source_urls": [], "source_titles": []}, {"name": "Teferi, Hero of Dominaria", "image_url": "https://cards.scryfall.io/normal/front/5/d/5d10b752-d9cb-419d-a5c4-d4ee1acb655e.jpg?1783934963", "scryfall_url": "https://scryfall.com/card/dom/207/teferi-hero-of-dominaria?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W", "U"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.749, "similarity": 0.507, "total": 1.406}, "reason": "+1 draws and sets up an untap/tempo boost at end step, \u22123 provides tuck into library (soft removal), and the \u22128 emblem turns card draw into recurring exile of opponent permanents; pairs well with repeated draw engines and Oath/Talent effects.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/return-dominaria-episode-6-2018-04-18"], "source_titles": ["Return to Dominaria: Episode 6"]}, {"name": "Teferi, Time Raveler", "image_url": "https://cards.scryfall.io/normal/front/6/6/662fe50f-d75c-422c-8c6c-1f9b5c4ba21f.jpg?1783913271", "scryfall_url": "https://scryfall.com/card/rvr/232/teferi-time-raveler?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W", "U"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.661, "similarity": 0.503, "total": 1.372}, "reason": "Shuts opponents down by restricting when they can cast spells, grants flash-casting of sorceries until your next turn with +1, and has a bounce \u22123 that also draws a card; an excellent tempo anchor in a Teferi deck.", "source_urls": [], "source_titles": []}, {"name": "Teferi, Timebender", "image_url": "https://cards.scryfall.io/normal/front/e/b/eb2b7388-ac6b-45c0-a5cc-da6450724b59.jpg?1783934938", "scryfall_url": "https://scryfall.com/card/dom/270/teferi-timebender?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W", "U"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.446, "total": 1.109}, "reason": "Provides incremental tempo via +2 untaps, card advantage with \u22123, and a powerful \u22129 extra turn. Works as the big finisher in a deck built to protect and reuse loyalty activations.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-5-whisper-wind-2022-08-18"], "source_titles": ["Episode 5: A Whisper in the Wind"]}, {"name": "Teferi, Timeless Voyager", "image_url": "https://cards.scryfall.io/normal/front/6/2/62d05287-ad7f-4de8-9f68-8f36c62fae72.jpg?1783930622", "scryfall_url": "https://scryfall.com/card/m21/324/teferi-timeless-voyager?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.479, "total": 1.116}, "reason": "+1 draws, \u22123 top-decking removal, and a \u22128 that phases out every creature an opponent controls and prevents them from phasing in until after the next turn; strong mass-tempo and locking capability when combined with additional phasing effects.", "source_urls": [], "source_titles": []}, {"name": "Teferi, Temporal Archmage", "image_url": "https://cards.scryfall.io/normal/front/3/6/368c6e60-804c-447c-bc2b-ac9dc4cab5e7.jpg?1783915687", "scryfall_url": "https://scryfall.com/card/cmm/125/teferi-temporal-archmage?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 1.0, "similarity": 0.99, "total": 0.978}, "reason": "+1 filters top cards into hand, \u22121 untaps up to four permanents (synergizes with activated loyalty or mana), and a \u221210 emblem granting instant-speed loyalty activations for planeswalkers \u2014 perfect for enabling repeated responses.", "source_urls": [], "source_titles": []}, {"name": "Teferi's Talent", "image_url": "https://cards.scryfall.io/normal/front/5/6/56f642ae-68f3-4eeb-8b3f-a9fe1596231d.jpg?1783917250", "scryfall_url": "https://scryfall.com/card/moc/74/teferis-talent?utm_source=api", "types": ["Enchantment"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.45, "total": 0.49}, "reason": "An aura that enchants a planeswalker to passively gain loyalty counters on draws and grants a \u221212 emblem that lets its controller activate planeswalker loyalties on any player's turn; pairs directly with the planeswalker suite for more activations.", "source_urls": [], "source_titles": []}, {"name": "Oath of Teferi", "image_url": "https://cards.scryfall.io/normal/front/f/7/f7474f9e-a994-4ed7-83df-22edd8219e24.jpg?1783915413", "scryfall_url": "https://scryfall.com/card/cmm/934/oath-of-teferi?utm_source=api", "types": ["Enchantment"], "color_identity": ["W", "U"], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.983, "similarity": 0.81, "total": 1.446}, "reason": "When it enters, it temporarily exiles another permanent to return it at end step (useful for reusing ETB or protecting threats) and lets planeswalker loyalty abilities be activated twice each turn, directly increasing planeswalker output.", "source_urls": [], "source_titles": []}, {"name": "Niambi, Faithful Healer", "image_url": "https://cards.scryfall.io/normal/front/c/6/c638677c-2b92-4d0c-b61c-598b5a843844.jpg?1783934937", "scryfall_url": "https://scryfall.com/card/dom/272/niambi-faithful-healer?utm_source=api", "types": ["Creature"], "color_identity": ["W", "U"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.919, "total": 0.549}, "reason": "Provides a tutor-style effect on entry that can find Teferi, Timebender from library or graveyard, helping to assemble the key planeswalker finisher.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-5-whisper-wind-2022-08-18"], "source_titles": ["Episode 5: A Whisper in the Wind"]}, {"name": "Historian of Zhalfir", "image_url": "https://cards.scryfall.io/normal/front/a/e/ae981da0-f32c-49d5-bcb0-2b9255a4e1fe.jpg?1783930621", "scryfall_url": "https://scryfall.com/card/m21/325/historian-of-zhalfir?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 1.0, "total": 0.565}, "reason": "Attacks-trigger draw synergy tied to controlling a Teferi planeswalker, converting a creature's attack step into card advantage when the planeswalker suite is active.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 1, "title": "Phasing, protection, and time-control support", "explanation": "These cards create phasing or temporary exile effects, protect the board during time-warping plays, or repeatedly blink/recur permanents for value. They enable safe loyalty stacking, recur key permanents, and disrupt opponents by removing or phasing their threats.", "cards": [{"name": "Teferi's Protection", "image_url": "https://cards.scryfall.io/normal/front/4/8/483fa1cb-1e35-44f2-a143-98c0f107f5ca.jpg?1783921926", "scryfall_url": "https://scryfall.com/card/2x2/32/teferis-protection?utm_source=api", "types": ["Instant"], "color_identity": ["W"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.326, "similarity": 0.564, "total": 0.637}, "reason": "A one-sided ultimate defensive instant: it guarantees life total immutability and grants protection from everything until your next turn while phasing out all your permanents (they return before your next untap); excellent for weathering a boardwipe or securing a planeswalker sequence.", "source_urls": [], "source_titles": []}, {"name": "Teferi's Time Twist", "image_url": "https://cards.scryfall.io/normal/front/c/8/c878bdc0-d697-4a2f-bba5-758b27f4247a.jpg?1783933453", "scryfall_url": "https://scryfall.com/card/war/72/teferis-time-twist?utm_source=api", "types": ["Instant"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.325, "total": 0.976}, "reason": "Exiles a controlled permanent and returns it at the next end step, effectively blinking an artifact/creature/enchantment to reuse ETB effects or protect a permanent through dangerous phases.", "source_urls": [], "source_titles": []}, {"name": "Teferi's Isle", "image_url": "https://cards.scryfall.io/normal/front/b/6/b6ed7ca8-fd91-46e3-9149-a3de23c7078e.jpg?1783947034", "scryfall_url": "https://scryfall.com/card/mir/330/teferis-isle?utm_source=api", "types": ["Land"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.767, "total": 0.553}, "reason": "A legendary land with inherent phasing that phases in and out during untap steps and taps for {U}{U}; it supports the deck's phasing theme and provides ramp while occasionally disappearing to protect itself.", "source_urls": [], "source_titles": []}, {"name": "Teferi's Realm", "image_url": "https://cards.scryfall.io/normal/front/a/b/aba3e4ea-2241-4f1e-a46b-70f512fe729e.jpg?1783946997", "scryfall_url": "https://scryfall.com/card/vis/44/teferis-realm?utm_source=api", "types": ["Enchantment"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.419, "total": 0.484}, "reason": "World enchantment that cyclically causes all nontoken permanents of a chosen type to phase out at each upkeep; powerful board manipulation that can repeatedly deny classes of permanents and buy turns of safety.", "source_urls": [], "source_titles": []}, {"name": "Teferi's Curse", "image_url": "https://cards.scryfall.io/normal/front/f/b/fb813ef5-8441-4024-a585-1ea24145e1bd.jpg?1783947103", "scryfall_url": "https://scryfall.com/card/mir/96/teferis-curse?utm_source=api", "types": ["Enchantment"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.479, "total": 0.496}, "reason": "An aura that gives phasing to an artifact or creature, forcing it to cycle in and out; can be used defensively or to trigger phasing synergies.", "source_urls": [], "source_titles": []}, {"name": "Teferi's Imp", "image_url": "https://cards.scryfall.io/normal/front/0/4/048f2368-0e2f-4197-b977-353d38b38ccc.jpg?1783947101", "scryfall_url": "https://scryfall.com/card/mir/98/teferis-imp?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.494, "total": 0.499}, "reason": "A flying creature with phasing that draws on phase-in and makes its controller discard on phase-out; provides repeated small card selection and fits the phasing theme.", "source_urls": [], "source_titles": []}, {"name": "Teferi's Drake", "image_url": "https://cards.scryfall.io/normal/front/c/2/c24823df-5651-4578-a0c8-f9f52f66abe4.jpg?1783947102", "scryfall_url": "https://scryfall.com/card/mir/97/teferis-drake?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.447, "total": 0.489}, "reason": "A simple flying phasing creature that can serve as a repeating evasive threat while fitting the deck's recurring-phasing interactions.", "source_urls": [], "source_titles": []}, {"name": "Teferi's Reproach", "image_url": "https://cards.scryfall.io/normal/front/f/b/fb4a1f07-4c1f-4d08-af5d-17f1bb77f9e5.jpg?1789644215", "scryfall_url": "https://scryfall.com/card/frc/6/teferis-reproach?utm_source=api", "types": ["Instant"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.721, "total": 0.544}, "reason": "Targets an opponent to give them protection from everything and freeze their nonland permanents by phasing them out until their next turn; a disruptive, tempo-turning removal effect in a Teferi deck.", "source_urls": [], "source_titles": []}, {"name": "Teferi's Tutelage", "image_url": "https://cards.scryfall.io/normal/front/c/2/c26450d4-125f-423d-b074-3c959460c242.jpg?1783930718", "scryfall_url": "https://scryfall.com/card/m21/78/teferis-tutelage?utm_source=api", "types": ["Enchantment"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.592, "total": 1.029}, "reason": "Converts the frequent drawing that Teferi engines provide into a mill plan: draw/discard on entry and mill two whenever a card is drawn, fitting a strategy that turns repeated draw into an alternate win condition.", "source_urls": [], "source_titles": []}]}

