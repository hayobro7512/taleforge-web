data: {"cards": [{"name": "Teferi, Who Slows the Sunset", "image_url": "https://cards.scryfall.io/normal/front/a/d/ad2e18d4-986c-4a44-8f26-1b8689339cfb.jpg?1783925552", "scryfall_url": "https://scryfall.com/card/mid/245/teferi-who-slows-the-sunset?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W", "U"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.966, "similarity": 0.539, "total": 1.495}}, {"name": "Teferi, Master of Time", "image_url": "https://cards.scryfall.io/normal/front/9/c/9c0c61e3-9f3d-4e7f-9046-0ea336dd8a2d.jpg?1783930718", "scryfall_url": "https://scryfall.com/card/m21/75/teferi-master-of-time?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.749, "similarity": 0.93, "total": 1.49}}, {"name": "Teferi, Temporal Pilgrim", "image_url": "https://cards.scryfall.io/normal/front/2/3/23a4f1ec-eadf-4f1e-8821-f22293ad2580.jpg?1783920103", "scryfall_url": "https://scryfall.com/card/bro/66/teferi-temporal-pilgrim?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.599, "similarity": 0.993, "total": 1.446}}, {"name": "Oath of Teferi", "image_url": "https://cards.scryfall.io/normal/front/f/7/f7474f9e-a994-4ed7-83df-22edd8219e24.jpg?1783915413", "scryfall_url": "https://scryfall.com/card/cmm/934/oath-of-teferi?utm_source=api", "types": ["Enchantment"], "color_identity": ["W", "U"], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.983, "similarity": 0.81, "total": 1.446}}, {"name": "Teferi, Hero of Dominaria", "image_url": "https://cards.scryfall.io/normal/front/5/d/5d10b752-d9cb-419d-a5c4-d4ee1acb655e.jpg?1783934963", "scryfall_url": "https://scryfall.com/card/dom/207/teferi-hero-of-dominaria?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W", "U"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synerg