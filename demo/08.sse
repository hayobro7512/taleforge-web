data: {"cards": [{"name": "Ugin, the Spirit Dragon", "image_url": "https://cards.scryfall.io/normal/front/9/c/9c017fa9-7021-417a-9c2e-3df409644fcf.jpg?1783930748", "scryfall_url": "https://scryfall.com/card/m21/1/ugin-the-spirit-dragon?utm_source=api", "types": ["Planeswalker"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.799, "similarity": 1.0, "total": 1.524}}, {"name": "Eldrazi Mimic", "image_url": "https://cards.scryfall.io/normal/front/3/1/311a05b1-042d-47e7-9fd7-6e8abe8fc578.jpg?1783937930", "scryfall_url": "https://scryfall.com/card/ogw/2/eldrazi-mimic?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.767, "similarity": 0.284, "total": 1.259}}, {"name": "Eldrazi Displacer", "image_url": "https://cards.scryfall.io/normal/front/f/0/f0bb1a5c-0f59-4951-827f-fe9df968232d.jpg?1783937928", "scryfall_url": "https://scryfall.com/card/ogw/13/eldrazi-displacer?utm_source=api", "types": ["Creature"], "color_identity": ["W"], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.568, "similarity": 0.415, "total": 1.209}}, {"name": "Haven of the Spirit Dragon", "image_url": "https://cards.scryfall.io/normal/front/d/0/d0c552da-874e-49eb-b221-47220b8b7786.jpg?1783906982", "scryfall_url": "https://scryfall.com/card/tdc/370/haven-of-the-spirit-dragon?utm_source=api", "types": ["Land"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 1.0, "similarity": 0.75, "total": 1.041}}, {"name": "Eldrazi Skyspawner", "image_url": "https://cards.scryfall.io/normal/front/9/c/9c9c1a10-446e-492a-95cc-a459dc6c08a0.jpg?1783938213", "scryfall_url": "https://scryfall.com/card/bfz/58/eldrazi-skyspawner?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.572, "total": 1.025}}, {"name": "Ugin, Eye of the Storms",