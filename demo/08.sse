re"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.394, "total": 0.589}}, {"name": "Spirit of the Aldergard", "image_url": "https://cards.scryfall.io/normal/front/2/2/220df551-3820-4910-a206-14501ba02e69.jpg?1783928204", "scryfall_url": "https://scryfall.com/card/khm/195/spirit-of-the-aldergard?utm_source=api", "types": ["Creature"], "color_identity": ["G"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.359, "total": 0.582}}, {"name": "Ugin's Construct", "image_url": "https://cards.scryfall.io/normal/front/7/e/7ee009a4-72d0-4828-b826-3ed7c7d87b53.jpg?1783938670", "scryfall_url": "https://scryfall.com/card/frf/164/ugins-construct?utm_source=api", "types": ["Creature", "Artifact"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.35, "total": 0.581}}, {"name": "Spirit of the Spires", "image_url": "https://cards.scryfall.io/normal/front/d/b/dbd11910-58e2-4233-a18c-e97413126597.jpg?1783933715", "scryfall_url": "https://scryfall.com/card/rna/23/spirit-of-the-spires?utm_source=api", "types": ["Creature"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.324, "total": 0.575}}, {"name": "Spirit of Malevolence", "image_url": "https://cards.scryfall.io/normal/front/c/f/cf3765b7-11e2-4837-b5e5-ca24adc0e33c.jpg?1783930618", "scryfall_url": "https://scryfall.com/card/m21/331/spirit-of-malevolence?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.251, "total": 0.561}}]}

event: explanation
data: {"index": 0, "title": "Ugin and the colorless toolkit", "explanation": "Planeswalker Ugins and support artifacts/lands enable big colorless plays, recurring or tutoring powerful permanents, and disrupt colored threats \u2014 representing Ugin's role as a colorless-reactive force and story presence tied to the struggle around the Eldrazi.", "cards": [{"name": "Ugin, the Spirit Dragon", "image_url": "https://cards.scryfall.io/normal/front/9/c/9c017fa9-7021-417a-9c2e-3df409644fcf.jpg?1783930748", "scryfall_url": "https://scryfall.com/card/m21/1/ugin-the-spirit-dragon?utm_source=api", "types": ["Planeswalker"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.799, "similarity": 1.0, "total": 1.524}, "reason": "A definitive finish and board-reset engine: +2 deals 3 to any target, \u2212X exiles all colored permanents with mana value X or less (a powerful sweep against colored threats), and the \u221210 ultimate generates massive card advantage and board presence. Storywise, Ugin is the ancient spirit dragon central to the conflict with the Eldrazi and was involved in events where Sarkhan intervened on his behalf.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/unbroken-and-unbowed-2015-04-22", "https://magic.wizards.com/en/news/magic-story/revelation-eye-2015-10-14"], "source_titles": ["Unbroken and Unbowed", "Revelation at the Eye"]}, {"name": "Ugin, the Ineffable", "image_url": "https://cards.scryfall.io/normal/front/2/e/2eb7e322-aba0-42f5-80a1-267f3444ac4d.jpg?1783915455", "scryfall_url": "https://scryfall.com/card/cmm/811/ugin-the-ineffable?utm_source=api", "types": ["Planeswalker"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.779, "similarity": 0.343, "total": 0.985}, "reason": "Reduces the cost of colorless spells by {2}, generates repeatable value by exiling a card and creating a 2/2 Spirit token (which returns the exiled card to hand when it dies), and can destroy colored permanents with \u22123. Excellent for accelerating and protecting a colorless Eldrazi plan while removing colored answers.", "source_urls": [], "source_titles": []}, {"name": "Ugin, Eye of the Storms", "image_url": "https://cards.scryfall.io/normal/front/6/4/64a5d494-efa1-446b-bebe-2ad36e154376.jpg?1783907421", "scryfall_url": "https://scryfall.com/card/tdm/1/ugin-eye-of-the-storms?utm_source=api", "types": ["Planeswalker"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.799, "similarity": 0.48, "total": 1.02}, "reason": "On-cast and triggers exile colored permanents when casting colorless spells, provides card draw and ramp (0: add {C}{C}{C}), and a huge ultimate that tutors many colorless permanents. Acts as a tempo and tutoring engine for a colorless Eldrazi/planewalker strategy.", "source_urls": [], "source_titles": []}, {"name": "Ugin's Nexus", "image_url": "https://cards.scryfall.io/normal/front/9/4/94002868-a48a-4ea8-bfce-17257078f5db.jpg?1783939047", "scryfall_url": "https://scryfall.com/card/ktk/227/ugins-nexus?utm_source=api", "types": ["Artifact"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.79, "total": 0.669}, "reason": "Rules- and story-flavored artifact that interacts with extra turns: it prevents extra turns unless it is exiled to grant one. Mechanically it can protect a dangerous exile-on-death effect and enable a scripted extra-turn/timing plan with Ugin interactions.", "source_urls": [], "source_titles": []}, {"name": "Sanctum of Ugin", "image_url": "https://cards.scryfall.io/normal/front/8/6/86798d03-9f2d-46bd-a660-13c8dd5535ce.jpg?1783938173", "scryfall_url": "https://scryfall.com/card/bfz/242/sanctum-of-ugin?utm_source=api", "types": ["Land"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.884, "similarity": 0.348, "total": 0.916}, "reason": "Searches for colorless creatures when a very large colorless spell is cast, enabling consistent Eldrazi tutoring and letting the deck capitalize on high-mana spells or finishers.", "source_urls": [], "source_titles": []}, {"name": "Ugin's Insight", "image_url": "https://cards.scryfall.io/normal/front/f/3/f37d5938-9c8f-4203-8f3f-d6e89ced28ef.jpg?1783938206", "scryfall_url": "https://scryfall.com/card/bfz/87/ugins-insight?utm_source=api", "types": ["Sorcery"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.509, "total": 0.612}, "reason": "Scry X (where X is the greatest mana value among permanents controlled) then draw three. This card turns large colorless permanents into card selection and draw, smoothing into the late-game Eldrazi plan.", "source_urls": [], "source_titles": []}, {"name": "Haven of the Spirit Dragon", "image_url": "https://cards.scryfall.io/normal/front/d/0/d0c552da-874e-49eb-b221-47220b8b7786.jpg?1783906982", "scryfall_url": "https://scryfall.com/card/tdc/370/haven-of-the-spirit-dragon?utm_source=api", "types": ["Land"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 1.0, "similarity": 0.75, "total": 1.041}, "reason": "Flexible mana and a recursion clause that can return a Dragon or Ugin planeswalker from the graveyard to hand, supporting recurring Ugin or dragon-synergy pieces in a deck that wants to reuse planeswalkers or big Dragon bodies.", "source_urls": [], "source_titles": []}, {"name": "Crucible of the Spirit Dragon", "image_url": "https://cards.scryfall.io/normal/front/2/5/257a5ae9-f754-4c45-a47d-5196f1b625b7.jpg?1783926160", "scryfall_url": "https://scryfall.com/card/afc/231/crucible-of-the-spirit-dragon?utm_source=api", "types": ["Land"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.404, "total": 0.591}, "reason": "Storage-mana land that can be spent only on Dragons; useful if the build includes Dragon elements or needs off-color mana sinks tied to Dragon recurrences with Haven/Tomb support.", "source_urls": [], "source_titles": []}, {"name": "Tomb of the Spirit Dragon", "image_url": "https://cards.scryfall.io/normal/front/8/2/824bf3cc-fb35-4bc1-998c-6758b1eed2ca.jpg?1783915372", "scryfall_url": "https://scryfall.com/card/cmm/1048/tomb-of-the-spirit-dragon?utm_source=api", "types": ["Land"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.911, "similarity": 0.346, "total": 0.926}, "reason": "Simple colorless ramp plus life gain tied to the number of colorless creatures, rewarding an Eldrazi-heavy board and helping the Ugin side stabilize against aggression.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 1, "title": "Eldrazi forces", "explanation": "Colorless Eldrazi creatures, Temple and artifact support, and heavy enablers that let the deck produce huge threat density, sacrifice-resistant boards, and annihilator-style finishes. These cards represent the Eldrazi menace that ravaged Zendikar and Sea Gate in story events.", "cards": [{"name": "Eldrazi Temple", "image_url": "https://cards.scryfall.io/normal/front/c/b/cbab7e1f-305e-4733-aa70-b27285740925.jpg?1783915392", "scryfall_url": "https://scryfall.com/card/cmm/992/eldrazi-temple?utm_source=api", "types": ["Land"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.872, "similarity": 0.603, "total": 0.852}, "reason": "Provides cheap colorless mana and a burst of two colorless specifically for casting Eldrazi spells or activating their abilities, accelerating early Eldrazi deployment.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/home-waters-2015-09-30"], "source_titles": ["Home Waters"]}, {"name": "Eldrazi Conscription", "image_url": "https://cards.scryfall.io/normal/front/3/3/33965c48-a7ce-4a04-8251-8eeb2d908c0b.jpg?1783903818", "scryfall_url": "https://scryfall.com/card/soc/131/eldrazi-conscription?utm_source=api", "types": ["Enchantment"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.656, "similarity": 0.402, "total": 0.73}, "reason": "A one-card game-ender: enchanting a huge Eldrazi gives +10/+10, trample and annihilator 2, forcing opponent sacrifices on attacks and turning a single Eldrazi into an immediate lethal threat.", "source_urls": [], "source_titles": []}, {"name": "Eldrazi Monument", "image_url": "https://cards.scryfall.io/normal/front/d/5/d5439677-d3db-4083-8dd9-0d654016bd79.jpg?1783936215", "scryfall_url": "https://scryfall.com/card/cma/216/eldrazi-monument?utm_source=api", "types": ["Artifact"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.424, "similarity": 0.507, "total": 0.663}, "reason": "Makes all creatures +1/+1, flying and indestructible at the cost of a creature each upkeep; excellent with token generators and scion synergies to create an almost unkillable Eldrazi army.", "source_urls": [], "source_titles": []}, {"name": "Eldrazi Devastator", "image_url": "https://cards.scryfall.io/normal/front/0/4/04b13e32-01b9-4a86-a3df-ca8b784c6a6c.jpg?1783938225", "scryfall_url": "https://scryfall.com/card/bfz/7/eldrazi-devastator?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.194, "total": 0.949}, "reason": "A big trample body that exemplifies the raw, overwhelming power of Eldrazi beaters \u2014 useful as a top-end threat pushed by the deck's colorless acceleration.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/zendikar-2015-08-12"], "source_titles": ["For Zendikar"]}, {"name": "Eldrazi Mimic", "image_url": "https://cards.scryfall.io/normal/front/3/1/311a05b1-042d-47e7-9fd7-6e8abe8fc578.jpg?1783937930", "scryfall_url": "https://scryfall.com/card/ogw/2/eldrazi-mimic?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.767, "similarity": 0.284, "total": 1.259}, "reason": "Scales with other colorless creatures entering; it can copy the base P/T of a recently played large Eldrazi to create explosive attack turns for very little mana.", "source_urls": [], "source_titles": []}, {"name": "Eldrazi Skyspawner", "image_url": "https://cards.scryfall.io/normal/front/9/c/9c9c1a10-446e-492a-95cc-a459dc6c08a0.jpg?1783938213", "scryfall_url": "https://scryfall.com/card/bfz/58/eldrazi-skyspawner?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.572, "total": 1.025}, "reason": "Provides a flying body and creates a 1/1 Eldrazi Scion token on ETB; the scion can be sacrificed for colorless mana, fueling more Eldrazi or Monument upkeep costs.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/home-waters-2015-09-30"], "source_titles": ["Home Waters"]}, {"name": "Eldrazi Obligator", "image_url": "https://cards.scryfall.io/normal/front/d/f/dfaa8b16-7c12-44e2-8ddb-17608d491c41.jpg?1783937909", "scryfall_url": "https://scryfall.com/card/ogw/96/eldrazi-obligator?utm_source=api", "types": ["Creature"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.377, "total": 0.986}, "reason": "Offers a tempo/control trick on cast (may gain control of an opponent creature for the turn) plus haste, enabling surprise swings and theft of blockers to clear a path for Eldrazi attackers.", "source_urls": [], "source_titles": []}, {"name": "Eldrazi Displacer", "image_url": "https://cards.scryfall.io/normal/front/f/0/f0bb1a5c-0f59-4951-827f-fe9df968232d.jpg?1783937928", "scryfall_url": "https://scryfall.com/card/ogw/13/eldrazi-displacer?utm_source=api", "types": ["Creature"], "color_identity": ["W"], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.568, "similarity": 0.415, "total": 1.209}, "reason": "Can flicker creatures for value (retrigger ETB abilities or protect key Eldrazi) using {2}{C} colorless activation, providing resilient and reactive toolkiting around Eldrazi bodies.", "source_urls": [], "source_titles": []}, {"name": "Eldrazi Confluence", "image_url": "https://cards.scryfall.io/normal/front/7/8/78ee2013-29dc-4879-9d59-1b492996d297.jpg?1783911429", "scryfall_url": "https://scryfall.com/card/m3c/32/eldrazi-confluence?utm_source=api", "types": ["Instant"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.813, "similarity": 0.467, "total": 0.802}, "reason": "Modal instant that can buff a creature, temporarily blink or bounce a nonland permanent, or create a Scion token for ramp; extremely versatile in Eldrazi decks for interaction and mana smoothing.", "source_urls": [], "source_titles": []}, {"name": "Rise of the Eldrazi", "image_url": "https://cards.scryfall.io/normal/front/4/a/4a4d851b-1fa9-4f5d-a8f6-6967b1ee5b50.jpg?1783915486", "scryfall_url": "https://scryfall.com/card/cmm/716/rise-of-the-eldrazi?utm_source=api", "types": ["Sorcery"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.779, "similarity": 0.778, "total": 0.851}, "reason": "A massive sorcery that destroys a permanent, draws four cards for a target player, and grants an extra turn before exiling itself. It's a high-impact, story-appropriate spell evoking Eldrazi devastation and temporal disruption.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/revelation-eye-2015-10-14", "https://magic.wizards.com/en/news/magic-story/believers-pilgrimage-2015-09-02"], "source_titles": ["Revelation at the Eye", "The Believers' Pilgrimage"]}, {"name": "Eldrazi Aggressor", "image_url": "https://cards.scryfall.io/normal/front/6/2/62f3ec85-552d-4e28-939e-ab2c39e3e9c5.jpg?1783937909", "scryfall_url": "https://scryfall.com/card/ogw/95/eldrazi-aggressor?utm_source=api", "types": ["Creature"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.424, "total": 0.995}, "reason": "Has haste when another colorless creature is controlled, enabling fast, early pressure and pairing well with Scion tokens or other small Eldrazi to push damage immediately.", "source_urls": [], "source_titles": []}, {"name": "Eldrazi Skyspawner", "image_url": "https://cards.scryfall.io/normal/front/9/c/9c9c1a10-446e-492a-95cc-a459dc6c08a0.jpg?1783938213", "scryfall_url": "https://scryfall.com/card/bfz/58/eldrazi-skyspawner?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.572, "total": 1.025}, "reason": "Provides flying and token ramp (duplicate entry for emphasis on token generation and mana synergy).", "source_urls": [], "source_titles": []}]}

event: done
data: {"chips": ["Character: Ugin, the Spirit Dragon", "Character: Eldrazi", "Card type: Planeswalker", "Card type: Eldrazi"], "characters": [{"name": "Ugin, the Spirit Dragon", "role": "central"}, {"name": "Eldrazi", "role": "central"}], "intro": "Two complementary sides for a Ugin vs. Eldrazi deck: Ugin-centric toolkit that accelerates and tutors colorless power, and an Eldrazi horde that abuses colorless synergy and annihilation-style finishes. Each group lists cards, why they belong, and short explanations of their mechanical role and any story-relevant ties.", "groups": [{"title": "Ugin and the colorless toolkit", "explanation": "Planeswalker Ugins and support artifacts/lands enable big colorless plays, recurring or tutoring powerful permanents, and disrupt colored threats \u2014 representing Ugin's role as a colorless-reactive force and story presence tied to the struggle around the Eldrazi.", "cards": [{"name": "Ugin, the Spirit Dragon", "image_url": "https://cards.scryfall.io/normal/front/9/c/9c017fa9-7021-417a-9c2e-3df409644fcf.jpg?1783930748", "scryfall_url": "https://scryfall.com/card/m21/1/ugin-the-spirit-dragon?utm_source=api", "types": ["Planeswalker"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.799, "similarity": 1.0, "total": 1.524}, "reason": "A definitive finish and board-reset engine: +2 deals 3 to any target, \u2212X exiles all colored permanents with mana value X or less (a powerful sweep against colored threats), and the \u221210 ultimate generates massive card advantage and board presence. Storywise, Ugin is the ancient spirit dragon central to the conflict with the Eldrazi and was involved in events where Sarkhan intervened on his behalf.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/unbroken-and-unbowed-2015-04-22", "https://magic.wizards.com/en/news/magic-story/revelation-eye-2015-10-14"], "source_titles": ["Unbroken and Unbowed", "Revelation at the Eye"]}, {"name": "Ugin, the Ineffable", "image_url": "https://cards.scryfall.io/normal/front/2/e/2eb7e322-aba0-42f5-80a1-267f3444ac4d.jpg?1783915455", "scryfall_url": "https://scryfall.com/card/cmm/811/ugin-the-ineffable?utm_source=api", "types": ["Planeswalker"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.779, "similarity": 0.343, "total": 0.985}, "reason": "Reduces the cost of colorless spells by {2}, generates repeatable value by exiling a card and creating a 2/2 Spirit token (which returns the exiled card to hand when it dies), and can destroy colored permanents with \u22123. Excellent for accelerating and protecting a colorless Eldrazi plan while removing colored answers.", "source_urls": [], "source_titles": []}, {"name": "Ugin, Eye of the Storms", "image_url": "https://cards.scryfall.io/normal/front/6/4/64a5d494-efa1-446b-bebe-2ad36e154376.jpg?1783907421", "scryfall_url": "https://scryfall.com/card/tdm/1/ugin-eye-of-the-storms?utm_source=api", "types": ["Planeswalker"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.799, "similarity": 0.48, "total": 1.02}, "reason": "On-cast and triggers exile colored permanents when casting colorless spells, provides card draw and ramp (0: add {C}{C}{C}), and a huge ultimate that tutors many colorless permanents. Acts as a tempo and tutoring engine for a colorless Eldrazi/planewalker strategy.", "source_urls": [], "source_titles": []}, {"name": "Ugin's Nexus", "image_url": "https://cards.scryfall.io/normal/front/9/4/94002868-a48a-4ea8-bfce-17257078f5db.jpg?1783939047", "scryfall_url": "https://scryfall.com/card/ktk/227/ugins-nexus?utm_source=api", "types": ["Artifact"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.79, "total": 0.669}, "reason": "Rules- and story-flavored artifact that interacts with extra turns: it prevents extra turns unless it is exiled to grant one. Mechanically it can protect a dangerous exile-on-death effect and enable a scripted extra-turn/timing plan with Ugin interactions.", "source_urls": [], "source_titles": []}, {"name": "Sanctum of Ugin", "image_url": "https://cards.scryfall.io/normal/front/8/6/86798d03-9f2d-46bd-a660-13c8dd5535ce.jpg?1783938173", "scryfall_url": "https://scryfall.com/card/bfz/242/sanctum-of-ugin?utm_source=api", "types": ["Land"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.884, "similarity": 0.348, "total": 0.916}, "reason": "Searches for colorless creatures when a very large colorless spell is cast, enabling consistent Eldrazi tutoring and letting the deck capitalize on high-mana spells or finishers.", "source_urls": [], "source_titles": []}, {"name": "Ugin's Insight", "image_url": "https://cards.scryfall.io/normal/front/f/3/f37d5938-9c8f-4203-8f3f-d6e89ced28ef.jpg?1783938206", "scryfall_url": "https://scryfall.com/card/bfz/87/ugins-insight?utm_source=api", "types": ["Sorcery"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.509, "total": 0.612}, "reason": "Scry X (where X is the greatest mana value among permanents controlled) then draw three. This card turns large colorless permanents into card selection and draw, smoothing into the late-game Eldrazi plan.", "source_urls": [], "source_titles": []}, {"name": "Haven of the Spirit Dragon", "image_url": "https://cards.scryfall.io/normal/front/d/0/d0c552da-874e-49eb-b221-47220b8b7786.jpg?1783906982", "scryfall_url": "https://scryfall.com/card/tdc/370/haven-of-the-spirit-dragon?utm_source=api", "types": ["Land"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 1.0, "similarity": 0.75, "total": 1.041}, "reason": "Flexible mana and a recursion clause that can return a Dragon or Ugin planeswalker from the graveyard to hand, supporting recurring Ugin or dragon-synergy pieces in a deck that wants to reuse planeswalkers or big Dragon bodies.", "source_urls": [], "source_titles": []}, {"name": "Crucible of the Spirit Dragon", "image_url": "https://cards.scryfall.io/normal/front/2/5/257a5ae9-f754-4c45-a47d-5196f1b625b7.jpg?1783926160", "scryfall_url": "https://scryfall.com/card/afc/231/crucible-of-the-spirit-dragon?utm_source=api", "types": ["Land"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.404, "total": 0.591}, "reason": "Storage-mana land that can be spent only on Dragons; useful if the build includes Dragon elements or needs off-color mana sinks tied to Dragon recurrences with Haven/Tomb support.", "source_urls": [], "source_titles": []}, {"name": "Tomb of the Spirit Dragon", "image_url": "https://cards.scryfall.io/normal/front/8/2/824bf3cc-fb35-4bc1-998c-6758b1eed2ca.jpg?1783915372", "scryfall_url": "https://scryfall.com/card/cmm/1048/tomb-of-the-spirit-dragon?utm_source=api", "types": ["Land"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.911, "similarity": 0.346, "total": 0.926}, "reason": "Simple colorless ramp plus life gain tied to the number of colorless creatures, rewarding an Eldrazi-heavy board and helping the Ugin side stabilize against aggression.", "source_urls": [], "source_titles": []}]}, {"title": "Eldrazi forces", "explanation": "Colorless Eldrazi creatures, Temple and artifact support, and heavy enablers that let the deck produce huge threat density, sacrifice-resistant boards, and annihilator-style finishes. These cards represent the Eldrazi menace that ravaged Zendikar and Sea Gate in story events.", "cards": [{"name": "Eldrazi Temple", "image_url": "https://cards.scryfall.io/normal/front/c/b/cbab7e1f-305e-4733-aa70-b27285740925.jpg?1783915392", "scryfall_url": "https://scryfall.com/card/cmm/992/eldrazi-temple?utm_source=api", "types": ["Land"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.872, "similarity": 0.603, "total": 0.852}, "reason": "Provides cheap colorless mana and a burst of two colorless specifically for casting Eldrazi spells or activating their abilities, accelerating early Eldrazi deployment.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/home-waters-2015-09-30"], "source_titles": ["Home Waters"]}, {"name": "Eldrazi Conscription", "image_url": "https://cards.scryfall.io/normal/front/3/3/33965c48-a7ce-4a04-8251-8eeb2d908c0b.jpg?1783903818", "scryfall_url": "https://scryfall.com/card/soc/131/eldrazi-conscription?utm_source=api", "types": ["Enchantment"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.656, "similarity": 0.402, "total": 0.73}, "reason": "A one-card game-ender: enchanting a huge Eldrazi gives +10/+10, trample and annihilator 2, forcing opponent sacrifices on attacks and turning a single Eldrazi into an immediate lethal threat.", "source_urls": [], "source_titles": []}, {"name": "Eldrazi Monument", "image_url": "https://cards.scryfall.io/normal/front/d/5/d5439677-d3db-4083-8dd9-0d654016bd79.jpg?1783936215", "scryfall_url": "https://scryfall.com/card/cma/216/eldrazi-monument?utm_source=api", "types": ["Artifact"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.424, "similarity": 0.507, "total": 0.663}, "reason": "Makes all creatures +1/+1, flying and indestructible at the cost of a creature each upkeep; excellent with token generators and scion synergies to create an almost unkillable Eldrazi army.", "source_urls": [], "source_titles": []}, {"name": "Eldrazi Devastator", "image_url": "https://cards.scryfall.io/normal/front/0/4/04b13e32-01b9-4a86-a3df-ca8b784c6a6c.jpg?1783938225", "scryfall_url": "https://scryfall.com/card/bfz/7/eldrazi-devastator?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.194, "total": 0.949}, "reason": "A big trample body that exemplifies the raw, overwhelming power of Eldrazi beaters \u2014 useful as a top-end threat pushed by the deck's colorless acceleration.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/zendikar-2015-08-12"], "source_titles": ["For Zendikar"]}, {"name": "Eldrazi Mimic", "image_url": "https://cards.scryfall.io/normal/front/3/1/311a05b1-042d-47e7-9fd7-6e8abe8fc578.jpg?1783937930", "scryfall_url": "https://scryfall.com/card/ogw/2/eldrazi-mimic?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.767, "similarity": 0.284, "total": 1.259}, "reason": "Scales with other colorless creatures entering; it can copy the base P/T of a recently played large Eldrazi to create explosive attack turns for very little mana.", "source_urls": [], "source_titles": []}, {"name": "Eldrazi Skyspawner", "image_url": "https://cards.scryfall.io/normal/front/9/c/9c9c1a10-446e-492a-95cc-a459dc6c08a0.jpg?1783938213", "scryfall_url": "https://scryfall.com/card/bfz/58/eldrazi-skyspawner?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.572, "total": 1.025}, "reason": "Provides a flying body and creates a 1/1 Eldrazi Scion token on ETB; the scion can be sacrificed for colorless mana, fueling more Eldrazi or Monument upkeep costs.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/home-waters-2015-09-30"], "source_titles": ["Home Waters"]}, {"name": "Eldrazi Obligator", "image_url": "https://cards.scryfall.io/normal/front/d/f/dfaa8b16-7c12-44e2-8ddb-17608d491c41.jpg?1783937909", "scryfall_url": "https://scryfall.com/card/ogw/96/eldrazi-obligator?utm_source=api", "types": ["Creature"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.377, "total": 0.986}, "reason": "Offers a tempo/control trick on cast (may gain control of an opponent creature for the turn) plus haste, enabling surprise swings and theft of blockers to clear a path for Eldrazi attackers.", "source_urls": [], "source_titles": []}, {"name": "Eldrazi Displacer", "image_url": "https://cards.scryfall.io/normal/front/f/0/f0bb1a5c-0f59-4951-827f-fe9df968232d.jpg?1783937928", "scryfall_url": "https://scryfall.com/card/ogw/13/eldrazi-displacer?utm_source=api", "types": ["Creature"], "color_identity": ["W"], "evidence": ["lore", "synergy"], "scores": {"story": 0.824, "synergy": 0.568, "similarity": 0.415, "total": 1.209}, "reason": "Can flicker creatures for value (retrigger ETB abilities or protect key Eldrazi) using {2}{C} colorless activation, providing resilient and reactive toolkiting around Eldrazi bodies.", "source_urls": [], "source_titles": []}, {"name": "Eldrazi Confluence", "image_url": "https://cards.scryfall.io/normal/front/7/8/78ee2013-29dc-4879-9d59-1b492996d297.jpg?1783911429", "scryfall_url": "https://scryfall.com/card/m3c/32/eldrazi-confluence?utm_source=api", "types": ["Instant"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.813, "similarity": 0.467, "total": 0.802}, "reason": "Modal instant that can buff a creature, temporarily blink or bounce a nonland permanent, or create a Scion token for ramp; extremely versatile in Eldrazi decks for interaction and mana smoothing.", "source_urls": [], "source_titles": []}, {"name": "Rise of the Eldrazi", "image_url": "https://cards.scryfall.io/normal/front/4/a/4a4d851b-1fa9-4f5d-a8f6-6967b1ee5b50.jpg?1783915486", "scryfall_url": "https://scryfall.com/card/cmm/716/rise-of-the-eldrazi?utm_source=api", "types": ["Sorcery"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.779, "similarity": 0.778, "total": 0.851}, "reason": "A massive sorcery that destroys a permanent, draws four cards for a target player, and grants an extra turn before exiling itself. It's a high-impact, story-appropriate spell evoking Eldrazi devastation and temporal disruption.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/revelation-eye-2015-10-14", "https://magic.wizards.com/en/news/magic-story/believers-pilgrimage-2015-09-02"], "source_titles": ["Revelation at the Eye", "The Believers' Pilgrimage"]}, {"name": "Eldrazi Aggressor", "image_url": "https://cards.scryfall.io/normal/front/6/2/62f3ec85-552d-4e28-939e-ab2c39e3e9c5.jpg?1783937909", "scryfall_url": "https://scryfall.com/card/ogw/95/eldrazi-aggressor?utm_source=api", "types": ["Creature"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.424, "total": 0.995}, "reason": "Has haste when another colorless creature is controlled, enabling fast, early pressure and pairing well with Scion tokens or other small Eldrazi to push damage immediately.", "source_urls": [], "source_titles": []}, {"name": "Eldrazi Skyspawner", "image_url": "https://cards.scryfall.io/normal/front/9/c/9c9c1a10-446e-492a-95cc-a459dc6c08a0.jpg?1783938213", "scryfall_url": "https://scryfall.com/card/bfz/58/eldrazi-skyspawner?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.572, "total": 1.025}, "reason": "Provides flying and token ramp (duplicate entry for emphasis on token generation and mana synergy).", "source_urls": [], "source_titles": []}]}]}

