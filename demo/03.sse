event: explanation
data: {"index": 0, "title": "Bolas and Enablers", "explanation": "This group focuses on putting Nicol Bolas onto the battlefield (or transforming him into a planeswalker), protecting and tutoring him, and capitalizing on his planeswalker- and Elder Dragon\u2013level effects.", "cards": [{"name": "Nicol Bolas, the Ravager // Nicol Bolas, the Arisen", "image_url": "https://cards.scryfall.io/normal/front/7/b/7b215968-93a6-4278-ac61-4e3e8c3c3943.jpg?1783934524", "scryfall_url": "https://scryfall.com/card/m19/218/nicol-bolas-the-ravager-nicol-bolas-the-arisen?utm_source=api", "types": ["Creature", "Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.793, "similarity": 1.0, "total": 1.521}, "reason": "A compact planewalker package: the creature side is a 4/4 flying attacker that forces each opponent to discard when it enters, and its activated ability transforms it into a planeswalker version with card advantage (+2), a large removal option (\u22123 deals 10 to a creature or planeswalker), and a powerful late-game ultimate. Use the creature side to pressure and the transform to lock a game with planeswalker abilities.", "source_urls": [], "source_titles": []}, {"name": "Nicol Bolas, Dragon-God", "image_url": "https://cards.scryfall.io/normal/front/c/5/c5408607-af8f-48fe-bc40-32828d1976de.jpg?1783913282", "scryfall_url": "https://scryfall.com/card/rvr/205/nicol-bolas-dragon-god?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.85, "similarity": 0.82, "total": 1.507}, "reason": "A planeswalker version that copies loyalty abilities of all other planeswalkers on the battlefield and provides card draw, targeted removal (\u22123), and a devastating ultimate that punishes opponents who lack legendary permanents. It scales well in multiplayer and commander-style games where many planeswalkers appear.", "source_urls": [], "source_titles": []}, {"name": "Nicol Bolas, God-Pharaoh", "image_url": "https://cards.scryfall.io/normal/front/5/9/597ca22d-2f08-47b3-9d93-c4d685cefb5f.jpg?1783921810", "scryfall_url": "https://scryfall.com/card/2x2/260/nicol-bolas-god-pharaoh?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.85, "similarity": 0.806, "total": 1.504}, "reason": "Provides exile-based toolbox effects (+2 and +1 both force opponents to lose resources) and a large damage-based removal ultimate (\u22124 deals 7 to a target). Good as a versatile midrange/tempo planeswalker that supports a control plan.", "source_urls": [], "source_titles": []}, {"name": "Nicol Bolas", "image_url": "https://cards.scryfall.io/normal/front/8/e/8e92ba96-372c-418d-b271-45e1bf5c7af5.jpg?1783935115", "scryfall_url": "https://scryfall.com/card/a25/209/nicol-bolas?utm_source=api", "types": ["Creature"], "color_identity": ["U", "B", "R"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.972, "total": 0.594}, "reason": "The original Elder Dragon creature that must be paid for each upkeep but threatens massive hand disruption whenever it deals damage to a player. Useful in builds that can pay the upkeep or that cheat big mana into play.", "source_urls": [], "source_titles": []}, {"name": "Visage of Bolas", "image_url": "https://cards.scryfall.io/normal/front/f/2/f29bbfe2-d59f-4361-8ea4-6a8d1b909769.jpg?1783935983", "scryfall_url": "https://scryfall.com/card/hou/208/visage-of-bolas?utm_source=api", "types": ["Artifact"], "color_identity": ["U", "B", "R"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.991, "total": 0.563}, "reason": "Tutors for the specific Bolas printing named Nicol Bolas, the Deceiver when it enters, and provides colored mana ({U}, {B}, or {R}) to help cast Bolas or other spells of his colors.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/hour-devastation-2017-07-26"], "source_titles": ["Hour of Devastation"]}, {"name": "In Bolas's Clutches", "image_url": "https://cards.scryfall.io/normal/front/d/7/d72bf6b4-ac70-4be0-86de-cb3c47244dbc.jpg?1783935025", "scryfall_url": "https://scryfall.com/card/dom/54/in-bolass-clutches?utm_source=api", "types": ["Enchantment"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.0, "total": 0.365}, "reason": "Converts any permanent into a legendary permanent under the controller's control and gives control of that permanent; it can be used to make an important permanent legendary (or hijack an opposing permanent) to enable Bolas-specific ultimates or synergies that care about legendary permanents.", "source_urls": [], "source_titles": []}, {"name": "Wasp of the Bitter End", "image_url": "https://cards.scryfall.io/normal/front/4/6/46d348eb-7db0-4209-8960-c6adc473417d.jpg?1783935984", "scryfall_url": "https://scryfall.com/card/hou/206/wasp-of-the-bitter-end?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.516, "total": 0.468}, "reason": "Offers a cheap body that can be sacrificed when a Bolas planeswalker spell is cast to destroy a target creature. It is a built-in, repeatable interaction piece that triggers off casting Bolas planeswalkers.", "source_urls": [], "source_titles": []}, {"name": "Eye of Nidhogg", "image_url": "https://cards.scryfall.io/normal/front/1/8/186862e7-91ba-47e9-bc38-e8e20772d40c.jpg?1783906359", "scryfall_url": "https://scryfall.com/card/fic/44/eye-of-nidhogg?utm_source=api", "types": ["Enchantment"], "color_identity": ["B"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.68, "total": 0.136}, "reason": "A sticky aura that can turn a creature into a black Dragon with flying and deathtouch and that returns itself from the graveyard; it can give a Dragon theme and an evasive deathtouch attacker that complements Bolas's dragon identity.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 1, "title": "Opposition, Board Control, and Big Effects", "explanation": "This group provides the heavy, board-level effects and targeted answers that have been used against Bolas or his foes in story and that mechanically help a Bolas deck control the table: sweepers, asymmetric life/card disruption, targeted removals aimed at the Gatewatch characters, and dragon-makers to back Bolas's board presence.", "cards": [{"name": "Hour of Devastation", "image_url": "https://cards.scryfall.io/normal/front/d/4/d420cc12-cfd7-4007-a0c2-b16c8f63a754.jpg?1783936028", "scryfall_url": "https://scryfall.com/card/hou/97/hour-of-devastation?utm_source=api", "types": ["Sorcery"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.371, "total": 0.439}, "reason": "A powerful sorcery sweeper that removes indestructible and deals 5 damage to each creature and each non-Bolas planeswalker, which clears opposing defenses and is particularly effective against many midrange and indestructible boards.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/hour-devastation-2017-07-26"], "source_titles": ["Hour of Devastation"]}, {"name": "Fraying Omnipotence", "image_url": "https://cards.scryfall.io/normal/front/f/0/f0fa0ad8-854a-4b4e-9f87-e1dfaa11253c.jpg?1783934570", "scryfall_url": "https://scryfall.com/card/m19/97/fraying-omnipotence?utm_source=api", "types": ["Sorcery"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.165, "total": 0.398}, "reason": "A symmetrical but extreme reset: every player halves life, hand size, and creatures (rounding up). This can quickly swing stalled multiplayer games toward the Bolas player by equalizing and triggering Bolas ultimates or discard synergies.", "source_urls": [], "source_titles": []}, {"name": "Wake the Dragon", "image_url": "https://cards.scryfall.io/normal/front/f/9/f9cf5f78-0316-4c35-a40e-9bfba2e46ad8.jpg?1783916013", "scryfall_url": "https://scryfall.com/card/ltc/74/wake-the-dragon?utm_source=api", "types": ["Sorcery"], "color_identity": ["B", "R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.651, "total": 0.13}, "reason": "Creates a 6/6 dragon token with flying and menace and a theft trigger that can steal an opponent's artifact when it deals combat damage to a player; it provides a big evasion threat to back Bolas or to pressure planeswalker-centric opponents.", "source_urls": [], "source_titles": []}, {"name": "The Deck of Many Things", "image_url": "https://cards.scryfall.io/normal/front/f/e/feddbdc6-0757-43cb-bb41-dc83c6cf42ea.jpg?1783926439", "scryfall_url": "https://scryfall.com/card/afr/241/the-deck-of-many-things?utm_source=api", "types": ["Artifact"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.142, "total": 0.539}, "reason": "A high-variance artifact that can return creatures from graveyards, draw cards, or even cheat a creature from any graveyard onto the battlefield on a critical roll, offering chaotic but potentially game-winning recursion that suits a Bolas deck willing to take risks.", "source_urls": [], "source_titles": []}, {"name": "Font of Agonies", "image_url": "https://cards.scryfall.io/normal/front/d/7/d7c02aec-4a89-4ccc-8525-6f979c10d799.jpg?1783933694", "scryfall_url": "https://scryfall.com/card/rna/74/font-of-agonies?utm_source=api", "types": ["Enchantment"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.133, "total": 0.391}, "reason": "A low-cost enchantment that stores 'blood counters' when life is paid and can spend them to destroy a creature. It converts life payments (a common cost in black decks) into repeatable creature removal.", "source_urls": [], "source_titles": []}, {"name": "Sarkhan the Mad", "image_url": "https://cards.scryfall.io/normal/front/2/6/26c1ba92-556e-4da9-8e3a-a4a82612cb29.jpg?1783941958", "scryfall_url": "https://scryfall.com/card/roe/214/sarkhan-the-mad?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B", "R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.646, "total": 0.129}, "reason": "A dragon-themed planeswalker that can draw cards, create dragon tokens via an opponent-sacrifice effect, and let Dragons deal sweeping damage \u2014 a strong ally in a Dragon/Bolas archetype and a story-wise opponent of Bolas.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/unwritten-2015-01-14", "https://magic.wizards.com/en/news/magic-story/unwritten-2015-01-14"], "source_titles": ["Unwritten", "Unwritten"]}, {"name": "Sivitri, Dragon Master", "image_url": "https://cards.scryfall.io/normal/front/b/7/b7505068-484e-4844-b3dd-89c28f18275d.jpg?1783921462", "scryfall_url": "https://scryfall.com/card/dmc/43/sivitri-dragon-master?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.674, "total": 0.135}, "reason": "Protects the controller from attacks unless opponents pay life, tutors or searches for Dragon cards, and can destroy all non-Dragon creatures with its ultimate; it supports a Dragon subtheme that complements Bolas and helps shore up defenses against the Gatewatch.", "source_urls": [], "source_titles": []}, {"name": "Chandra's Defeat", "image_url": "https://cards.scryfall.io/normal/front/f/3/f38c6613-b1f7-4b38-b956-7860d041e593.jpg?1783936031", "scryfall_url": "https://scryfall.com/card/hou/86/chandras-defeat?utm_source=api", "types": ["Instant"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.113, "total": 0.387}, "reason": "A single-mana instant that kills a red creature or red planeswalker (including Chandra planeswalkers with card advantage on discard), serving as a narrow but cheap answer to red threats in the game and reflecting conflict with Chandra in the broader story.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/return-dominaria-episode-8-2018-05-02"], "source_titles": ["Return to Dominaria: Episode 8"]}, {"name": "Jace's Defeat", "image_url": "https://cards.scryfall.io/normal/front/c/6/c6b103c1-9b25-4bfe-9081-570977e9fdad.jpg?1783936052", "scryfall_url": "https://scryfall.com/card/hou/38/jaces-defeat?utm_source=api", "types": ["Instant"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.128, "total": 0.39}, "reason": "A cheap counterspell that specifically answers blue spells (and gives extra value if it counters a Jace planeswalker spell), representing a tidy tool to blunt Jace-based control or disruption.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/hour-devastation-2017-07-26"], "source_titles": ["Hour of Devastation"]}, {"name": "Liliana's Defeat", "image_url": "https://cards.scryfall.io/normal/front/0/f/0f72b028-b9df-40c7-822f-4acc6bdcc719.jpg?1783936040", "scryfall_url": "https://scryfall.com/card/hou/68/lilianas-defeat?utm_source=api", "types": ["Sorcery"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.283, "total": 0.421}, "reason": "A one-mana sorcery that destroys a black creature or planeswalker and punishes if the target was a Liliana planeswalker; it gives a narrow, efficient answer to black threats and mirrors Bolas's historical control over Liliana in the story.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/return-dominaria-episode-12-2018-05-30"], "source_titles": ["Return to Dominaria: Episode 12"]}]}

event: done
data: {"chips": ["Character: Nicol Bolas", "Card type: Planeswalker", "Card type: Dragon", "Card type: Legendary Creature", "Play style: build-around central card"], "characters": [{"name": "Nicol Bolas", "role": "central"}], "intro": "Two compact groups: one collects Nicol Bolas himself and cards that directly enable finding, cheating, or protecting him; the other collects cards that represent or answer the Gatewatch and allied threats Bolas faces, so the deck has both a Bolas-focused plan and pragmatic answers to the characters who oppose him.", "groups": [{"title": "Bolas and Enablers", "explanation": "This group focuses on putting Nicol Bolas onto the battlefield (or transforming him into a planeswalker), protecting and tutoring him, and capitalizing on his planeswalker- and Elder Dragon\u2013level effects.", "cards": [{"name": "Nicol Bolas, the Ravager // Nicol Bolas, the Arisen", "image_url": "https://cards.scryfall.io/normal/front/7/b/7b215968-93a6-4278-ac61-4e3e8c3c3943.jpg?1783934524", "scryfall_url": "https://scryfall.com/card/m19/218/nicol-bolas-the-ravager-nicol-bolas-the-arisen?utm_source=api", "types": ["Creature", "Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.793, "similarity": 1.0, "total": 1.521}, "reason": "A compact planewalker package: the creature side is a 4/4 flying attacker that forces each opponent to discard when it enters, and its activated ability transforms it into a planeswalker version with card advantage (+2), a large removal option (\u22123 deals 10 to a creature or planeswalker), and a powerful late-game ultimate. Use the creature side to pressure and the transform to lock a game with planeswalker abilities.", "source_urls": [], "source_titles": []}, {"name": "Nicol Bolas, Dragon-God", "image_url": "https://cards.scryfall.io/normal/front/c/5/c5408607-af8f-48fe-bc40-32828d1976de.jpg?1783913282", "scryfall_url": "https://scryfall.com/card/rvr/205/nicol-bolas-dragon-god?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.85, "similarity": 0.82, "total": 1.507}, "reason": "A planeswalker version that copies loyalty abilities of all other planeswalkers on the battlefield and provides card draw, targeted removal (\u22123), and a devastating ultimate that punishes opponents who lack legendary permanents. It scales well in multiplayer and commander-style games where many planeswalkers appear.", "source_urls": [], "source_titles": []}, {"name": "Nicol Bolas, God-Pharaoh", "image_url": "https://cards.scryfall.io/normal/front/5/9/597ca22d-2f08-47b3-9d93-c4d685cefb5f.jpg?1783921810", "scryfall_url": "https://scryfall.com/card/2x2/260/nicol-bolas-god-pharaoh?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.85, "similarity": 0.806, "total": 1.504}, "reason": "Provides exile-based toolbox effects (+2 and +1 both force opponents to lose resources) and a large damage-based removal ultimate (\u22124 deals 7 to a target). Good as a versatile midrange/tempo planeswalker that supports a control plan.", "source_urls": [], "source_titles": []}, {"name": "Nicol Bolas", "image_url": "https://cards.scryfall.io/normal/front/8/e/8e92ba96-372c-418d-b271-45e1bf5c7af5.jpg?1783935115", "scryfall_url": "https://scryfall.com/card/a25/209/nicol-bolas?utm_source=api", "types": ["Creature"], "color_identity": ["U", "B", "R"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.972, "total": 0.594}, "reason": "The original Elder Dragon creature that must be paid for each upkeep but threatens massive hand disruption whenever it deals damage to a player. Useful in builds that can pay the upkeep or that cheat big mana into play.", "source_urls": [], "source_titles": []}, {"name": "Visage of Bolas", "image_url": "https://cards.scryfall.io/normal/front/f/2/f29bbfe2-d59f-4361-8ea4-6a8d1b909769.jpg?1783935983", "scryfall_url": "https://scryfall.com/card/hou/208/visage-of-bolas?utm_source=api", "types": ["Artifact"], "color_identity": ["U", "B", "R"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.991, "total": 0.563}, "reason": "Tutors for the specific Bolas printing named Nicol Bolas, the Deceiver when it enters, and provides colored mana ({U}, {B}, or {R}) to help cast Bolas or other spells of his colors.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/hour-devastation-2017-07-26"], "source_titles": ["Hour of Devastation"]}, {"name": "In Bolas's Clutches", "image_url": "https://cards.scryfall.io/normal/front/d/7/d72bf6b4-ac70-4be0-86de-cb3c47244dbc.jpg?1783935025", "scryfall_url": "https://scryfall.com/card/dom/54/in-bolass-clutches?utm_source=api", "types": ["Enchantment"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.0, "total": 0.365}, "reason": "Converts any permanent into a legendary permanent under the controller's control and gives control of that permanent; it can be used to make an important permanent legendary (or hijack an opposing permanent) to enable Bolas-specific ultimates or synergies that care about legendary permanents.", "source_urls": [], "source_titles": []}, {"name": "Wasp of the Bitter End", "image_url": "https://cards.scryfall.io/normal/front/4/6/46d348eb-7db0-4209-8960-c6adc473417d.jpg?1783935984", "scryfall_url": "https://scryfall.com/card/hou/206/wasp-of-the-bitter-end?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.516, "total": 0.468}, "reason": "Offers a cheap body that can be sacrificed when a Bolas planeswalker spell is cast to destroy a target creature. It is a built-in, repeatable interaction piece that triggers off casting Bolas planeswalkers.", "source_urls": [], "source_titles": []}, {"name": "Eye of Nidhogg", "image_url": "https://cards.scryfall.io/normal/front/1/8/186862e7-91ba-47e9-bc38-e8e20772d40c.jpg?1783906359", "scryfall_url": "https://scryfall.com/card/fic/44/eye-of-nidhogg?utm_source=api", "types": ["Enchantment"], "color_identity": ["B"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.68, "total": 0.136}, "reason": "A sticky aura that can turn a creature into a black Dragon with flying and deathtouch and that returns itself from the graveyard; it can give a Dragon theme and an evasive deathtouch attacker that complements Bolas's dragon identity.", "source_urls": [], "source_titles": []}]}, {"title": "Opposition, Board Control, and Big Effects", "explanation": "This group provides the heavy, board-level effects and targeted answers that have been used against Bolas or his foes in story and that mechanically help a Bolas deck control the table: sweepers, asymmetric life/card disruption, targeted removals aimed at the Gatewatch characters, and dragon-makers to back Bolas's board presence.", "cards": [{"name": "Hour of Devastation", "image_url": "https://cards.scryfall.io/normal/front/d/4/d420cc12-cfd7-4007-a0c2-b16c8f63a754.jpg?1783936028", "scryfall_url": "https://scryfall.com/card/hou/97/hour-of-devastation?utm_source=api", "types": ["Sorcery"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.371, "total": 0.439}, "reason": "A powerful sorcery sweeper that removes indestructible and deals 5 damage to each creature and each non-Bolas planeswalker, which clears opposing defenses and is particularly effective against many midrange and indestructible boards.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/hour-devastation-2017-07-26"], "source_titles": ["Hour of Devastation"]}, {"name": "Fraying Omnipotence", "image_url": "https://cards.scryfall.io/normal/front/f/0/f0fa0ad8-854a-4b4e-9f87-e1dfaa11253c.jpg?1783934570", "scryfall_url": "https://scryfall.com/card/m19/97/fraying-omnipotence?utm_source=api", "types": ["Sorcery"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.165, "total": 0.398}, "reason": "A symmetrical but extreme reset: every player halves life, hand size, and creatures (rounding up). This can quickly swing stalled multiplayer games toward the Bolas player by equalizing and triggering Bolas ultimates or discard synergies.", "source_urls": [], "source_titles": []}, {"name": "Wake the Dragon", "image_url": "https://cards.scryfall.io/normal/front/f/9/f9cf5f78-0316-4c35-a40e-9bfba2e46ad8.jpg?1783916013", "scryfall_url": "https://scryfall.com/card/ltc/74/wake-the-dragon?utm_source=api", "types": ["Sorcery"], "color_identity": ["B", "R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.651, "total": 0.13}, "reason": "Creates a 6/6 dragon token with flying and menace and a theft trigger that can steal an opponent's artifact when it deals combat damage to a player; it provides a big evasion threat to back Bolas or to pressure planeswalker-centric opponents.", "source_urls": [], "source_titles": []}, {"name": "The Deck of Many Things", "image_url": "https://cards.scryfall.io/normal/front/f/e/feddbdc6-0757-43cb-bb41-dc83c6cf42ea.jpg?1783926439", "scryfall_url": "https://scryfall.com/card/afr/241/the-deck-of-many-things?utm_source=api", "types": ["Artifact"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.142, "total": 0.539}, "reason": "A high-variance artifact that can return creatures from graveyards, draw cards, or even cheat a creature from any graveyard onto the battlefield on a critical roll, offering chaotic but potentially game-winning recursion that suits a Bolas deck willing to take risks.", "source_urls": [], "source_titles": []}, {"name": "Font of Agonies", "image_url": "https://cards.scryfall.io/normal/front/d/7/d7c02aec-4a89-4ccc-8525-6f979c10d799.jpg?1783933694", "scryfall_url": "https://scryfall.com/card/rna/74/font-of-agonies?utm_source=api", "types": ["Enchantment"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.133, "total": 0.391}, "reason": "A low-cost enchantment that stores 'blood counters' when life is paid and can spend them to destroy a creature. It converts life payments (a common cost in black decks) into repeatable creature removal.", "source_urls": [], "source_titles": []}, {"name": "Sarkhan the Mad", "image_url": "https://cards.scryfall.io/normal/front/2/6/26c1ba92-556e-4da9-8e3a-a4a82612cb29.jpg?1783941958", "scryfall_url": "https://scryfall.com/card/roe/214/sarkhan-the-mad?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B", "R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.646, "total": 0.129}, "reason": "A dragon-themed planeswalker that can draw cards, create dragon tokens via an opponent-sacrifice effect, and let Dragons deal sweeping damage \u2014 a strong ally in a Dragon/Bolas archetype and a story-wise opponent of Bolas.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/unwritten-2015-01-14", "https://magic.wizards.com/en/news/magic-story/unwritten-2015-01-14"], "source_titles": ["Unwritten", "Unwritten"]}, {"name": "Sivitri, Dragon Master", "image_url": "https://cards.scryfall.io/normal/front/b/7/b7505068-484e-4844-b3dd-89c28f18275d.jpg?1783921462", "scryfall_url": "https://scryfall.com/card/dmc/43/sivitri-dragon-master?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.674, "total": 0.135}, "reason": "Protects the controller from attacks unless opponents pay life, tutors or searches for Dragon cards, and can destroy all non-Dragon creatures with its ultimate; it supports a Dragon subtheme that complements Bolas and helps shore up defenses against the Gatewatch.", "source_urls": [], "source_titles": []}, {"name": "Chandra's Defeat", "image_url": "https://cards.scryfall.io/normal/front/f/3/f38c6613-b1f7-4b38-b956-7860d041e593.jpg?1783936031", "scryfall_url": "https://scryfall.com/card/hou/86/chandras-defeat?utm_source=api", "types": ["Instant"], "color_identity": ["R"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.113, "total": 0.387}, "reason": "A single-mana instant that kills a red creature or red planeswalker (including Chandra planeswalkers with card advantage on discard), serving as a narrow but cheap answer to red threats in the game and reflecting conflict with Chandra in the broader story.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/return-dominaria-episode-8-2018-05-02"], "source_titles": ["Return to Dominaria: Episode 8"]}, {"name": "Jace's Defeat", "image_url": "https://cards.scryfall.io/normal/front/c/6/c6b103c1-9b25-4bfe-9081-570977e9fdad.jpg?1783936052", "scryfall_url": "https://scryfall.com/card/hou/38/jaces-defeat?utm_source=api", "types": ["Instant"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.128, "total": 0.39}, "reason": "A cheap counterspell that specifically answers blue spells (and gives extra value if it counters a Jace planeswalker spell), representing a tidy tool to blunt Jace-based control or disruption.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/hour-devastation-2017-07-26"], "source_titles": ["Hour of Devastation"]}, {"name": "Liliana's Defeat", "image_url": "https://cards.scryfall.io/normal/front/0/f/0f72b028-b9df-40c7-822f-4acc6bdcc719.jpg?1783936040", "scryfall_url": "https://scryfall.com/card/hou/68/lilianas-defeat?utm_source=api", "types": ["Sorcery"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.588, "synergy": 0.0, "similarity": 0.283, "total": 0.421}, "reason": "A one-mana sorcery that destroys a black creature or planeswalker and punishes if the target was a Liliana planeswalker; it gives a narrow, efficient answer to black threats and mirrors Bolas's historical control over Liliana in the story.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/return-dominaria-episode-12-2018-05-30"], "source_titles": ["Return to Dominaria: Episode 12"]}]}]}

