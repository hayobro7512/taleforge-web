fall.com/card/cmm/854/oath-of-jace?utm_source=api", "types": ["Enchantment"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.686, "total": 0.137}}, {"name": "Hexhaven Battalion", "image_url": "https://cards.scryfall.io/normal/front/3/b/3b6ac80e-c726-4bd0-893a-e666041a04a6.jpg?1789556695", "scryfall_url": "https://scryfall.com/card/fra/12/hexhaven-battalion?utm_source=api", "types": ["Sorcery"], "color_identity": ["W"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.684, "total": 0.137}}, {"name": "Jace's Sentinel", "image_url": "https://cards.scryfall.io/normal/front/9/1/9131361b-ec1e-4390-82c9-b9b9f77792a8.jpg?1783935684", "scryfall_url": "https://scryfall.com/card/xln/283/jaces-sentinel?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.683, "total": 0.137}}, {"name": "Violent Echoes", "image_url": "https://cards.scryfall.io/normal/front/a/d/ad03ba90-2442-4a71-94df-2088b5b63662.jpg?1789127599", "scryfall_url": "https://scryfall.com/card/fra/95/violent-echoes?utm_source=api", "types": ["Instant"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.68, "total": 0.136}}]}

event: explanation
data: {"index": 0, "title": "Primary Jaces (command and control)", "explanation": "These planeswalkers form the deck's core: Jace, Multiverse Architect is the focal commander that prevents opponents' creatures from attacking Jaces and provides card selection and removal. Jace, Reality Sculptor and Jace, Mirror Mage add ways to build and benefit from loyalty counters, create Jace tokens, and reshape opponents' libraries or draw spells to keep control. Together they provide both defensive control and avenues to leverage extra Jace tokens generated by the deck's empower effects.", "cards": [{"name": "Jace, Multiverse Architect", "image_url": "https://cards.scryfall.io/normal/front/5/5/55cd03d9-2535-4cf3-a8b2-1418e1190f4a.jpg?1789644316", "scryfall_url": "https://scryfall.com/card/frc/1/jace-multiverse-architect?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W", "U", "B", "R"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 1.0, "total": 0.6}, "reason": "At the beginning of combat on each opponent's turn, opponents may pay {2} or their creatures can't attack Jaces controlled by the player; +1 is card selection; \u22123 can exile another of the player's planeswalkers or creatures (partial oracle text shown). This makes Multiverse Architect a defensive hub and offers a repeatable source of card advantage and targeted removal tied to planeswalker synergies.", "source_urls": [], "source_titles": []}, {"name": "Jace, Reality Sculptor", "image_url": "https://cards.scryfall.io/normal/front/7/4/74087795-0b38-4fd2-9841-147583baca41.jpg?1790075861", "scryfall_url": "https://scryfall.com/card/fra/216/jace-reality-sculptor?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.698, "total": 0.14}, "reason": "+1 uses the number of Islands to give loyalty to a Jace token and the \u22123 punishes attackers with a large negative bonus; a powerful tempo/control planeswalker that converts board state (Islands) into more Jace loyalty and provides a severe board deterrent and a mass-library manipulation ultimate.", "source_urls": [], "source_titles": []}, {"name": "Jace, Mirror Mage", "image_url": "https://cards.scryfall.io/normal/front/8/6/86d34cbf-e424-461a-adf3-003d556a7859.jpg?1783915440", "scryfall_url": "https://scryfall.com/card/cmm/852/jace-mirror-mage?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.838, "similarity": 0.516, "total": 0.422}, "reason": "Kicker can create a nonlegendary Jace token with 1 starting loyalty; +1 scries; 0 draws a card and can remove loyalty equal to that card's mana value. Mirror Mage is a cheap route to additional Jace bodies and card selection that plays well with token-loyalty synergies.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 1, "title": "Reality Fracture \u2014 Empower engines", "explanation": "These enchantments, instants, sorceries, and creatures are built to 'empower Jace' (put loyalty counters on a Jace token you control). They are the engine that produces extra Jace loyalty quickly so the deck can amass many planeswalker activations and fuel Multiverse Architect's synergy.", "cards": [{"name": "Way of the Mind Sculptor", "image_url": "https://cards.scryfall.io/normal/front/5/8/5838af68-66c3-4fe8-ab89-0a1721b0cfeb.jpg?1789729565", "scryfall_url": "https://scryfall.com/card/fra/224/way-of-the-mind-sculptor?utm_source=api", "types": ["Enchantment"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.715, "total": 0.143}, "reason": "Enters to empower Jace 5 and grants an ability that rewards activating loyalty abilities (the card text ties extra loyalty removal to benefits), serving as a high-value empower and rule-changing aura for planeswalker activations.", "source_urls": [], "source_titles": []}, {"name": "Way of the Cryomancer", "image_url": "https://cards.scryfall.io/normal/front/8/3/838b0efb-7398-4df9-8fdf-b8af43b47938.jpg?1789014637", "scryfall_url": "https://scryfall.com/card/fra/223/way-of-the-cryomancer?utm_source=api", "types": ["Enchantment"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.706, "total": 0.141}, "reason": "Enters to empower Jace 5 and gives planeswalkers a triggered ability that links loyalty activation to casting instants or sorceries, fitting a control plan that converts spells into loyalty value.", "source_urls": [], "source_titles": []}, {"name": "Way of the Pyromancer", "image_url": "https://cards.scryfall.io/normal/front/c/1/c1a00020-7c14-4503-a057-5763704bb83e.jpg?1788878311", "scryfall_url": "https://scryfall.com/card/fra/254/way-of-the-pyromancer?utm_source=api", "types": ["Enchantment"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.738, "total": 0.148}, "reason": "Enters to empower Jace 2 and gives planeswalkers a mana-producing +1; it also creates a backup Jace token if none exist. Good for accelerating spellcasting or generating spare loyalty.", "source_urls": [], "source_titles": []}, {"name": "Way of the Deathbringer", "image_url": "https://cards.scryfall.io/normal/front/1/2/12dd46b2-e892-4660-b120-55766fd4d878.jpg?1789729576", "scryfall_url": "https://scryfall.com/card/fra/238/way-of-the-deathbringer?utm_source=api", "types": ["Enchantment"], "color_identity": ["B"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.731, "total": 0.146}, "reason": "Enters to empower Jace 5 and gives planeswalkers a sacrifice-related activated ability, providing synergy if the deck wants to convert creatures into value while still building Jace loyalty.", "source_urls": [], "source_titles": []}, {"name": "Way of the Warlord", "image_url": "https://cards.scryfall.io/normal/front/6/d/6d86e410-20c4-4248-96bf-5780ece6274a.jpg?1789729585", "scryfall_url": "https://scryfall.com/card/fra/255/way-of-the-warlord?utm_source=api", "types": ["Enchantment"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.734, "total": 0.147}, "reason": "Enters to empower Jace 5 and grants planeswalkers a direct-damage planeswalker ability, useful to convert loyalty into removal or reach.", "source_urls": [], "source_titles": []}, {"name": "Mindseeker Oculus", "image_url": "https://cards.scryfall.io/normal/front/f/5/f5324741-353a-4a70-adb2-b631b00806dd.jpg?1789556707", "scryfall_url": "https://scryfall.com/card/fra/33/mindseeker-oculus?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.72, "total": 0.144}, "reason": "When it enters, it empowers Jace 4, providing a cheap creature route to significant token loyalty and a repeatable convector for the empower plan.", "source_urls": [], "source_titles": []}, {"name": "Protege's Awakening", "image_url": "https://cards.scryfall.io/normal/front/a/0/a08c7ec2-4c6a-4db2-85a7-41afe8731523.jpg?1788878176", "scryfall_url": "https://scryfall.com/card/fra/37/proteges-awakening?utm_source=api", "types": ["Sorcery"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.787, "total": 0.157}, "reason": "Sorcery that directly empowers Jace 6 and draws a card; a concentrated burst of loyalty that accelerates token creation for immediate activations.", "source_urls": [], "source_titles": []}, {"name": "Overwrite the Multiverse", "image_url": "https://cards.scryfall.io/normal/front/c/4/c4554f5b-791b-48f6-bf54-ad28699e1beb.jpg?1788952080", "scryfall_url": "https://scryfall.com/card/fra/59/overwrite-the-multiverse?utm_source=api", "types": ["Sorcery"], "color_identity": ["B"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.72, "total": 0.144}, "reason": "Exiles all creatures and then empowers Jace X equal to creatures exiled, turning a board sweep into a large loyalty boost for Jace tokens and a reset that feeds the planeswalker engine.", "source_urls": [], "source_titles": []}, {"name": "Repurposed Enforcer", "image_url": "https://cards.scryfall.io/normal/front/3/5/35000e93-85d3-44f8-976a-5918ee4c71e0.jpg?1788878108", "scryfall_url": "https://scryfall.com/card/fra/19/repurposed-enforcer?utm_source=api", "types": ["Creature"], "color_identity": ["W"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.738, "total": 0.148}, "reason": "Attacking triggers an empower equal to the number of creatures you control, converting attacking into loyalty growth; synergizes with token generators or go-wide strategies to rapidly build Jace loyalty.", "source_urls": [], "source_titles": []}, {"name": "Violent Echoes", "image_url": "https://cards.scryfall.io/normal/front/a/d/ad03ba90-2442-4a71-94df-2088b5b63662.jpg?1789127599", "scryfall_url": "https://scryfall.com/card/fra/95/violent-echoes?utm_source=api", "types": ["Instant"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.68, "total": 0.136}, "reason": "Deals 6 damage to a creature or planeswalker and can empower Jace by any excess damage dealt, adding both removal and potential extra loyalty in a single instant.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 2, "title": "Support, protection, and planeswalker-proliferation", "explanation": "These cards help keep planeswalkers on board, produce extra Jace tokens or loyalty indirectly, and provide card draw or tempo to support the primary plan.", "cards": [{"name": "Jace's Projection", "image_url": "https://cards.scryfall.io/normal/front/c/4/c4d35a34-01b7-41e1-8491-a6589175d027.jpg?1783933359", "scryfall_url": "https://scryfall.com/card/war/272/jaces-projection?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.697, "total": 0.139}, "reason": "Gets +1/+1 counters whenever a card is drawn and has {3}{U}: put a loyalty counter on target Jace planeswalker, directly converting draw into extra Jace loyalty and acting as a repeatable loyalty conduit.", "source_urls": [], "source_titles": []}, {"name": "Interplanar Beacon", "image_url": "https://cards.scryfall.io/normal/front/b/c/bc1bed72-2440-4364-a69f-a9d7c4fe3fea.jpg?1783915388", "scryfall_url": "https://scryfall.com/card/cmm/1004/interplanar-beacon?utm_source=api", "types": ["Land"], "color_identity": [], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 1.0, "similarity": 0.518, "total": 0.484}, "reason": "A land that gains 1 life when a planeswalker spell is cast and can produce two mana of different colors usable only to cast planeswalker spells; helps fix and ramp into multi-colored planeswalker costs while providing incidental life gain.", "source_urls": [], "source_titles": []}, {"name": "Oath of Jace", "image_url": "https://cards.scryfall.io/normal/front/d/a/da62e9a8-d1aa-4fea-abb7-50c10d40fa6a.jpg?1783915439", "scryfall_url": "https://scryfall.com/card/cmm/854/oath-of-jace?utm_source=api", "types": ["Enchantment"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.686, "total": 0.137}, "reason": "Enters to draw three and discard two, and its upkeep scrying scales with the number of planeswalkers controlled, improving card quality and smoothing draws in a planeswalker-heavy deck.", "source_urls": [], "source_titles": []}, {"name": "Jace's Triumph", "image_url": "https://cards.scryfall.io/normal/front/4/9/4924f177-5ee2-4d3f-9603-4b9aef4dac09.jpg?1783933463", "scryfall_url": "https://scryfall.com/card/war/55/jaces-triumph?utm_source=api", "types": ["Sorcery"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.803, "total": 0.161}, "reason": "Draw two cards normally, but draw three if a Jace planeswalker is controlled; an efficient draw spell that rewards the Jace tribal theme.", "source_urls": [], "source_titles": []}, {"name": "Jace's Sentinel", "image_url": "https://cards.scryfall.io/normal/front/9/1/9131361b-ec1e-4390-82c9-b9b9f77792a8.jpg?1783935684", "scryfall_url": "https://scryfall.com/card/xln/283/jaces-sentinel?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.683, "total": 0.137}, "reason": "While a Jace planeswalker is controlled, this creature gets +1/+0 and can't be blocked, providing a cheap evasive attacker that benefits from maintaining Jaces on board.", "source_urls": [], "source_titles": []}]}

event: done
data: {"chips": ["Character: Jace, Multiverse Architect", "Card type: Planeswalker", "Play style: planeswalker tribal", "Play style: reality-fracture theme"], "characters": [{"name": "Jace, Multiverse Architect", "role": "central"}], "intro": "A planeswalker-tribal Jace deck built around Jace, Multiverse Architect with a Reality Fracture \u2014 style theme. The deck's plan is: use multiple Jace planeswalkers as both commanders and threats, generate Jace token loyalty with empower effects, and support the plan with card draw, protection, and ways to convert board events into Jace loyalty.", "groups": [{"title": "Primary Jaces (command and control)", "explanation": "These planeswalkers form the deck's core: Jace, Multiverse Architect is the focal commander that prevents opponents' creatures from attacking Jaces and provides card selection and removal. Jace, Reality Sculptor and Jace, Mirror Mage add ways to build and benefit from loyalty counters, create Jace tokens, and reshape opponents' libraries or draw spells to keep control. Together they provide both defensive control and avenues to leverage extra Jace tokens generated by the deck's empower effects.", "cards": [{"name": "Jace, Multiverse Architect", "image_url": "https://cards.scryfall.io/normal/front/5/5/55cd03d9-2535-4cf3-a8b2-1418e1190f4a.jpg?1789644316", "scryfall_url": "https://scryfall.com/card/frc/1/jace-multiverse-architect?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W", "U", "B", "R"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 1.0, "total": 0.6}, "reason": "At the beginning of combat on each opponent's turn, opponents may pay {2} or their creatures can't attack Jaces controlled by the player; +1 is card selection; \u22123 can exile another of the player's planeswalkers or creatures (partial oracle text shown). This makes Multiverse Architect a defensive hub and offers a repeatable source of card advantage and targeted removal tied to planeswalker synergies.", "source_urls": [], "source_titles": []}, {"name": "Jace, Reality Sculptor", "image_url": "https://cards.scryfall.io/normal/front/7/4/74087795-0b38-4fd2-9841-147583baca41.jpg?1790075861", "scryfall_url": "https://scryfall.com/card/fra/216/jace-reality-sculptor?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.698, "total": 0.14}, "reason": "+1 uses the number of Islands to give loyalty to a Jace token and the \u22123 punishes attackers with a large negative bonus; a powerful tempo/control planeswalker that converts board state (Islands) into more Jace loyalty and provides a severe board deterrent and a mass-library manipulation ultimate.", "source_urls": [], "source_titles": []}, {"name": "Jace, Mirror Mage", "image_url": "https://cards.scryfall.io/normal/front/8/6/86d34cbf-e424-461a-adf3-003d556a7859.jpg?1783915440", "scryfall_url": "https://scryfall.com/card/cmm/852/jace-mirror-mage?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.838, "similarity": 0.516, "total": 0.422}, "reason": "Kicker can create a nonlegendary Jace token with 1 starting loyalty; +1 scries; 0 draws a card and can remove loyalty equal to that card's mana value. Mirror Mage is a cheap route to additional Jace bodies and card selection that plays well with token-loyalty synergies.", "source_urls": [], "source_titles": []}]}, {"title": "Reality Fracture \u2014 Empower engines", "explanation": "These enchantments, instants, sorceries, and creatures are built to 'empower Jace' (put loyalty counters on a Jace token you control). They are the engine that produces extra Jace loyalty quickly so the deck can amass many planeswalker activations and fuel Multiverse Architect's synergy.", "cards": [{"name": "Way of the Mind Sculptor", "image_url": "https://cards.scryfall.io/normal/front/5/8/5838af68-66c3-4fe8-ab89-0a1721b0cfeb.jpg?1789729565", "scryfall_url": "https://scryfall.com/card/fra/224/way-of-the-mind-sculptor?utm_source=api", "types": ["Enchantment"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.715, "total": 0.143}, "reason": "Enters to empower Jace 5 and grants an ability that rewards activating loyalty abilities (the card text ties extra loyalty removal to benefits), serving as a high-value empower and rule-changing aura for planeswalker activations.", "source_urls": [], "source_titles": []}, {"name": "Way of the Cryomancer", "image_url": "https://cards.scryfall.io/normal/front/8/3/838b0efb-7398-4df9-8fdf-b8af43b47938.jpg?1789014637", "scryfall_url": "https://scryfall.com/card/fra/223/way-of-the-cryomancer?utm_source=api", "types": ["Enchantment"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.706, "total": 0.141}, "reason": "Enters to empower Jace 5 and gives planeswalkers a triggered ability that links loyalty activation to casting instants or sorceries, fitting a control plan that converts spells into loyalty value.", "source_urls": [], "source_titles": []}, {"name": "Way of the Pyromancer", "image_url": "https://cards.scryfall.io/normal/front/c/1/c1a00020-7c14-4503-a057-5763704bb83e.jpg?1788878311", "scryfall_url": "https://scryfall.com/card/fra/254/way-of-the-pyromancer?utm_source=api", "types": ["Enchantment"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.738, "total": 0.148}, "reason": "Enters to empower Jace 2 and gives planeswalkers a mana-producing +1; it also creates a backup Jace token if none exist. Good for accelerating spellcasting or generating spare loyalty.", "source_urls": [], "source_titles": []}, {"name": "Way of the Deathbringer", "image_url": "https://cards.scryfall.io/normal/front/1/2/12dd46b2-e892-4660-b120-55766fd4d878.jpg?1789729576", "scryfall_url": "https://scryfall.com/card/fra/238/way-of-the-deathbringer?utm_source=api", "types": ["Enchantment"], "color_identity": ["B"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.731, "total": 0.146}, "reason": "Enters to empower Jace 5 and gives planeswalkers a sacrifice-related activated ability, providing synergy if the deck wants to convert creatures into value while still building Jace loyalty.", "source_urls": [], "source_titles": []}, {"name": "Way of the Warlord", "image_url": "https://cards.scryfall.io/normal/front/6/d/6d86e410-20c4-4248-96bf-5780ece6274a.jpg?1789729585", "scryfall_url": "https://scryfall.com/card/fra/255/way-of-the-warlord?utm_source=api", "types": ["Enchantment"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.734, "total": 0.147}, "reason": "Enters to empower Jace 5 and grants planeswalkers a direct-damage planeswalker ability, useful to convert loyalty into removal or reach.", "source_urls": [], "source_titles": []}, {"name": "Mindseeker Oculus", "image_url": "https://cards.scryfall.io/normal/front/f/5/f5324741-353a-4a70-adb2-b631b00806dd.jpg?1789556707", "scryfall_url": "https://scryfall.com/card/fra/33/mindseeker-oculus?utm_source=api", "types": ["Creature"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.72, "total": 0.144}, "reason": "When it enters, it empowers Jace 4, providing a cheap creature route to significant token loyalty and a repeatable convector for the empower plan.", "source_urls": [], "source_titles": []}, {"name": "Protege's Awakening", "image_url": "https://cards.scryfall.io/normal/front/a/0/a08c7ec2-4c6a-4db2-85a7-41afe8731523.jpg?1788878176", "scryfall_url": "https://scryfall.com/card/fra/37/proteges-awakening?utm_source=api", "types": ["Sorcery"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.787, "total": 0.157}, "reason": "Sorcery that directly empowers Jace 6 and draws a card; a concentrated burst of loyalty that accelerates token creation for immediate activations.", "source_urls": [], "source_titles": []}, {"name": "Overwrite the Multiverse", "image_url": "https://cards.scryfall.io/normal/front/c/4/c4554f5b-791b-48f6-bf54-ad28699e1beb.jpg?1788952080", "scryfall_url": "https://scryfall.com/card/fra/59/overwrite-the-multiverse?utm_source=api", "types": ["Sorcery"], "color_identity": ["B"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.72, "total": 0.144}, "reason": "Exiles all creatures and then empowers Jace X equal to creatures exiled, turning a board sweep into a large loyalty boost for Jace tokens and a reset that feeds the planeswalker engine.", "source_urls": [], "source_titles": []}, {"name": "Repurposed Enforcer", "image_url": "https://cards.scryfall.io/normal/front/3/5/35000e93-85d3-44f8-976a-5918ee4c71e0.jpg?1788878108", "scryfall_url": "https://scryfall.com/card/fra/19/repurposed-enforcer?utm_source=api", "types": ["Creature"], "color_identity": ["W"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.738, "total": 0.148}, "reason": "Attacking triggers an empower equal to the number of creatures you control, converting attacking into loyalty growth; synergizes with token generators or go-wide strategies to rapidly build Jace loyalty.", "source_urls": [], "source_titles": []}, {"name": "Violent Echoes", "image_url": "https://cards.scryfall.io/normal/front/a/d/ad03ba90-2442-4a71-94df-2088b5b63662.jpg?1789127599", "scryfall_url": "https://scryfall.com/card/fra/95/violent-echoes?utm_source=api", "types": ["Instant"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.68, "total": 0.136}, "reason": "Deals 6 damage to a creature or planeswalker and can empower Jace by any excess damage dealt, adding both removal and potential extra loyalty in a single instant.", "source_urls": [], "source_titles": []}]}, {"title": "Support, protection, and