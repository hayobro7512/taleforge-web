data: {"cards": [{"name": "Nicol Bolas, the Ravager // Nicol Bolas, the Arisen", "image_url": "https://cards.scryfall.io/normal/front/7/b/7b215968-93a6-4278-ac61-4e3e8c3c3943.jpg?1783934524", "scryfall_url": "https://scryfall.com/card/m19/218/nicol-bolas-the-ravager-nicol-bolas-the-arisen?utm_source=api", "types": ["Creature", "Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.793, "similarity": 1.0, "total": 1.521}}, {"name": "Nicol Bolas, Dragon-God", "image_url": "https://cards.scryfall.io/normal/front/c/5/c5408607-af8f-48fe-bc40-32828d1976de.jpg?1783913282", "scryfall_url": "https://scryfall.com/card/rvr/205/nicol-bolas-dragon-god?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.85, "similarity": 0.82, "total": 1.507}}, {"name": "Nicol Bolas, God-Pharaoh", "image_url": "https://cards.scryfall.io/normal/front/5/9/597ca22d-2f08-47b3-9d93-c4d685cefb5f.jpg?1783921810", "scryfall_url": "https://scryfall.com/card/2x2/260/nicol-bolas-god-pharaoh?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.85, "similarity": 0.806, "total": 1.504}}, {"name": "Nicol Bolas, the Deceiver", "image_url": "https://cards.scryfall.io/normal/front/7/4/74239d78-1608-4b27-b2fd-8c7453f6b86b.jpg?1783935986", "scryfall_url": "https://scryfall.com/card/hou/205/nicol-bolas-the-deceiver?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B", "R"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.823, "total": 1.185}}, {"name": "Nicol Bolas, Planeswalker", "image_url": "https://cards.scryfall.io/normal/front/9/e/9e80f2fc-06d4-4ce9-b23b-3e4af1208fa5.jpg?1783936137", "scryfall_url": "https://scryfall.com/card/e01/85/nicol-bolas-planeswalker?utm_source=api", "types": ["Planeswalker"], "co