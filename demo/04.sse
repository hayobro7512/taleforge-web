event: explanation
data: {"index": 0, "title": "Liliana \u2014 the bargainer and her forms", "explanation": "These cards represent Liliana's personal story role of bargaining with powerful demons, being bound to artifacts like the Chain Veil, and the many planeswalker and creature versions of her that carry those consequences. They provide discard, graveyard interaction, reanimation, and sacrifice themes that reflect a pact-driven playstyle.", "cards": [{"name": "Liliana Vess", "image_url": "https://cards.scryfall.io/normal/front/6/0/6087f146-f468-472a-b248-fc7386ea3e63.jpg?1783939183", "scryfall_url": "https://scryfall.com/card/m15/103/liliana-vess?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.777, "similarity": 0.333, "total": 0.762}, "reason": "A planeswalker printing that emphasizes discard and graveyard payoffs: she can make a player discard, tutor a card to the top of the library, and her ultimate returns all creature cards from all graveyards to the battlefield under the controller's control. Story facts tied to this card note that Liliana Vess bargained with and feasted on demons (Griselbrand, Kothophed, and Razaketh appear in her history) and that she has been controlled or seized by Razaketh at one point; those events motivate a deck that trades life, bargains for power, and reaches into graveyards.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/unkindness-ravens-2015-07-29", "https://magic.wizards.com/en/news/magic-story/feast-2017-06-14", "https://magic.wizards.com/en/news/magic-story/servants-2017-04-19", "https://magic.wizards.com/en/news/magic-story/feast-2017-06-14"], "source_titles": ["Unkindness of Ravens", "Feast", "Servants", "Feast"]}, {"name": "Liliana, Death's Majesty", "image_url": "https://cards.scryfall.io/normal/front/b/6/b63ae119-f91e-4d0d-8bbd-65350a4d47c4.jpg?1783925336", "scryfall_url": "https://scryfall.com/card/mic/121/liliana-deaths-majesty?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.817, "similarity": 0.388, "total": 1.008}, "reason": "A planeswalker that creates Zombie tokens, mills, and can reanimate creatures as Zombies; it supports the undead side of a bargain deck by converting graveyard entries into battlefield bodies and finishing with a boardwipe that kills non-Zombies.", "source_urls": [], "source_titles": []}, {"name": "Liliana, Dreadhorde General", "image_url": "https://cards.scryfall.io/normal/front/c/b/cb28d217-795e-4320-a032-cd713f7ecc8a.jpg?1783909073", "scryfall_url": "https://scryfall.com/card/fdn/176/liliana-dreadhorde-general?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.82, "similarity": 0.514, "total": 1.035}, "reason": "A token- and card-draw engine tied to creature deaths: it produces 2/2 Zombies, draws whenever a creature controlled dies, and can force sacrifices \u2014 fitting a Liliana deck that sacrifices and reanimates to power big payouts.", "source_urls": [], "source_titles": []}, {"name": "Liliana, Untouched by Death", "image_url": "https://cards.scryfall.io/normal/front/a/7/a7939170-f84e-44c6-b8bc-a180cf7f85d9.jpg?1783934566", "scryfall_url": "https://scryfall.com/card/m19/106/liliana-untouched-by-death?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.878, "similarity": 0.355, "total": 1.025}, "reason": "A planeswalker that mills (with bonus if Zombies are milled), reduces creatures by number of Zombies, and temporarily lets the player cast Zombies from the graveyard \u2014 reinforcing the mill-to-reanimate angle common to pact decks.", "source_urls": [], "source_titles": []}, {"name": "Liliana, the Last Hope", "image_url": "https://cards.scryfall.io/normal/front/f/7/f7ae5085-0d0d-4d7d-80a3-614315a07de5.jpg?1783921903", "scryfall_url": "https://scryfall.com/card/2x2/81/liliana-the-last-hope?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 1.0, "similarity": 0.41, "total": 1.082}, "reason": "A low-cost Liliana who mills and can recur creatures from the graveyard; its emblem ability produces recurring Zombie tokens tied to the number of Zombies controlled, supporting long-term value from bargains.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 1, "title": "Pacts, demons, and the undead engines", "explanation": "These cards supply the formalized bargains and mechanical payoffs: enchantments and demons that reward controlling Demons or force opponents to sacrifice and discard, plus token generators, sacrifice-mill synergies, and creatures that become stronger or gain extra effects if a Liliana planeswalker is present.", "cards": [{"name": "Liliana's Contract", "image_url": "https://cards.scryfall.io/normal/front/7/5/750e6246-c28d-46ed-9966-26706f6d3172.jpg?1783934567", "scryfall_url": "https://scryfall.com/card/m19/107/lilianas-contract?utm_source=api", "types": ["Enchantment"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.421, "similarity": 0.856, "total": 0.331}, "reason": "An enchantment that gives immediate card advantage at the cost of life when it enters, and a win condition if the controller has four or more Demons with different names. This directly models a pact that trades life and cards for demonic service and an eventual catastrophic payoff.", "source_urls": [], "source_titles": []}, {"name": "Demonic Covenant", "image_url": "https://cards.scryfall.io/normal/front/9/0/90e9b488-37fd-42db-b0f2-b6c5a15a6e36.jpg?1783909658", "scryfall_url": "https://scryfall.com/card/dsc/19/demonic-covenant?utm_source=api", "types": ["Enchantment"], "color_identity": ["B"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.999, "total": 0.2}, "reason": "A kindred-enchantment-style engine that draws and costs life when Demons attack, and at each end step creates a massive 5/5 Demon token while milling \u2014 an ongoing pact-style engine that both rewards Demon presence and pushes the graveyard interaction this deck leverages.", "source_urls": [], "source_titles": []}, {"name": "Oath of Liliana", "image_url": "https://cards.scryfall.io/normal/front/2/0/2028f577-e0fb-48dd-89c6-f4a000b0a881.jpg?1783937481", "scryfall_url": "https://scryfall.com/card/emn/99/oath-of-liliana?utm_source=api", "types": ["Enchantment"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.815, "similarity": 0.848, "total": 0.479}, "reason": "An enchantment that forces an initial opponent sacrifice and then creates Zombie tokens whenever a planeswalker enters the battlefield under the controller's control that turn. It formalizes the bargain motif by combining sacrifice with token reward tied to Liliana appearances.", "source_urls": [], "source_titles": []}, {"name": "From Under the Floorboards", "image_url": "https://cards.scryfall.io/normal/front/c/f/cf31fec2-40d6-4810-8575-c7814bb4b6b4.jpg?1783932769", "scryfall_url": "https://scryfall.com/card/c19/113/from-under-the-floorboards?utm_source=api", "types": ["Sorcery"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.544, "similarity": 0.668, "total": 0.34}, "reason": "A spell that creates multiple tapped 2/2 Zombie tokens and grants life; its madness variant can scale up the number of tokens. It supplies a cheap, sacrificial-friendly way to populate the board with Zombies to be exchanged for greater value under pact effects.", "source_urls": [], "source_titles": []}, {"name": "Josu Vess, Lich Knight", "image_url": "https://cards.scryfall.io/normal/front/3/0/30553f61-6edf-4e7b-b60f-b8f62ca2bcad.jpg?1783917158", "scryfall_url": "https://scryfall.com/card/moc/253/josu-vess-lich-knight?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.933, "synergy": 0.0, "similarity": 0.45, "total": 0.669}, "reason": "A creature that, if kicked, creates eight 2/2 Zombie Knight tokens with menace when it enters. It represents a dramatic undead payoff that echoes Liliana\u2019s ability to turn the dead into an army.", "source_urls": [], "source_titles": []}, {"name": "Arisen Gorgon", "image_url": "https://cards.scryfall.io/normal/front/e/3/e39502fd-193c-4526-8dd8-0cd8c822552c.jpg?1783934483", "scryfall_url": "https://scryfall.com/card/m19/292/arisen-gorgon?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.667, "synergy": 0.0, "similarity": 1.0, "total": 0.613}, "reason": "A Zombie with deathtouch that is conditional on controlling a Liliana planeswalker, pairing well with Liliana cards that create Zombies or make creature death beneficial.", "source_urls": [], "source_titles": []}, {"name": "Desiccated Naga", "image_url": "https://cards.scryfall.io/normal/front/2/1/21f31e96-bb66-4b28-b14a-426d1d5839a6.jpg?1783936437", "scryfall_url": "https://scryfall.com/card/akh/276/desiccated-naga?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.667, "synergy": 0.0, "similarity": 0.92, "total": 0.597}, "reason": "A Zombie Snake that can be used as a repeatable life-drain (opponent loses 2 life, controller gains 2) only while a Liliana planeswalker is present, reinforcing the synergy between Liliana herself and the undead minions created by her bargains.", "source_urls": [], "source_titles": []}, {"name": "Rottenheart Ghoul", "image_url": "https://cards.scryfall.io/normal/front/9/3/933f0504-c611-4557-b1e6-f5be72154805.jpg?1783937765", "scryfall_url": "https://scryfall.com/card/soi/132/rottenheart-ghoul?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.667, "synergy": 0.0, "similarity": 0.35, "total": 0.483}, "reason": "A Zombie that auctions value from dying creatures by making a target player discard when it dies, supporting discard and sacrifice synergies that feed the graveyard and the bargain engine.", "source_urls": [], "source_titles": []}]}

event: done
data: {"chips": ["Character: Liliana Vess", "Card type: Planeswalker", "Card type: Demon", "Play style: sacrifice for benefit"], "characters": [{"name": "Liliana Vess", "role": "central"}], "intro": "Two complementary sides for a Liliana-themed deck that centers on her bargains with demons and the undead engines that enforce those pacts. One side collects cards tied to Liliana Vess's story role as a bargainer and her incarnations; the other side focuses on enchantments, demons, and zombie tokens that represent the mechanical payoff of those pacts.", "groups": [{"title": "Liliana \u2014 the bargainer and her forms", "explanation": "These cards represent Liliana's personal story role of bargaining with powerful demons, being bound to artifacts like the Chain Veil, and the many planeswalker and creature versions of her that carry those consequences. They provide discard, graveyard interaction, reanimation, and sacrifice themes that reflect a pact-driven playstyle.", "cards": [{"name": "Liliana Vess", "image_url": "https://cards.scryfall.io/normal/front/6/0/6087f146-f468-472a-b248-fc7386ea3e63.jpg?1783939183", "scryfall_url": "https://scryfall.com/card/m15/103/liliana-vess?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.777, "similarity": 0.333, "total": 0.762}, "reason": "A planeswalker printing that emphasizes discard and graveyard payoffs: she can make a player discard, tutor a card to the top of the library, and her ultimate returns all creature cards from all graveyards to the battlefield under the controller's control. Story facts tied to this card note that Liliana Vess bargained with and feasted on demons (Griselbrand, Kothophed, and Razaketh appear in her history) and that she has been controlled or seized by Razaketh at one point; those events motivate a deck that trades life, bargains for power, and reaches into graveyards.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/unkindness-ravens-2015-07-29", "https://magic.wizards.com/en/news/magic-story/feast-2017-06-14", "https://magic.wizards.com/en/news/magic-story/servants-2017-04-19", "https://magic.wizards.com/en/news/magic-story/feast-2017-06-14"], "source_titles": ["Unkindness of Ravens", "Feast", "Servants", "Feast"]}, {"name": "Liliana, Death's Majesty", "image_url": "https://cards.scryfall.io/normal/front/b/6/b63ae119-f91e-4d0d-8bbd-65350a4d47c4.jpg?1783925336", "scryfall_url": "https://scryfall.com/card/mic/121/liliana-deaths-majesty?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.817, "similarity": 0.388, "total": 1.008}, "reason": "A planeswalker that creates Zombie tokens, mills, and can reanimate creatures as Zombies; it supports the undead side of a bargain deck by converting graveyard entries into battlefield bodies and finishing with a boardwipe that kills non-Zombies.", "source_urls": [], "source_titles": []}, {"name": "Liliana, Dreadhorde General", "image_url": "https://cards.scryfall.io/normal/front/c/b/cb28d217-795e-4320-a032-cd713f7ecc8a.jpg?1783909073", "scryfall_url": "https://scryfall.com/card/fdn/176/liliana-dreadhorde-general?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.82, "similarity": 0.514, "total": 1.035}, "reason": "A token- and card-draw engine tied to creature deaths: it produces 2/2 Zombies, draws whenever a creature controlled dies, and can force sacrifices \u2014 fitting a Liliana deck that sacrifices and reanimates to power big payouts.", "source_urls": [], "source_titles": []}, {"name": "Liliana, Untouched by Death", "image_url": "https://cards.scryfall.io/normal/front/a/7/a7939170-f84e-44c6-b8bc-a180cf7f85d9.jpg?1783934566", "scryfall_url": "https://scryfall.com/card/m19/106/liliana-untouched-by-death?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.878, "similarity": 0.355, "total": 1.025}, "reason": "A planeswalker that mills (with bonus if Zombies are milled), reduces creatures by number of Zombies, and temporarily lets the player cast Zombies from the graveyard \u2014 reinforcing the mill-to-reanimate angle common to pact decks.", "source_urls": [], "source_titles": []}, {"name": "Liliana, the Last Hope", "image_url": "https://cards.scryfall.io/normal/front/f/7/f7ae5085-0d0d-4d7d-80a3-614315a07de5.jpg?1783921903", "scryfall_url": "https://scryfall.com/card/2x2/81/liliana-the-last-hope?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 1.0, "similarity": 0.41, "total": 1.082}, "reason": "A low-cost Liliana who mills and can recur creatures from the graveyard; its emblem ability produces recurring Zombie tokens tied to the number of Zombies controlled, supporting long-term value from bargains.", "source_urls": [], "source_titles": []}]}, {"title": "Pacts, demons, and the undead engines", "explanation": "These cards supply the formalized bargains and mechanical payoffs: enchantments and demons that reward controlling Demons or force opponents to sacrifice and discard, plus token generators, sacrifice-mill synergies, and creatures that become stronger or gain extra effects if a Liliana planeswalker is present.", "cards": [{"name": "Liliana's Contract", "image_url": "https://cards.scryfall.io/normal/front/7/5/750e6246-c28d-46ed-9966-26706f6d3172.jpg?1783934567", "scryfall_url": "https://scryfall.com/card/m19/107/lilianas-contract?utm_source=api", "types": ["Enchantment"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.421, "similarity": 0.856, "total": 0.331}, "reason": "An enchantment that gives immediate card advantage at the cost of life when it enters, and a win condition if the controller has four or more Demons with different names. This directly models a pact that trades life and cards for demonic service and an eventual catastrophic payoff.", "source_urls": [], "source_titles": []}, {"name": "Demonic Covenant", "image_url": "https://cards.scryfall.io/normal/front/9/0/90e9b488-37fd-42db-b0f2-b6c5a15a6e36.jpg?1783909658", "scryfall_url": "https://scryfall.com/card/dsc/19/demonic-covenant?utm_source=api", "types": ["Enchantment"], "color_identity": ["B"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.999, "total": 0.2}, "reason": "A kindred-enchantment-style engine that draws and costs life when Demons attack, and at each end step creates a massive 5/5 Demon token while milling \u2014 an ongoing pact-style engine that both rewards Demon presence and pushes the graveyard interaction this deck leverages.", "source_urls": [], "source_titles": []}, {"name": "Oath of Liliana", "image_url": "https://cards.scryfall.io/normal/front/2/0/2028f577-e0fb-48dd-89c6-f4a000b0a881.jpg?1783937481", "scryfall_url": "https://scryfall.com/card/emn/99/oath-of-liliana?utm_source=api", "types": ["Enchantment"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.815, "similarity": 0.848, "total": 0.479}, "reason": "An enchantment that forces an initial opponent sacrifice and then creates Zombie tokens whenever a planeswalker enters the battlefield under the controller's control that turn. It formalizes the bargain motif by combining sacrifice with token reward tied to Liliana appearances.", "source_urls": [], "source_titles": []}, {"name": "From Under the Floorboards", "image_url": "https://cards.scryfall.io/normal/front/c/f/cf31fec2-40d6-4810-8575-c7814bb4b6b4.jpg?1783932769", "scryfall_url": "https://scryfall.com/card/c19/113/from-under-the-floorboards?utm_source=api", "types": ["Sorcery"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.544, "similarity": 0.668, "to