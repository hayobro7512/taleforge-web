event: cards
data: {"cards": [{"name": "Liliana, Heretical Healer // Liliana, Defiant Necromancer", "image_url": "https://cards.scryfall.io/normal/front/d/8/d8b718d8-fca3-4b3e-9448-6067c8656a9a.jpg?1783924142", "scryfall_url": "https://scryfall.com/card/cc2/1/liliana-heretical-healer-liliana-defiant-necromancer?utm_source=api", "types": ["Creature", "Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.82, "similarity": 0.919, "total": 1.115}}, {"name": "Liliana, the Last Hope", "image_url": "https://cards.scryfall.io/normal/front/f/7/f7ae5085-0d0d-4d7d-80a3-614315a07de5.jpg?1783921903", "scryfall_url": "https://scryfall.com/card/2x2/81/liliana-the-last-hope?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 1.0, "similarity": 0.41, "total": 1.082}}, {"name": "Liliana, Dreadhorde General", "image_url": "https://cards.scryfall.io/normal/front/c/b/cb28d217-795e-4320-a032-cd713f7ecc8a.jpg?1783909073", "scryfall_url": "https://scryfall.com/card/fdn/176/liliana-dreadhorde-general?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.82, "similarity": 0.514, "total": 1.035}}, {"name": "Liliana, Untouched by Death", "image_url": "https://cards.scryfall.io/normal/front/a/7/a7939170-f84e-44c6-b8bc-a180cf7f85d9.jpg?1783934566", "scryfall_url": "https://scryfall.com/card/m19/106/liliana-untouched-by-death?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.878, "similarity": 0.355, "total": 1.025}}, {"name": "Liliana, Death's Majesty", "image_url": "https://cards.scryfall.io/normal/front/b/6/b63ae119-f91e-4d0d-8bbd-65350a4d47c4.jpg?1783925336", "scryfall_url": "https://scryfall.com/card/mic/121/liliana-deaths-majesty?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.817, "similarity": 0.388, "total": 1.008}}, {"name": "Liliana, Waker of the Dead", "image_url": "https://cards.scryfall.io/normal/front/e/3/e329a3e2-6702-4758-8aac-c3017e77b619.jpg?1783930705", "scryfall_url": "https://scryfall.com/card/m21/108/liliana-waker-of-the-dead?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.721, "similarity": 0.49, "total": 0.992}}, {"name": "Liliana, Death Mage", "image_url": "https://cards.scryfall.io/normal/front/9/2/921e3dc3-f8eb-4498-a6a8-b424952230cd.jpg?1783930620", "scryfall_url": "https://scryfall.com/card/m21/328/liliana-death-mage?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.721, "similarity": 0.406, "total": 0.975}}, {"name": "Liliana Vess", "image_url": "https://cards.scryfall.io/normal/front/6/0/6087f146-f468-472a-b248-fc7386ea3e63.jpg?1783939183", "scryfall_url": "https://scryfall.com/card/m15/103/liliana-vess?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 0.777, "similarity": 0.333, "total": 0.762}}, {"name": "Liliana the Repentant", "image_url": "https://cards.scryfall.io/normal/front/1/e/1eb25a6c-d6b4-465d-990e-f1ab86b26b69.jpg?1788329273", "scryfall_url": "https://scryfall.com/card/fra/231/liliana-the-repentant?utm_source=api", "types": ["Creature"], "color_identity": ["B"], "evidence": ["lore"], "scores": {"story": 0.933, "synergy": 0.0, "similarity": 0.859, "total": 0.751}}, {"name": "Liliana, the Necromancer", "image_url": "https://cards.scryfall.io/normal/front/4/d/4d2cbc2c-dbe3-4ecb-8fbe-785cb80b9e76.jpg?1783934485", "scryfall_url": "https://scryfall.com/card/m19/291/liliana-the-necromancer?utm_source=api", "types": ["Planeswalker"], "color_identity": ["B"], "evid