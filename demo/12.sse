event: explanation
data: {"index": 0, "title": "Compleated Ajani and the Phyrexian Betrayal", "explanation": "These cards represent Ajani after compleation and the narrative beats where he serves Phyrexia, betrays allies, and converts others. They provide a planeswalker focal point and effects that reflect compleation\u2019s mechanical and story consequences.", "cards": [{"name": "Ajani Goldmane", "image_url": "https://cards.scryfall.io/normal/front/2/d/2d911053-a026-4b20-ba2d-dbcc367c1413.jpg?1783941838", "scryfall_url": "https://scryfall.com/card/m11/1/ajani-goldmane?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.452, "total": 0.49}, "reason": "This card is the deck\u2019s titular Ajani: a white planeswalker with life-gain and a powerful \u22126 ultimate that exemplifies Ajani\u2019s identity as a leader whose strength tied to life totals and creatures. Story threads identify this Ajani as compleated, wearing metallic armor and acting for Phyrexia, betraying the Coalition and converting gods in Heliod\u2019s temple; those events place this card at the center of the deck\u2019s fall-to-Phyrexia theme.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-5-whisper-wind-2022-08-18", "https://magic.wizards.com/en/news/magic-story/assault-on-new-phyrexia-or-episode-5-inevitable-resolutions", "https://magic.wizards.com/en/news/magic-story/episode-6-the-last-to-leave"], "source_titles": ["Episode 5: A Whisper in the Wind", "Assault on New Phyrexia | Episode 5: Inevitable Resolutions", "March of the Machine | Episode 6: The Last to Leave"]}, {"name": "Ajani, Sleeper Agent", "image_url": "https://cards.scryfall.io/normal/front/7/6/7641f4d9-4614-41c8-87f5-4845bd78e9b3.jpg?1783921289", "scryfall_url": "https://scryfall.com/card/dmu/192/ajani-sleeper-agent?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W", "G"], "evidence": ["lore"], "scores": {"story": 0.938, "synergy": 0.0, "similarity": 0.601, "total": 0.702}, "reason": "This printing explicitly uses the mechanic label 'Compleated' and provides card advantage and recursion focused on creatures and planeswalkers, representing Ajani\u2019s altered capabilities after compleation.", "source_urls": [], "source_titles": []}, {"name": "Breach the Multiverse", "image_url": "https://cards.scryfall.io/normal/front/d/a/daf51a76-7a57-4462-ae18-a19e817e49e5.jpg?1783917016", "scryfall_url": "https://scryfall.com/card/mom/94/breach-the-multiverse?utm_source=api", "types": ["Sorcery"], "color_identity": ["B"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.848, "total": 0.17}, "reason": "This sorcery mills deeply, reanimates a chosen creature or planeswalker from each graveyard under the caster\u2019s control, and makes each creature controlled become a Phyrexian in addition to its other types\u2014a mechanical centerpiece for converting a board into Phyrexian forces.", "source_urls": [], "source_titles": []}, {"name": "Portal to Phyrexia", "image_url": "https://cards.scryfall.io/normal/front/5/f/5f608efc-0dbc-4cc3-aadd-ed473bfc29ab.jpg?1783920015", "scryfall_url": "https://scryfall.com/card/bro/240/portal-to-phyrexia?utm_source=api", "types": ["Artifact"], "color_identity": [], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.768, "total": 0.154}, "reason": "As a costly artifact, it forces opponents to sacrifice creatures on entry and then repeatedly returns creatures from graveyards as Phyrexians under the controller\u2019s control during upkeeps, embodying slow, relentless compleation and board takeover.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 1, "title": "Phyrexian Enablers and Engines", "explanation": "These cards supply Phyrexian synergies, sacrifice and reanimation engines, and characters / artifacts that either are Phyrexian or interact with Phyrexians to advance board state and conversion.", "cards": [{"name": "Vulpine Harvester", "image_url": "https://cards.scryfall.io/normal/front/4/2/42ebea93-14ba-4405-84a2-95e51a777ed5.jpg?1783917288", "scryfall_url": "https://scryfall.com/card/moc/19/vulpine-harvester?utm_source=api", "types": ["Creature"], "color_identity": ["W"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.881, "total": 0.176}, "reason": "A Phyrexian creature that grows value when Phyrexians attack by returning artifacts from the graveyard to the battlefield, supporting an aggressive, Phyrexian-themed engine of recovery and attrition.", "source_urls": [], "source_titles": []}, {"name": "Mishra, Claimed by Gix", "image_url": "https://cards.scryfall.io/normal/front/a/4/a469d7ec-42de-45de-9d8f-469bb979de58.jpg?1783920028", "scryfall_url": "https://scryfall.com/card/bro/216/mishra-claimed-by-gix?utm_source=api", "types": ["Creature"], "color_identity": ["B", "R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.858, "total": 0.172}, "reason": "A Phyrexian legendary creature with attack-based life-drain synergy; his Phyrexian identity and attack-triggered life exchange fit the theme of former allies turned into engine pieces for Phyrexia\u2019s war.", "source_urls": [], "source_titles": []}, {"name": "Eldrazi Ravager", "image_url": "https://cards.scryfall.io/normal/front/0/c/0ce97bb8-b0ee-4473-8c26-a3ec91abec97.jpg?1783911308", "scryfall_url": "https://scryfall.com/card/mh3/5/eldrazi-ravager?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.795, "total": 0.159}, "reason": "Provides an annihilator threat and graveyard recursion (sacrifice two Eldrazi to return it from graveyard to hand), giving the deck a repeatable angle of pressure and recursion that pairs with mass reanimation and compleation effects.", "source_urls": [], "source_titles": []}, {"name": "Spawnsire of Ulamog", "image_url": "https://cards.scryfall.io/normal/front/9/f/9ff46819-bfb3-4448-ab4f-f22ff9e2b2b4.jpg?1783942012", "scryfall_url": "https://scryfall.com/card/roe/11/spawnsire-of-ulamog?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.747, "total": 0.149}, "reason": "A high-cost Eldrazi that produces Spawn tokens and exerts annihilator pressure; it serves as an overwhelming late-game engine that complements a board turned Phyrexian and hungry for sacrifice/pressure.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 2, "title": "Pre-Fall Ajani Support (what was lost or corrupted)", "explanation": "These cards reflect Ajani\u2019s white lifegain-and-buff identity before compleation: anthem effects, token creation, and life-gain synergies that either get twisted by Phyrexia or serve as the deck\u2019s nostalgia pieces that Phyrexia exploits.", "cards": [{"name": "Oath of Ajani", "image_url": "https://cards.scryfall.io/normal/front/9/6/968c7d5a-b037-4ff7-b6d2-df00adf5691b.jpg?1783936736", "scryfall_url": "https://scryfall.com/card/aer/131/oath-of-ajani?utm_source=api", "types": ["Enchantment"], "color_identity": ["W", "G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.825, "total": 0.165}, "reason": "A legendary enchantment that distributes +1/+1 counters on entry and reduces planeswalker spell costs, representing Ajani\u2019s legacy of rallying allies and easing planeswalker deployment\u2014a pre-compleation support piece that Phyrexia can pervert.", "source_urls": [], "source_titles": []}, {"name": "Ajani's Comrade", "image_url": "https://cards.scryfall.io/normal/front/5/b/5bebef1c-2f03-4e0a-b3ba-861546ebf8a6.jpg?1783936714", "scryfall_url": "https://scryfall.com/card/aer/187/ajanis-comrade?utm_source=api", "types": ["Creature"], "color_identity": ["G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.831, "total": 0.166}, "reason": "A small creature that grows at the beginning of combat when an Ajani planeswalker is present, mechanically tying token and counter growth to Ajani\u2019s presence\u2014useful both before compleation and as fodder for conversion.", "source_urls": [], "source_titles": []}, {"name": "Ajani Resolute", "image_url": "https://cards.scryfall.io/normal/front/a/5/a5e1a7dd-8c49-4435-935c-bcc78704082b.jpg?1788329189", "scryfall_url": "https://scryfall.com/card/fra/195/ajani-resolute?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.906, "total": 0.181}, "reason": "A low-cost Ajani planeswalker that passively gains loyalty from life gain and can create Ajani\u2019s Pridemate tokens and an emblem, exemplifying the life-gain + counter archetype that the narrative strips away when Ajani is compleated.", "source_urls": [], "source_titles": []}, {"name": "Ajani, Strength of the Pride", "image_url": "https://cards.scryfall.io/normal/front/7/9/79883468-a37c-4894-8d05-6a4d150b7d59.jpg?1783933034", "scryfall_url": "https://scryfall.com/card/m20/2/ajani-strength-of-the-pride?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.948, "total": 0.19}, "reason": "A planeswalker that gains life based on creatures/planeswalkers and can mass-buff creatures with +1 loyalty ability, representing the leadership and life-synergy Ajani embodied prior to falling to Phyrexia.", "source_urls": [], "source_titles": []}]}

event: done
data: {"chips": ["Character: Ajani Goldmane", "Plane: Phyrexia", "Card type: Planeswalker", "Play style: corruption/transformation"], "characters": [{"name": "Ajani Goldmane", "role": "central"}], "intro": "Deck concept: two-sided Ajani Goldmane deck tracing Ajani's fall into Phyrexia and the battlefield effects of that compleation. One side shows the compleated Ajani and cards that represent Phyrexian conversion; the other preserves Ajani's pre-compleation support and allies that the deck corrupts or sacrifices to fuel that change.", "groups": [{"title": "Compleated Ajani and the Phyrexian Betrayal", "explanation": "These cards represent Ajani after compleation and the narrative beats where he serves Phyrexia, betrays allies, and converts others. They provide a planeswalker focal point and effects that reflect compleation\u2019s mechanical and story consequences.", "cards": [{"name": "Ajani Goldmane", "image_url": "https://cards.scryfall.io/normal/front/2/d/2d911053-a026-4b20-ba2d-dbcc367c1413.jpg?1783941838", "scryfall_url": "https://scryfall.com/card/m11/1/ajani-goldmane?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.452, "total": 0.49}, "reason": "This card is the deck\u2019s titular Ajani: a white planeswalker with life-gain and a powerful \u22126 ultimate that exemplifies Ajani\u2019s identity as a leader whose strength tied to life totals and creatures. Story threads identify this Ajani as compleated, wearing metallic armor and acting for Phyrexia, betraying the Coalition and converting gods in Heliod\u2019s temple; those events place this card at the center of the deck\u2019s fall-to-Phyrexia theme.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-5-whisper-wind-2022-08-18", "https://magic.wizards.com/en/news/magic-story/assault-on-new-phyrexia-or-episode-5-inevitable-resolutions", "https://magic.wizards.com/en/news/magic-story/episode-6-the-last-to-leave"], "source_titles": ["Episode 5: A Whisper in the Wind", "Assault on New Phyrexia | Episode 5: Inevitable Resolutions", "March of the Machine | Episode 6: The Last to Leave"]}, {"name": "Ajani, Sleeper Agent", "image_url": "https://cards.scryfall.io/normal/front/7/6/7641f4d9-4614-41c8-87f5-4845bd78e9b3.jpg?1783921289", "scryfall_url": "https://scryfall.com/card/dmu/192/ajani-sleeper-agent?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W", "G"], "evidence": ["lore"], "scores": {"story": 0.938, "synergy": 0.0, "similarity": 0.601, "total": 0.702}, "reason": "This printing explicitly uses the mechanic label 'Compleated' and provides card advantage and recursion focused on creatures and planeswalkers, representing Ajani\u2019s altered capabilities after compleation.", "source_urls": [], "source_titles": []}, {"name": "Breach the Multiverse", "image_url": "https://cards.scryfall.io/normal/front/d/a/daf51a76-7a57-4462-ae18-a19e817e49e5.jpg?1783917016", "scryfall_url": "https://scryfall.com/card/mom/94/breach-the-multiverse?utm_source=api", "types": ["Sorcery"], "color_identity": ["B"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.848, "total": 0.17}, "reason": "This sorcery mills deeply, reanimates a chosen creature or planeswalker from each graveyard under the caster\u2019s control, and makes each creature controlled become a Phyrexian in addition to its other types\u2014a mechanical centerpiece for converting a board into Phyrexian forces.", "source_urls": [], "source_titles": []}, {"name": "Portal to Phyrexia", "image_url": "https://cards.scryfall.io/normal/front/5/f/5f608efc-0dbc-4cc3-aadd-ed473bfc29ab.jpg?1783920015", "scryfall_url": "https://scryfall.com/card/bro/240/portal-to-phyrexia?utm_source=api", "types": ["Artifact"], "color_identity": [], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.768, "total": 0.154}, "reason": "As a costly artifact, it forces opponents to sacrifice creatures on entry and then repeatedly returns creatures from graveyards as Phyrexians under the controller\u2019s control during upkeeps, embodying slow, relentless compleation and board takeover.", "source_urls": [], "source_titles": []}]}, {"title": "Phyrexian Enablers and Engines", "explanation": "These cards supply Phyrexian synergies, sacrifice and reanimation engines, and characters / artifacts that either are Phyrexian or interact with Phyrexians to advance board state and conversion.", "cards": [{"name": "Vulpine Harvester", "image_url": "https://cards.scryfall.io/normal/front/4/2/42ebea93-14ba-4405-84a2-95e51a777ed5.jpg?1783917288", "scryfall_url": "https://scryfall.com/card/moc/19/vulpine-harvester?utm_source=api", "types": ["Creature"], "color_identity": ["W"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.881, "total": 0.176}, "reason": "A Phyrexian creature that grows value when Phyrexians attack by returning artifacts from the graveyard to the battlefield, supporting an aggressive, Phyrexian-themed engine of recovery and attrition.", "source_urls": [], "source_titles": []}, {"name": "Mishra, Claimed by Gix", "image_url": "https://cards.scryfall.io/normal/front/a/4/a469d7ec-42de-45de-9d8f-469bb979de58.jpg?1783920028", "scryfall_url": "https://scryfall.com/card/bro/216/mishra-claimed-by-gix?utm_source=api", "types": ["Creature"], "color_identity": ["B", "R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.858, "total": 0.172}, "reason": "A Phyrexian legendary creature with attack-based life-drain synergy; his Phyrexian identity and attack-triggered life exchange fit the theme of former allies turned into engine pieces for Phyrexia\u2019s war.", "source_urls": [], "source_titles": []}, {"name": "Eldrazi Ravager", "image_url": "https://cards.scryfall.io/normal/front/0/c/0ce97bb8-b0ee-4473-8c26-a3ec91abec97.jpg?1783911308", "scryfall_url": "https://scryfall.com/card/mh3/5/eldrazi-ravager?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.795, "total": 0.159}, "reason": "Provides an annihilator threat and graveyard recursion (sacrifice two Eldrazi to return it from graveyard to hand), giving the deck a repeatable angle of pressure and recursion that pairs with mass reanimation and compleation effects.", "source_urls": [], "source_titles": []}, {"name": "Spawnsire of Ulamog", "image_url": "https://cards.scryfall.io/normal/front/9/f/9ff46819-bfb3-4448-ab4f-f22ff9e2b2b4.jpg?1783942012", "scryfall_url": "https://scryfall.com/card/roe/11/spawnsire-of-ulamog?utm_source=api", "types": ["Creature"], "color_identity": [], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.747, "total": 0.149}, "reason": "A high-cost Eldrazi that produces Spawn tokens and exerts annihilator pressure; it serves as an overwhelming late-game engine that complements a board turned Phyrexian and hungry for sacrifice/pressure.", "source_urls": [], "source_titles": []}]}, {"title": "Pre-Fall Ajani Support (what was lost or corrupted)", "explanation": "These cards reflect Ajani\u2019s white lifegain-and-buff identity before compleation: anthem effects, token creation, and life-gain synergies that either get twisted by Phyrexia or serve as the deck\u2019s nostalgia pieces that Phyrexia exploits.", "cards": [{"name": "Oath of Ajani", "image_url": "https://cards.scryfall.io/normal/front/9/6/968c7d5a-b037-4ff7-b6d2-df00adf5691b.jpg?1783936736", "scryfall_url": "https://scryfall.com/card/aer/131/oath-of-ajani?utm_source=api", "types": ["Enchantment"], "color_identity": ["W", "G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.825, "total": 0.165}, "reason": "A legendary enchantment that distributes +1/+1 counters on entry and reduces planeswalker spell costs, representing Ajani\u2019s legacy of rallying allies and easing planeswalker deployment\u2014a pre-compleation support piece that Phyrexia can pervert.", "source_urls": [], "source_titles": []}, {"name": "Ajani's Comrade", "image_url": "https://cards.scryfall.io/normal/front/5/b/5bebef1c-2f03-4e0a-b3ba-861546ebf8a6.jpg?1783936714", "scryfall_url": "https://scryfall.com/card/aer/187/ajanis-comrade?utm_source=api", "types": ["Creature"], "color_identity": ["G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.831, "total": 0.166}, "reason": "A small creature that grows at the beginning of combat when an Ajani planeswalker is present, mechanically tying token and counter growth to Ajani\u2019s presence\u2014useful both before compleation and as fodder for conversion.", "source_urls": [], "source_titles": []}, {"name": "Ajani Resolute", "image_url": "https://cards.scryfall.io/normal/front/a/5/a5e1a7dd-8c49-4435-935c-bcc78704082b.jpg?1788329189", "scryfall_url": "https://scryfall.com/card/fra/195/ajani-resolute?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.906, "total": 0.181}, "reason": "A low-cost Ajani planeswalker that passively gains loyalty from life gain and can create Ajani\u2019s Pridemate tokens and an emblem, exemplifying the life-gain + counter archetype that the narrative strips away when Ajani is compleated.", "source_urls": [], "source_titles": []}, {"name": "Ajani, Strength of the Pride", "image_url": "https://cards.scryfall.io/normal/front/7/9/79883468-a37c-4894-8d05-6a4d150b7d59.jpg?1783933034", "scryfall_url": "https://scryfall.com/card/m20/2/ajani-strength-of-the-pride?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.948, "total": 0.19}, "reason": "A planeswalker that gains life based on creatures/planeswalkers and can mass-buff creatures with +1 loyalty ability, representing the leadership and life-synergy Ajani embodied prior to falling to Phyrexia.", "source_urls": [], "source_titles": []}]}]}

