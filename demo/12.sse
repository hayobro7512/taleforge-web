data: {"cards": [{"name": "Invasion of New Phyrexia // Teferi Akosa of Zhalfir", "image_url": "https://cards.scryfall.io/normal/front/1/b/1b83af86-e1a9-4be1-83dc-0c1ab81b129e.jpg?1783916950", "scryfall_url": "https://scryfall.com/card/mom/239/invasion-of-new-phyrexia-teferi-akosa-of-zhalfir?utm_source=api", "types": ["Planeswalker", "Battle"], "color_identity": ["W", "U"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.567, "total": 0.733}}, {"name": "Ajani, Sleeper Agent", "image_url": "https://cards.scryfall.io/normal/front/7/6/7641f4d9-4614-41c8-87f5-4845bd78e9b3.jpg?1783921289", "scryfall_url": "https://scryfall.com/card/dmu/192/ajani-sleeper-agent?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W", "G"], "evidence": ["lore"], "scores": {"story": 0.938, "synergy": 0.0, "similarity": 0.601, "total": 0.702}}, {"name": "Summon: Primal Odin", "image_url": "https://cards.scryfall.io/normal/front/8/b/8b1b5f06-e34d-44a3-976e-5157c4b7a0f4.jpg?1783906611", "scryfall_url": "https://scryfall.com/card/fin/121/summon:-primal-odin?utm_source=api", "types": ["Creature", "Enchantment"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 1.0, "similarity": 0.641, "total": 0.508}}, {"name": "Ajani Goldmane", "image_url": "https://cards.scryfall.io/normal/front/2/d/2d911053-a026-4b20-ba2d-dbcc367c1413.jpg?1783941838", "scryfall_url": "https://scryfall.com/card/m11/1/ajani-goldmane?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.452, "total": 0.49}}, {"name": "Ajani, Outland Chaperone", "image_url": "https://cards.scryfall.io/normal/front/6/1/6124a691-ae83-4d22-a177-0aee65b47064.jpg?1783904513", "scryfall_url": "https://scryfall.com/card/ecl/4/ajani-outland-chaperone?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity