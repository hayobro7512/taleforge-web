data: {"cards": [{"name": "Invasion of Theros // Ephara, Ever-Sheltering", "image_url": "https://cards.scryfall.io/normal/front/4/3/433e9f1c-9d6c-4c7e-89d0-79595b4331f2.jpg?1783917071", "scryfall_url": "https://scryfall.com/card/mom/23/invasion-of-theros-ephara-ever-sheltering?utm_source=api", "types": ["Creature", "Enchantment", "Battle"], "color_identity": ["W", "U"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.722, "total": 0.764}}, {"name": "Elspeth Tirel", "image_url": "https://cards.scryfall.io/normal/front/e/b/ebe9116e-7b04-4f2a-aa67-89a42c6e1801.jpg?1783941746", "scryfall_url": "https://scryfall.com/card/som/6/elspeth-tirel?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.0, "total": 0.4}}, {"name": "Sunlit Hoplite", "image_url": "https://cards.scryfall.io/normal/front/2/f/2f89cf0f-f682-44f8-879c-ed1e22f849b0.jpg?1783931500", "scryfall_url": "https://scryfall.com/card/thb/273/sunlit-hoplite?utm_source=api", "types": ["Creature"], "color_identity": ["W"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 1.0, "total": 0.2}}, {"name": "Elspeth's Devotee", "image_url": "https://cards.scryfall.io/normal/front/0/f/0f82064c-b335-454c-9be6-9fbcb21aa8e5.jpg?1783931499", "scryfall_url": "https://scryfall.com/card/thb/272/elspeths-devotee?utm_source=api", "types": ["Creature"], "color_identity": ["W"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.973, "total": 0.195}}, {"name": "Elspeth's Smite", "image_url": "https://cards.scryfall.io/normal/front/f/0/f03a480f-de67-4611-9db7-c0c3d020f597.jpg?1783917066", "scryfall_url": "https://scryfall.com/card/mom/13/elspeths-smite?utm_source=api", "types": ["Instant"], "color_identity": ["W"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.808, "total": 0.162}}, {"name": "Sylvan Messenger", "image_url": "https://cards.scryfa