data: {"chips": ["Character: Elspeth Tirel", "Plane: Theros", "Play style: character-focused thematic deck"], "characters": [{"name": "Elspeth Tirel", "role": "central"}], "intro": "Two thematic sides for an Elspeth Tirel deck focused on her fight for Theros: one side centers on Elspeth and cards tied to her Theros story and soldier/token theme; the other side provides green support that represents the army-building, token production, and battlefield growth that lets Elspeth hold Theros against its threats.", "groups": [{"title": "Elspeth and the Theros Vanguard", "explanation": "This group collects Elspeth herself plus cards that reinforce her soldier/token identity and connect directly to Theros-era themes: tutor/search and small, efficient soldiers that benefit from a planeswalker's presence or that echo Elspeth's role on Theros.", "cards": [{"name": "Elspeth Tirel", "image_url": "https://cards.scryfall.io/normal/front/e/b/ebe9116e-7b04-4f2a-aa67-89a42c6e1801.jpg?1783941746", "scryfall_url": "https://scryfall.com/card/som/6/elspeth-tirel?utm_source=api", "types": ["Planeswalker"], "color_identity": ["W"], "evidence": ["lore"], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.0, "total": 0.4}, "reason": "The deck's namesake planeswalker creates and buffs a board of small creatures (+2 creates life based on creature count; \u22122 makes three 1/1 Soldier tokens) and can act as a board reset with a powerful \u22125. The card embodies Elspeth's role as a soldier-maker and battlefield controller; story notes place Elspeth on Theros and record her death there, anchoring the deck's thematic focus on her fight for that plane.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-1-homecoming-2022-03-28", "https://magic.wizards.com/en/news/magic-story/episode-6-the-last-to-leave"], "source_titles": ["Streets of New Capenna | Episode 1: Homecoming", "March of the Machine | Episode 6: The Last to Leave"]}, {"name": "Elspeth's Devotee", "image_url": "https://cards.scryfall.io/normal/front/0/f/0f82064c-b335-454c-9be6-9fbcb21aa8e5.jpg?1783931499", "scryfall_url": "https://scryfall.com/card/thb/272/elspeths-devotee?utm_source=api", "types": ["Creature"], "color_identity": ["W"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.973, "total": 0.195}, "reason": "Serves as a tutor/discovery engine for an Elspeth card (it can find a card named Elspeth, Undaunted Hero from library or graveyard), supporting recursion or toolbox builds that want to recur Elspeth-themed effects.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-1-homecoming-2022-03-28"], "source_titles": ["Streets of New Capenna | Episode 1: Homecoming"]}, {"name": "Sunlit Hoplite", "image_url": "https://cards.scryfall.io/normal/front/2/f/2f89cf0f-f682-44f8-879c-ed1e22f849b0.jpg?1783931500", "scryfall_url": "https://scryfall.com/card/thb/273/sunlit-hoplite?utm_source=api", "types": ["Creature"], "color_identity": ["W"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 1.0, "total": 0.2}, "reason": "A cheap soldier that gains first strike during the controller's turn and gets +1/+0 while an Elspeth planeswalker is on the battlefield, providing synergy with Elspeth's token-making to create efficient attackers.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/episode-1-homecoming-2022-03-28"], "source_titles": ["Streets of New Capenna | Episode 1: Homecoming"]}, {"name": "Elspeth's Smite", "image_url": "https://cards.scryfall.io/normal/front/f/0/f03a480f-de67-4611-9db7-c0c3d020f597.jpg?1783917066", "scryfall_url": "https://scryfall.com/card/mom/13/elspeths-smite?utm_source=api", "types": ["Instant"], "color_identity": ["W"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.808, "total": 0.162}, "reason": "A single-white instant removal that trades up vs attacking or blocking creatures and exiles them if they would die this turn, protecting Elspeth's board from ground-level threats or removing key blockers.", "source_urls": [], "source_titles": []}, {"name": "Invasion of Theros // Ephara, Ever-Sheltering", "image_url": "https://cards.scryfall.io/normal/front/4/3/433e9f1c-9d6c-4c7e-89d0-79595b4331f2.jpg?1783917071", "scryfall_url": "https://scryfall.com/card/mom/23/invasion-of-theros-ephara-ever-sheltering?utm_source=api", "types": ["Creature", "Enchantment", "Battle"], "color_identity": ["W", "U"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.722, "total": 0.764}, "reason": "Provides a direct Theros seal to the deck: the Siege side tutors Auras, Gods, or Demigods on entry (helpful for finding thematic pieces), while Ephara transformed is a lifelinking indestructible presence that fits a defensive, gods-protecting narrative on Theros.", "source_urls": [], "source_titles": []}, {"name": "Tasha, the Witch Queen", "image_url": "https://cards.scryfall.io/normal/front/b/1/b1c5f679-82d0-4434-9f13-d39ad57282b8.jpg?1783922685", "scryfall_url": "https://scryfall.com/card/clb/294/tasha-the-witch-queen?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U", "B"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.569, "total": 0.114}, "reason": "A nontraditional inclusion to amplify card advantage and generate bodies: casting spells not owned by the deck makes 3/3 Demon tokens, and Tasha's +1 and \u22123 abilities interact with exiled instants/sorceries for additional value\u2014useful in a deck that might re-use opponent cards or support a value-gameplan around Elspeth's steady token creation.", "source_urls": [], "source_titles": []}]}, {"title": "Army-Builders and Battlefield Support", "explanation": "These green and green-white cards push the deck toward a mass-creature, anthem, and pump strategy that turns Elspeth's small soldiers into a decisive army: token generation, Elf synergies that scale, and mass pump effects that make the soldier tokens threatening.", "cards": [{"name": "Esika's Chariot", "image_url": "https://cards.scryfall.io/normal/front/a/8/a87606cc-fbf0-4e2c-9798-f1c935d0573d.jpg?1783928215", "scryfall_url": "https://scryfall.com/card/khm/169/esikas-chariot?utm_source=api", "types": ["Artifact"], "color_identity": ["G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.587, "total": 0.117}, "reason": "Creates two 2/2 Cat tokens on entry and can copy a token when it attacks; this converts token generation into larger attacking threats and pairs well with repeated token sources such as Elspeth's \u22122.", "source_urls": [], "source_titles": []}, {"name": "Voice of the Woods", "image_url": "https://cards.scryfall.io/normal/front/d/7/d7a6315c-aa6f-4be1-a002-d7824bfad622.jpg?1783928307", "scryfall_url": "https://scryfall.com/card/khc/78/voice-of-the-woods?utm_source=api", "types": ["Creature"], "color_identity": ["G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.666, "total": 0.133}, "reason": "A late-game finisher that can convert a large Elf board into a single 7/7 trampling elemental token by tapping five untapped Elves; in a token-focused build, this turns many small bodies into a punchy threat to close out the game.", "source_urls": [], "source_titles": []}, {"name": "Arboreal Alliance", "image_url": "https://cards.scryfall.io/normal/front/1/0/107f9fbf-4111-41a8-8e5d-9889fa2e3047.jpg?1783914199", "scryfall_url": "https://scryfall.com/card/ltc/497/arboreal-alliance?utm_source=api", "types": ["Enchantment"], "color_identity": ["G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.575, "total": 0.115}, "reason": "Scales with X to create an initial Treefolk and then populates (copy a token) whenever attacking with Elves, enabling exponential growth of token armies when paired with recurring token producers.", "source_urls": [], "source_titles": []}, {"name": "Timberwatch Elf", "image_url": "https://cards.scryfall.io/normal/front/3/8/38807f17-1cf2-4736-ad10-df6c8b1a9f55.jpg?1783928309", "scryfall_url": "https://scryfall.com/card/khc/76/timberwatch-elf?utm_source=api", "types": ["Creature"], "color_identity": ["G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.598, "total": 0.12}, "reason": "A tap-based pump that boosts a single creature by +X/+X equal to the number of Elves on the battlefield, turning token counts into single-creature threats\u2014good for making a soldier or token into a combat finisher.", "source_urls": [], "source_titles": []}, {"name": "Wirewood Pride", "image_url": "https://cards.scryfall.io/normal/front/a/5/a559e844-06c9-4953-bc2c-a58e4170fe47.jpg?1783945032", "scryfall_url": "https://scryfall.com/card/ons/303/wirewood-pride?utm_source=api", "types": ["Instant"], "color_identity": ["G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.586, "total": 0.117}, "reason": "An instant that pumps a creature based on total Elves, useful as an instant-speed combat trick to protect Elspeth's key attackers or to make a surprise lethal attack.", "source_urls": [], "source_titles": []}, {"name": "Heedless One", "image_url": "https://cards.scryfall.io/normal/front/e/1/e19879a4-7c77-4bfd-a7fa-5fe5cc82a193.jpg?1783938774", "scryfall_url": "https://scryfall.com/card/evg/7/heedless-one?utm_source=api", "types": ["Creature"], "color_identity": ["G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.594, "total": 0.119}, "reason": "A threat whose power/toughness are each equal to the number of Elves on the battlefield; when the deck builds a large Elf/token count, Heedless One becomes an immediate giant attacker with trample.", "source_urls": [], "source_titles": []}, {"name": "Arboreal Alliance", "image_url": "https://cards.scryfall.io/normal/front/1/0/107f9fbf-4111-41a8-8e5d-9889fa2e3047.jpg?1783914199", "scryfall_url": "https://scryfall.com/card/ltc/497/arboreal-alliance?utm_source=api", "types": ["Enchantment"], "color_identity": ["G"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.575, "total": 0.115}, "reason": "Provides both an X/X Treefolk on entry and repeatable populate when attacking with Elves, serving as a way to expand token counts and transform Elspeth's small soldiers into a much larger token army.", "source_urls": [], "source_titles": []}]}]}

