event: explanation
data: {"index": 0, "title": "Jace engines (primary win and value)", "explanation": "Planeswalker Jaces provide the deck's repeated card advantage, mill finishers, and alternate win conditions. These choices cover early card filtering, midgame steady advantage, and late-game decisive effects.", "cards": [{"name": "Jace, Wielder of Mysteries", "image_url": "https://cards.scryfall.io/normal/front/6/a/6adb7d73-4482-4930-8497-cffd169b57e2.jpg?1783933463", "scryfall_url": "https://scryfall.com/card/war/54/jace-wielder-of-mysteries?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.026, "total": 0.625}, "reason": "Provides an alternate win condition when the library is empty and converts draw actions into milling with its +1. The \u22128 is a huge draw engine that also can produce the win if the deck empties the library.", "source_urls": [], "source_titles": []}, {"name": "Jace Beleren", "image_url": "https://cards.scryfall.io/normal/front/8/0/806d4e61-004f-4e52-b2e8-ba11b922cc7d.jpg?1783915442", "scryfall_url": "https://scryfall.com/card/cmm/850/jace-beleren?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 1.0, "similarity": 0.195, "total": 0.819}, "reason": "Classic Jace that constantly trades incremental card draw between players and can turn into a massive milling effect with its \u221210, fitting a mill-oriented 'mind-games' plan that sacrifices parity for a single large payoff.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/assault-on-new-phyrexia-or-episode-5-inevitable-resolutions", "https://magic.wizards.com/en/news/magic-story/assault-on-new-phyrexia-or-episode-4-impossible-odds", "https://magic.wizards.com/en/news/magic-story/epilogue-1-the-invasion-tree"], "source_titles": ["Assault on New Phyrexia | Episode 5: Inevitable Resolutions", "Assault on New Phyrexia | Episode 4: Impossible Odds", "Outlaws of Thunder Junction | Epilogue 1: Bring the End, Part 1"]}, {"name": "Jace, Unraveler of Secrets", "image_url": "https://cards.scryfall.io/normal/front/3/d/3d9c8217-013d-4e75-bdd1-9c46c8467edb.jpg?1783908162", "scryfall_url": "https://scryfall.com/card/inr/70/jace-unraveler-of-secrets?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.116, "total": 0.643}, "reason": "Reliable card selection and draw via +1 (scry then draw); the \u22128 emblem can lock down opponents' first spells each turn, punishing their expected sequencing and rewarding careful timing.", "source_urls": [], "source_titles": []}, {"name": "Jace, Vryn's Prodigy // Jace, Telepath Unbound", "image_url": "https://cards.scryfall.io/normal/front/0/2/02d6d693-f1f3-4317-bcc0-c21fa8490d38.jpg?1783938353", "scryfall_url": "https://scryfall.com/card/ori/60/jace-vryns-prodigy-jace-telepath-unbound?utm_source=api", "types": ["Creature", "Planeswalker"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.695, "total": 0.759}, "reason": "A low-cost value engine: its tap ability cycles through cards early, and once transformed it becomes a planeswalker that can recur small spells or provide tempo through its \u22123 ability.", "source_urls": [], "source_titles": []}, {"name": "Jace Reawakened", "image_url": "https://cards.scryfall.io/normal/front/f/d/fd17e8d4-499e-4005-ae3c-bc9c44dc5a67.jpg?1783911774", "scryfall_url": "https://scryfall.com/card/otj/271/jace-reawakened?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.933, "synergy": 0.0, "similarity": 0.665, "total": 0.712}, "reason": "Strong midrange card advantage: a draw-then-discard +1, a plotting ability to set up explosive turns, and a late-game \u22126 that copies spells for high-impact turns.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 1, "title": "Card selection, digging and manipulation", "explanation": "Low-cost cantrips, scrying, and deeper library manipulation keep the Jace engines fed and enable mill or empty-library strategies while denying opponents clean answers.", "cards": [{"name": "Serum Visions", "image_url": "https://cards.scryfall.io/normal/front/5/b/5b75eb6b-d76c-4b92-b042-13493f9ef164.jpg?1783911938", "scryfall_url": "https://scryfall.com/card/otc/112/serum-visions?utm_source=api", "types": ["Sorcery"], "color_identity": ["U"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.629, "similarity": 0.385, "total": 0.316}, "reason": "Cheap draw and scry to sculpt upcoming draws and trigger 'draw' synergies while setting up the top of the library for mill or combo lines.", "source_urls": [], "source_titles": []}, {"name": "Contingency Plan", "image_url": "https://cards.scryfall.io/normal/front/9/e/9edb76bd-db4b-4279-8eaa-dfdf5952eafc.jpg?1783937505", "scryfall_url": "https://scryfall.com/card/emn/52/contingency-plan?utm_source=api", "types": ["Sorcery"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.667, "synergy": 0.0, "similarity": 0.0, "total": 0.413}, "reason": "Surveil 5 lets the deck rearrange and dump cards into the graveyard while arranging future draws\u2014excellent for plotting mill or graveyard-based transformation triggers.", "source_urls": [], "source_titles": []}, {"name": "Epiphany at the Drownyard", "image_url": "https://cards.scryfall.io/normal/front/6/4/64b44364-8f83-4dcf-8458-0fd54a698524.jpg?1783937800", "scryfall_url": "https://scryfall.com/card/soi/59/epiphany-at-the-drownyard?utm_source=api", "types": ["Instant"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.667, "synergy": 0.0, "similarity": 0.132, "total": 0.44}, "reason": "Directly presents opponent choice over revealed piles, enabling high-level mind-game decisions and powerful selection when X is large; it pairs with scrying to present difficult choices.", "source_urls": [], "source_titles": []}, {"name": "Ugin's Insight", "image_url": "https://cards.scryfall.io/normal/front/f/3/f37d5938-9c8f-4203-8f3f-d6e89ced28ef.jpg?1783938206", "scryfall_url": "https://scryfall.com/card/bfz/87/ugins-insight?utm_source=api", "types": ["Sorcery"], "color_identity": ["U"], "evidence": ["lore", "synergy"], "scores": {"story": 0.667, "synergy": 0.907, "similarity": 0.168, "total": 0.791}, "reason": "Scales with board presence (greatest mana value among permanents) to produce deep scrying followed by three cards, turning larger board states into raw card advantage.", "source_urls": [], "source_titles": []}, {"name": "Jace's Triumph", "image_url": "https://cards.scryfall.io/normal/front/4/9/4924f177-5ee2-4d3f-9603-4b9aef4dac09.jpg?1783933463", "scryfall_url": "https://scryfall.com/card/war/55/jaces-triumph?utm_source=api", "types": ["Sorcery"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.86, "total": 0.172}, "reason": "Flexible draw spell that becomes stronger with a Jace in play, converting planeswalker presence into incremental advantage.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 2, "title": "Mill and card-draw punishment", "explanation": "Effects that convert drawing into opponent library pressure or accelerate milling support both Jace's alternate win and the deck's disruptive 'mind-games' identity.", "cards": [{"name": "Psychic Corrosion", "image_url": "https://cards.scryfall.io/normal/front/2/8/285d22fa-1623-463a-83c0-a9aa7c969ce2.jpg?1783934583", "scryfall_url": "https://scryfall.com/card/m19/68/psychic-corrosion?utm_source=api", "types": ["Enchantment"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.667, "synergy": 0.0, "similarity": 0.183, "total": 0.45}, "reason": "Every card draw mills each opponent two cards, turning the deck's heavy drawing and scrying into steady milling pressure that compounds with multiple card-draw sources.", "source_urls": [], "source_titles": []}, {"name": "Trail of Evidence", "image_url": "https://cards.scryfall.io/normal/front/4/b/4b150797-ee8d-42f8-adcb-2f4b1783c074.jpg?1783937783", "scryfall_url": "https://scryfall.com/card/soi/93/trail-of-evidence?utm_source=api", "types": ["Enchantment"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.667, "synergy": 0.0, "similarity": 0.075, "total": 0.428}, "reason": "Investigate on instants and sorceries creates Clues that can be sacrificed for additional card draw, converting spellcasting into repeatable draw and fueling Psychic Corrosion and planeswalker activations.", "source_urls": [], "source_titles": []}, {"name": "Contingency Plan", "image_url": "https://cards.scryfall.io/normal/front/9/e/9edb76bd-db4b-4279-8eaa-dfdf5952eafc.jpg?1783937505", "scryfall_url": "https://scryfall.com/card/emn/52/contingency-plan?utm_source=api", "types": ["Sorcery"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.667, "synergy": 0.0, "similarity": 0.0, "total": 0.413}, "reason": "Note: included already for dual role; Surveil 5 can bury key cards and accelerate milling or graveyard synergies when needed.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 3, "title": "Empower / token support (Reality Fracture toolbox)", "explanation": "Cards that create or boost Jace tokens and loyalty allow the deck to convert small triggers and incidental empowerment into persistent loyalty resources\u2014this supports repeat activations and sudden emblem generation.", "cards": [{"name": "Way of the Mind Sculptor", "image_url": "https://cards.scryfall.io/normal/front/5/8/5838af68-66c3-4fe8-ab89-0a1721b0cfeb.jpg?1789729565", "scryfall_url": "https://scryfall.com/card/fra/224/way-of-the-mind-sculptor?utm_source=api", "types": ["Enchantment"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.947, "total": 0.189}, "reason": "On entry it creates a Jace token with five loyalty, and it rewards activating loyalty abilities by empowering Jace further, enabling explosive multi-ability turns that replicate signature Jace effects.", "source_urls": [], "source_titles": []}, {"name": "Protege's Awakening", "image_url": "https://cards.scryfall.io/normal/front/a/0/a08c7ec2-4c6a-4db2-85a7-41afe8731523.jpg?1788878176", "scryfall_url": "https://scryfall.com/card/fra/37/proteges-awakening?utm_source=api", "types": ["Sorcery"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.96, "total": 0.192}, "reason": "Massively pumps a Jace token with six loyalty immediately and draws a card, giving an instant pool of loyalty to spend on multiple planeswalker abilities in one turn.", "source_urls": [], "source_titles": []}, {"name": "Keeper of the Quiet Hour", "image_url": "https://cards.scryfall.io/normal/front/b/6/b6331218-dbb8-44a9-8ba5-5fb1ab41c5c0.jpg?1788878239", "scryfall_url": "https://scryfall.com/card/fra/171/keeper-of-the-quiet-hour?utm_source=api", "types": ["Creature", "Artifact"], "color_identity": [], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.866, "total": 0.173}, "reason": "Small artifact creature that grants two loyalty to a Jace token on entry; helps ensure the deck can assemble usable Jace tokens through incidental bodies.", "source_urls": [], "source_titles": []}, {"name": "Countersculpt", "image_url": "https://cards.scryfall.io/normal/front/1/4/145b928d-a7ff-4fe5-ae4d-bbae7b1d955b.jpg?1788878107", "scryfall_url": "https://scryfall.com/card/fra/25/countersculpt?utm_source=api", "types": ["Instant"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.944, "total": 0.189}, "reason": "A counterspell with a specialized additional cost tying it to Jace; if the behold cost is met it also empowers a Jace token, mixing disruption with token loyalty growth.", "source_urls": [], "source_titles": []}, {"name": "No Admittance", "image_url": "https://cards.scryfall.io/normal/front/1/1/11ba4fdd-cc03-4bb6-a493-91a9785771d0.jpg?1788878170", "scryfall_url": "https://scryfall.com/card/fra/89/no-admittance?utm_source=api", "types": ["Sorcery"], "color_identity": ["R"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.888, "total": 0.178}, "reason": "A damage spell that also grants one loyalty when cast, useful as removal that incrementally builds a Jace token's loyalty pool.", "source_urls": [], "source_titles": []}, {"name": "Solve for Disappointment", "image_url": "https://cards.scryfall.io/normal/front/7/b/7beaa8c9-1a2c-4c88-b579-91e371d8d9e3.jpg?1788878155", "scryfall_url": "https://scryfall.com/card/fra/67/solve-for-disappointment?utm_source=api", "types": ["Sorcery"], "color_identity": ["B"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 1.0, "total": 0.2}, "reason": "Hand-disruption that also grants loyalty; it doubles as targeted interference and token fuel to keep Jace tokens well-resourced.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 4, "title": "Support utility and odd tricks", "explanation": "Complementary permanents and instant-speed options that produce card flow or reuse permanents to maximize triggers and protect planeswalkers.", "cards": [{"name": "Illusionist's Stratagem", "image_url": "https://cards.scryfall.io/normal/front/a/7/a7eede83-6f1b-4054-b01c-0da17b197bad.jpg?1783936772", "scryfall_url": "https://scryfall.com/card/aer/36/illusionists-stratagem?utm_source=api", "types": ["Instant"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.667, "synergy": 0.0, "similarity": 0.012, "total": 0.416}, "reason": "Can blink creatures (including artifact creatures that empower Jace tokens) to reuse enter-the-battlefield loyalty-granting effects and draws a card to keep momentum.", "source_urls": [], "source_titles": []}, {"name": "The Theorist, Jace Beleren", "image_url": "https://cards.scryfall.io/normal/front/2/0/20bb8c55-4b0b-425f-8201-b54fa2fdde86.jpg?1788329228", "scryfall_url": "https://scryfall.com/card/fra/43/the-theorist-jace-beleren?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.933, "synergy": 0.0, "similarity": 0.115, "total": 1.002}, "reason": "A Reality Fracture-era Jace that passively draws on opponents' draw steps and can return small enemy permanents to hand, pressuring opponents' plans while providing steady card advantage.", "source_urls": [], "source_titles": []}, {"name": "Jace, Mirror Mage", "image_url": "https://cards.scryfall.io/normal/front/8/6/86d34cbf-e424-461a-adf3-003d556a7859.jpg?1783915440", "scryfall_url": "https://scryfall.com/card/cmm/852/jace-mirror-mage?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.596, "total": 0.739}, "reason": "A low-cost planeswalker that can create nonlegendary Jace copies with kicker and acts as a repeatable Scry 2 and selective draw engine through its loyalty interactions.", "source_urls": [], "source_titles": []}]}

event: done
data: {"chips": ["Character: Jace Beleren", "Play style: mind-games"], "characters": [{"name": "Jace Beleren", "role": "central"}], "intro": "A compact blue 'mind-games' build centered on Jace planeswalkers and card-advantage / milling synergies. Groups separate planeswalker engines, card-draw and library-manipulation tools, and a lightweight empower / token support package that turns small interactions into recurring Jace loyalty value.", "groups": [{"title": "Jace engines (primary win and value)", "explanation": "Planeswalker Jaces provide the deck's repeated card advantage, mill finishers, and alternate win conditions. These choices cover early card filtering, midgame steady advantage, and late-game decisive effects.", "cards": [{"name": "Jace, Wielder of Mysteries", "image_url": "https://cards.scryfall.io/normal/front/6/a/6adb7d73-4482-4930-8497-cffd169b57e2.jpg?1783933463", "scryfall_url": "https://scryfall.com/card/war/54/jace-wielder-of-mysteries?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.026, "total": 0.625}, "reason": "Provides an alternate win condition when the library is empty and converts draw actions into milling with its +1. The \u22128 is a huge draw engine that also can produce the win if the deck empties the library.", "source_urls": [], "source_titles": []}, {"name": "Jace Beleren", "image_url": "https://cards.scryfall.io/normal/front/8/0/806d4e61-004f-4e52-b2e8-ba11b922cc7d.jpg?1783915442", "scryfall_url": "https://scryfall.com/card/cmm/850/jace-beleren?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["lore", "synergy"], "scores": {"story": 0.0, "synergy": 1.0, "similarity": 0.195, "total": 0.819}, "reason": "Classic Jace that constantly trades incremental card draw between players and can turn into a massive milling effect with its \u221210, fitting a mill-oriented 'mind-games' plan that sacrifices parity for a single large payoff.", "source_urls": ["https://magic.wizards.com/en/news/magic-story/assault-on-new-phyrexia-or-episode-5-inevitable-resolutions", "https://magic.wizards.com/en/news/magic-story/assault-on-new-phyrexia-or-episode-4-impossible-odds", "https://magic.wizards.com/en/news/magic-story/epilogue-1-the-invasion-tree"], "source_titles": ["Assault on New Phyrexia | Episode 5: Inevitable Resolutions", "Assault on New Phyrexia | Episode 4: Impossible Odds", "Outlaws of Thunder Junction | Epilogue 1: Bring the End, Part 1"]}, {"name": "Jace, Unraveler of Secrets", "image_url": "https://cards.scryfall.io/normal/front/3/d/3d9c8217-013d-4e75-bdd1-9c46c8467edb.jpg?1783908162", "scryfall_url": "https://scryfall.com/card/inr/70/jace-unraveler-of-secrets?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.116, "total": 0.643}, "reason": "Reliable card selection and draw via +1 (scry then draw); the \u22128 emblem can lock down opponents' first spells each turn, punishing their expected sequencing and rewarding careful timing.", "source_urls": [], "source_titles": []}, {"name": "Jace, Vryn's Prodigy // Jace, Telepath Unbound", "image_url": "https://cards.scryfall.io/normal/front/0/2/02d6d693-f1f3-4317-bcc0-c21fa8490d38.jpg?1783938353", "scryfall_url": "https://scryfall.com/card/ori/60/jace-vryns-prodigy-jace-telepath-unbound?utm_source=api", "types": ["Creature", "Planeswalker"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.695, "total": 0.759}, "reason": "A low-cost value engine: its tap ability cycles through cards early, and once transformed it becomes a planeswalker that can recur small spells or provide tempo through its \u22123 ability.", "source_urls": [], "source_titles": []}, {"name": "Jace Reawakened", "image_url": "https://cards.scryfall.io/normal/front/f/d/fd17e8d4-499e-4005-ae3c-bc9c44dc5a67.jpg?1783911774", "scryfall_url": "https://scryfall.com/card/otj/271/jace-reawakened?utm_source=api", "types": ["Planeswalker"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.933, "synergy": 0.0, "similarity": 0.665, "total": 0.712}, "reason": "Strong midrange card advantage: a draw-then-discard +1, a plotting ability to set up explosive turns, and a late-game \u22126 that copies spells for high-impact turns.", "source_urls": [], "source_titles": []}]}, {"title": "Card selection, digging and manipulation", "explanation": "Low-cost cantrips, scrying, and deeper library manipulation keep the Jace engines fed and enable mill or empty-library strategies while denying opponents clean answers.", "cards": [{"name": "Serum Visions", "image_url": "https://cards.scryfall.io/normal/front/5/b/5b75eb6b-d76c-4b92-b042-13493f9ef164.jpg?1783911938", "scryfall_url": "https://scryfall.com/card/otc/112/serum-visions?utm_source=api", "types": ["Sorcery"], "color_identity": ["U"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.629, "similarity": 0.385, "total": 0.316}, "reason": "Cheap draw and scry to sculpt upcoming draws and trigger 'draw' synergies while setting up the top of the library for mill or combo lines.", "source_urls": [], "source_titles": []}, {"name": "Contingency Plan", "image_url": "https://cards.scryfall.io/normal/front/9/e/9edb76bd-db4b-4279-8eaa-dfdf5952eafc.jpg?1783937505", "scryfall_url": "https://scryfall.com/card/emn/52/contingency-plan?utm_source=api", "types": ["Sorcery"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.667, "synergy": 0.0, "similarity": 0.0, "total": 0.413}, "reason": "Surveil 5 lets the deck rearrange and dump cards into the graveyard while arranging future draws\u2014excellent for plotting mill or graveyard-based transformation triggers.", "source_urls": [], "source_titles": []}, {"name": "Epiphany at the Drownyard", "image_url": "https://cards.scryfall.io/normal/front/6/4/64b44364-8f83-4dcf-8458-0fd54a698524.jpg?1783937800", "scryfall_url": "https://scryfall.com/card/soi/59/epiphany-at-the-drownyard?utm_source=api", "types": ["Instant"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.667, "synergy": 0.0, "similarity": 0.132, "total": 0.44}, "reason": "Directly presents opponent choice over revealed piles, enabling high-level mind-game decisions and powerful selection when X is large; it pairs with scrying to present difficult choices.", "source_urls": [], "source_titles": []}, {"name": "Ugin's Insight", "image_url": "https://cards.scryfall.io/normal/front/f/3/f37d5938-9c8f-4203-8f3f-d6e89ced28ef.jpg?1783938206", "scryfall_url": "https://scryfall.com/card/bfz/87/ugins-insight?utm_source=api", "types": ["Sorcery"], "color_identity": ["U"], "evidence": ["lore", "synergy"], "scores": {"story": 0.667, "synergy": 0.907, "similarity": 0.168, "total": 0.791}, "reason": "Scales with board presence (greatest mana value among permanents) to produce deep scrying followed by three cards, turning larger board states into raw card advantage.", "source_urls": [], "source_titles": []}, {"name": "Jace's Triumph", "image_url": "https://cards.scryfall.io/normal/front/4/9/4924f177-5ee2-4d3f-9603-4b9aef4dac09.jpg?1783933463", "scryfall_url": "https://scryfall.com/card/war/55/jaces-triumph?utm_source=api", "types": ["Sorcery"], "color_identity": ["U"], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.86, "total": 0.172}, "reason": "Flexible draw spell that becomes stronger with a Jace in play, converting planeswalker presence into incremental advantage.", "source_urls": [], "source_titles": []}]}, {"title": "Mill and card-draw punishment", "explanation": "Effects that convert drawing into opponent library pressure or accelerate milling support both Jace's alternate win and the deck's disruptive 'mind-games' identity.", "cards": [{"name": "Psychic Corrosion", "image_url": "https://cards.scryfall.io/normal/front/2/8/285d22fa-1623-463