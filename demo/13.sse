event: explanation
data: {"index": 0, "title": "Core Karn artifact-creature engines", "explanation": "These cards create the main game plan of turning artifacts into creatures, scaling Karn's size, and producing artifact mana to power further plays.", "cards": [{"name": "Karn, Silver Golem", "image_url": "https://cards.scryfall.io/normal/front/0/5/055a00a2-0df2-4f49-ac51-e33dfaf7ee85.jpg?1783939234", "scryfall_url": "https://scryfall.com/card/vma/270/karn-silver-golem?utm_source=api", "types": ["Creature", "Artifact"], "color_identity": [], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.97, "total": 0.194}, "reason": "Provides the signature artifact-to-creature conversion ability: it can make a noncreature artifact become an artifact creature with power/toughness equal to its mana value for {1}. Also has a combat-related toughness shift when blocking or being blocked that can matter defensively.", "source_urls": [], "source_titles": []}, {"name": "Karn, Legacy Reforged", "image_url": "https://cards.scryfall.io/normal/front/4/2/4219b5ea-a252-4d76-a60a-9674340e8ed3.jpg?1783916509", "scryfall_url": "https://scryfall.com/card/mat/49/karn-legacy-reforged?utm_source=api", "types": ["Creature", "Artifact"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.99, "total": 0.818}, "reason": "Karn's power/toughness are set to the greatest mana value among artifacts controlled, which rewards assembling high-mana-value artifacts. Its upkeep ability produces colorless mana for each artifact controlled, helping pay artifact costs and enabling artifact synergies; that mana is restricted to artifact spells.", "source_urls": [], "source_titles": []}, {"name": "Karn, Gilded Guardian", "image_url": "https://cards.scryfall.io/normal/front/3/a/3abcae65-5b21-4c98-adad-34b8bc76ea3a.jpg?1789014541", "scryfall_url": "https://scryfall.com/card/fra/272/karn-gilded-guardian?utm_source=api", "types": ["Creature", "Artifact"], "color_identity": ["W", "U", "B", "R", "G"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 1.0, "total": 0.82}, "reason": "Enters and draws cards based on the number of colors among other artifacts, turning a multicolored-artifact base into card advantage while itself being a large vigilance/trample artifact creature suitable for attack or as a creature-based threat.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 1, "title": "Karn planeswalkers & control tools", "explanation": "Planeswalker Karns and related legendary artifacts provide disruption, recursion, and big game finishes that support the artifact-creature plan or reset the game in the player's favor.", "cards": [{"name": "Karn, Scion of Urza", "image_url": "https://cards.scryfall.io/normal/front/0/7/07a3d9e8-8597-498b-869c-cff79e0df516.jpg?1783935054", "scryfall_url": "https://scryfall.com/card/dom/1/karn-scion-of-urza?utm_source=api", "types": ["Planeswalker"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.547, "total": 0.729}, "reason": "Builds a silver-counter exile toolbox and generates Construct tokens; the +1 and \u22121 let the deck stash and later retrieve cards, supporting value and recursion for artifact-oriented strategies.", "source_urls": [], "source_titles": []}, {"name": "Karn, Living Legacy", "image_url": "https://cards.scryfall.io/normal/front/e/8/e83b1b87-01d5-4624-8a2b-4b771e13e59c.jpg?1783921372", "scryfall_url": "https://scryfall.com/card/dmu/1/karn-living-legacy?utm_source=api", "types": ["Planeswalker"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.293, "total": 0.679}, "reason": "Creates a tapped Powerstone token (+artifact mana source) and its \u22121 lets the deck dig and select among cards, allowing finding key artifacts or mana pieces while furthering an artifact-mana theme.", "source_urls": [], "source_titles": []}, {"name": "Karn, the Great Creator", "image_url": "https://cards.scryfall.io/normal/front/d/e/deb3721d-fba1-444f-8b31-1cd10c94c4a0.jpg?1783913351", "scryfall_url": "https://scryfall.com/card/rvr/1/karn-the-great-creator?utm_source=api", "types": ["Planeswalker"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.236, "similarity": 0.315, "total": 0.773}, "reason": "Shuts down activated abilities of opponents' artifacts and can animate a noncreature artifact into a creature temporarily, providing both hate against opposing artifact strategies and additional artifact-creature interaction on demand. Its \u22122 also accesses an artifact from outside the game, enabling a toolbox effect.", "source_urls": [], "source_titles": []}, {"name": "Karn Liberated", "image_url": "https://cards.scryfall.io/normal/front/4/b/4b0c6662-4dde-40a2-97e0-0318478c0367.jpg?1783930222", "scryfall_url": "https://scryfall.com/card/2xm/1/karn-liberated?utm_source=api", "types": ["Planeswalker"], "color_identity": [], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.771, "similarity": 0.648, "total": 0.423}, "reason": "Provides heavy removal by exiling permanents and a powerful long-game restart ultimate that can recast exiled non-Aura permanents under the player's control, a blue-chip finisher in artifact-focused builds that exile opposing answers and then steal the late game.", "source_urls": [], "source_titles": []}, {"name": "Karn's Sylex", "image_url": "https://cards.scryfall.io/normal/front/6/7/673a8676-0a93-4ca3-a786-63f138027e8a.jpg?1783921268", "scryfall_url": "https://scryfall.com/card/dmu/234/karns-sylex?utm_source=api", "types": ["Artifact"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.908, "total": 0.692}, "reason": "A disruptive legendary artifact that prevents life payment for costs while also offering a scalable mass-destruction ability (exile nonland permanents with mana value X or less) when paid and tapped, useful as a board reset that interacts well with careful artifact sizing.", "source_urls": [], "source_titles": []}, {"name": "Karn's Temporal Sundering", "image_url": "https://cards.scryfall.io/normal/front/7/a/7a64c1a4-02ce-49d2-97f2-970b8c33672d.jpg?1783935025", "scryfall_url": "https://scryfall.com/card/dom/55/karns-temporal-sundering?utm_source=api", "types": ["Sorcery"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.686, "total": 0.648}, "reason": "A legendary sorcery that grants an extra turn and can bounce a nonland permanent; in a Karn/legendary-artifact shell, this can be a strong tempo/value play to gain time or reuse enter-the-battlefield effects.", "source_urls": [], "source_titles": []}]}

event: explanation
data: {"index": 2, "title": "Artifact utility, mana and finishers", "explanation": "Supporting pieces that accelerate the artifact plan, provide card advantage or creature value, and offer alternate finishers that benefit from artifact-heavy board states.", "cards": [{"name": "Karn's Bastion", "image_url": "https://cards.scryfall.io/normal/front/2/2/22017ec2-3552-4865-af76-dba042b141f5.jpg?1783906011", "scryfall_url": "https://scryfall.com/card/eoc/163/karns-bastion?utm_source=api", "types": ["Land"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.244, "total": 0.559}, "reason": "A land that can proliferate for {4}, which compounds +1/+1, loyalty, and other counters on artifacts and planeswalkers\u2014useful for growing Karn's loyalty or proliferating any counters produced by artifacts or cards in the deck.", "source_urls": [], "source_titles": []}, {"name": "Silver Deputy", "image_url": "https://cards.scryfall.io/normal/front/3/9/39d2c11d-1eb8-4768-bc61-fa8f20a69462.jpg?1783911781", "scryfall_url": "https://scryfall.com/card/otj/248/silver-deputy?utm_source=api", "types": ["Creature", "Artifact"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.441, "total": 0.599}, "reason": "A cheap artifact creature that tutors a basic land or Desert to the top of the library when it enters, enabling consistent mana draws and smoothing; it also can buff a creature at sorcery speed.", "source_urls": [], "source_titles": []}, {"name": "Silver Raven", "image_url": "https://cards.scryfall.io/normal/front/a/6/a671ec19-32f4-4fde-8ee0-1224471e79db.jpg?1783926507", "scryfall_url": "https://scryfall.com/card/afr/74/silver-raven?utm_source=api", "types": ["Creature", "Artifact"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.424, "total": 0.595}, "reason": "A one-mana flying artifact creature that scries on entry, helping dig toward key artifact pieces or lands while also acting as an evasive creature for Karn or other synergies to animate or benefit from.", "source_urls": [], "source_titles": []}, {"name": "Silver Bolt", "image_url": "https://cards.scryfall.io/normal/front/e/b/eb2c05a8-db56-4397-9b6c-5accb2d3f81f.jpg?1783925546", "scryfall_url": "https://scryfall.com/card/mid/258/silver-bolt?utm_source=api", "types": ["Artifact"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.254, "total": 0.561}, "reason": "A sacrifice-based artifact that deals creature damage for {3} and a tap, functioning as repeatable removal that can clear problem creatures so Karn or animated artifacts can attack safely.", "source_urls": [], "source_titles": []}, {"name": "Imotekh the Stormlord", "image_url": "https://cards.scryfall.io/normal/front/2/8/286ff901-1faf-4a02-a37a-fa165989112f.jpg?1783920952", "scryfall_url": "https://scryfall.com/card/40k/5/imotekh-the-stormlord?utm_source=api", "types": ["Creature", "Artifact"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.725, "similarity": 0.556, "total": 0.387}, "reason": "An artifact creature that creates Necron Warrior artifact tokens whenever artifact cards leave the graveyard, and buffs another artifact creature at combat, providing token generation and combat support in an artifact-centered deck.", "source_urls": [], "source_titles": []}, {"name": "The Deck of Many Things", "image_url": "https://cards.scryfall.io/normal/front/f/e/feddbdc6-0757-43cb-bb41-dc83c6cf42ea.jpg?1783926439", "scryfall_url": "https://scryfall.com/card/afr/241/the-deck-of-many-things?utm_source=api", "types": ["Artifact"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.376, "total": 0.586}, "reason": "A legendary artifact that can return cards from graveyard, draw cards, or even cheat a creature onto the battlefield on a high roll, giving a high-variance but potentially huge late-game payoff in a deck that mills or sacrifices artifacts.", "source_urls": [], "source_titles": []}]}

event: done
data: {"chips": ["Character: Karn, the Silver Golem", "Card type: Legendary Artifact Creature", "Card type: Golem"], "characters": [{"name": "Karn, the Silver Golem", "role": "central"}], "intro": "A Karn-focused artifact deck built around turning artifacts into creatures, generating artifact mana, and leveraging Karn planeswalkers and artifact effects to win. Cards are grouped by role: core Karn artifact-creature engines, Karn planeswalker and control package, and artifact utility & finishers.", "groups": [{"title": "Core Karn artifact-creature engines", "explanation": "These cards create the main game plan of turning artifacts into creatures, scaling Karn's size, and producing artifact mana to power further plays.", "cards": [{"name": "Karn, Silver Golem", "image_url": "https://cards.scryfall.io/normal/front/0/5/055a00a2-0df2-4f49-ac51-e33dfaf7ee85.jpg?1783939234", "scryfall_url": "https://scryfall.com/card/vma/270/karn-silver-golem?utm_source=api", "types": ["Creature", "Artifact"], "color_identity": [], "evidence": [], "scores": {"story": 0.0, "synergy": 0.0, "similarity": 0.97, "total": 0.194}, "reason": "Provides the signature artifact-to-creature conversion ability: it can make a noncreature artifact become an artifact creature with power/toughness equal to its mana value for {1}. Also has a combat-related toughness shift when blocking or being blocked that can matter defensively.", "source_urls": [], "source_titles": []}, {"name": "Karn, Legacy Reforged", "image_url": "https://cards.scryfall.io/normal/front/4/2/4219b5ea-a252-4d76-a60a-9674340e8ed3.jpg?1783916509", "scryfall_url": "https://scryfall.com/card/mat/49/karn-legacy-reforged?utm_source=api", "types": ["Creature", "Artifact"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.99, "total": 0.818}, "reason": "Karn's power/toughness are set to the greatest mana value among artifacts controlled, which rewards assembling high-mana-value artifacts. Its upkeep ability produces colorless mana for each artifact controlled, helping pay artifact costs and enabling artifact synergies; that mana is restricted to artifact spells.", "source_urls": [], "source_titles": []}, {"name": "Karn, Gilded Guardian", "image_url": "https://cards.scryfall.io/normal/front/3/a/3abcae65-5b21-4c98-adad-34b8bc76ea3a.jpg?1789014541", "scryfall_url": "https://scryfall.com/card/fra/272/karn-gilded-guardian?utm_source=api", "types": ["Creature", "Artifact"], "color_identity": ["W", "U", "B", "R", "G"], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 1.0, "total": 0.82}, "reason": "Enters and draws cards based on the number of colors among other artifacts, turning a multicolored-artifact base into card advantage while itself being a large vigilance/trample artifact creature suitable for attack or as a creature-based threat.", "source_urls": [], "source_titles": []}]}, {"title": "Karn planeswalkers & control tools", "explanation": "Planeswalker Karns and related legendary artifacts provide disruption, recursion, and big game finishes that support the artifact-creature plan or reset the game in the player's favor.", "cards": [{"name": "Karn, Scion of Urza", "image_url": "https://cards.scryfall.io/normal/front/0/7/07a3d9e8-8597-498b-869c-cff79e0df516.jpg?1783935054", "scryfall_url": "https://scryfall.com/card/dom/1/karn-scion-of-urza?utm_source=api", "types": ["Planeswalker"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.547, "total": 0.729}, "reason": "Builds a silver-counter exile toolbox and generates Construct tokens; the +1 and \u22121 let the deck stash and later retrieve cards, supporting value and recursion for artifact-oriented strategies.", "source_urls": [], "source_titles": []}, {"name": "Karn, Living Legacy", "image_url": "https://cards.scryfall.io/normal/front/e/8/e83b1b87-01d5-4624-8a2b-4b771e13e59c.jpg?1783921372", "scryfall_url": "https://scryfall.com/card/dmu/1/karn-living-legacy?utm_source=api", "types": ["Planeswalker"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 1.0, "synergy": 0.0, "similarity": 0.293, "total": 0.679}, "reason": "Creates a tapped Powerstone token (+artifact mana source) and its \u22121 lets the deck dig and select among cards, allowing finding key artifacts or mana pieces while furthering an artifact-mana theme.", "source_urls": [], "source_titles": []}, {"name": "Karn, the Great Creator", "image_url": "https://cards.scryfall.io/normal/front/d/e/deb3721d-fba1-444f-8b31-1cd10c94c4a0.jpg?1783913351", "scryfall_url": "https://scryfall.com/card/rvr/1/karn-the-great-creator?utm_source=api", "types": ["Planeswalker"], "color_identity": [], "evidence": ["lore", "synergy"], "scores": {"story": 1.0, "synergy": 0.236, "similarity": 0.315, "total": 0.773}, "reason": "Shuts down activated abilities of opponents' artifacts and can animate a noncreature artifact into a creature temporarily, providing both hate against opposing artifact strategies and additional artifact-creature interaction on demand. Its \u22122 also accesses an artifact from outside the game, enabling a toolbox effect.", "source_urls": [], "source_titles": []}, {"name": "Karn Liberated", "image_url": "https://cards.scryfall.io/normal/front/4/b/4b0c6662-4dde-40a2-97e0-0318478c0367.jpg?1783930222", "scryfall_url": "https://scryfall.com/card/2xm/1/karn-liberated?utm_source=api", "types": ["Planeswalker"], "color_identity": [], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.771, "similarity": 0.648, "total": 0.423}, "reason": "Provides heavy removal by exiling permanents and a powerful long-game restart ultimate that can recast exiled non-Aura permanents under the player's control, a blue-chip finisher in artifact-focused builds that exile opposing answers and then steal the late game.", "source_urls": [], "source_titles": []}, {"name": "Karn's Sylex", "image_url": "https://cards.scryfall.io/normal/front/6/7/673a8676-0a93-4ca3-a786-63f138027e8a.jpg?1783921268", "scryfall_url": "https://scryfall.com/card/dmu/234/karns-sylex?utm_source=api", "types": ["Artifact"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.908, "total": 0.692}, "reason": "A disruptive legendary artifact that prevents life payment for costs while also offering a scalable mass-destruction ability (exile nonland permanents with mana value X or less) when paid and tapped, useful as a board reset that interacts well with careful artifact sizing.", "source_urls": [], "source_titles": []}, {"name": "Karn's Temporal Sundering", "image_url": "https://cards.scryfall.io/normal/front/7/a/7a64c1a4-02ce-49d2-97f2-970b8c33672d.jpg?1783935025", "scryfall_url": "https://scryfall.com/card/dom/55/karns-temporal-sundering?utm_source=api", "types": ["Sorcery"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.686, "total": 0.648}, "reason": "A legendary sorcery that grants an extra turn and can bounce a nonland permanent; in a Karn/legendary-artifact shell, this can be a strong tempo/value play to gain time or reuse enter-the-battlefield effects.", "source_urls": [], "source_titles": []}]}, {"title": "Artifact utility, mana and finishers", "explanation": "Supporting pieces that accelerate the artifact plan, provide card advantage or creature value, and offer alternate finishers that benefit from artifact-heavy board states.", "cards": [{"name": "Karn's Bastion", "image_url": "https://cards.scryfall.io/normal/front/2/2/22017ec2-3552-4865-af76-dba042b141f5.jpg?1783906011", "scryfall_url": "https://scryfall.com/card/eoc/163/karns-bastion?utm_source=api", "types": ["Land"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.244, "total": 0.559}, "reason": "A land that can proliferate for {4}, which compounds +1/+1, loyalty, and other counters on artifacts and planeswalkers\u2014useful for growing Karn's loyalty or proliferating any counters produced by artifacts or cards in the deck.", "source_urls": [], "source_titles": []}, {"name": "Silver Deputy", "image_url": "https://cards.scryfall.io/normal/front/3/9/39d2c11d-1eb8-4768-bc61-fa8f20a69462.jpg?1783911781", "scryfall_url": "https://scryfall.com/card/otj/248/silver-deputy?utm_source=api", "types": ["Creature", "Artifact"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.441, "total": 0.599}, "reason": "A cheap artifact creature that tutors a basic land or Desert to the top of the library when it enters, enabling consistent mana draws and smoothing; it also can buff a creature at sorcery speed.", "source_urls": [], "source_titles": []}, {"name": "Silver Raven", "image_url": "https://cards.scryfall.io/normal/front/a/6/a671ec19-32f4-4fde-8ee0-1224471e79db.jpg?1783926507", "scryfall_url": "https://scryfall.com/card/afr/74/silver-raven?utm_source=api", "types": ["Creature", "Artifact"], "color_identity": ["U"], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.424, "total": 0.595}, "reason": "A one-mana flying artifact creature that scries on entry, helping dig toward key artifact pieces or lands while also acting as an evasive creature for Karn or other synergies to animate or benefit from.", "source_urls": [], "source_titles": []}, {"name": "Silver Bolt", "image_url": "https://cards.scryfall.io/normal/front/e/b/eb2c05a8-db56-4397-9b6c-5accb2d3f81f.jpg?1783925546", "scryfall_url": "https://scryfall.com/card/mid/258/silver-bolt?utm_source=api", "types": ["Artifact"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.254, "total": 0.561}, "reason": "A sacrifice-based artifact that deals creature damage for {3} and a tap, functioning as repeatable removal that can clear problem creatures so Karn or animated artifacts can attack safely.", "source_urls": [], "source_titles": []}, {"name": "Imotekh the Stormlord", "image_url": "https://cards.scryfall.io/normal/front/2/8/286ff901-1faf-4a02-a37a-fa165989112f.jpg?1783920952", "scryfall_url": "https://scryfall.com/card/40k/5/imotekh-the-stormlord?utm_source=api", "types": ["Creature", "Artifact"], "color_identity": ["B"], "evidence": ["synergy"], "scores": {"story": 0.0, "synergy": 0.725, "similarity": 0.556, "total": 0.387}, "reason": "An artifact creature that creates Necron Warrior artifact tokens whenever artifact cards leave the graveyard, and buffs another artifact creature at combat, providing token generation and combat support in an artifact-centered deck.", "source_urls": [], "source_titles": []}, {"name": "The Deck of Many Things", "image_url": "https://cards.scryfall.io/normal/front/f/e/feddbdc6-0757-43cb-bb41-dc83c6cf42ea.jpg?1783926439", "scryfall_url": "https://scryfall.com/card/afr/241/the-deck-of-many-things?utm_source=api", "types": ["Artifact"], "color_identity": [], "evidence": ["lore"], "scores": {"story": 0.824, "synergy": 0.0, "similarity": 0.376, "total": 0.586}, "reason": "A legendary artifact that can return cards from graveyard, draw cards, or even cheat a creature onto the battlefield on a high roll, giving a high-variance but potentially huge late-game payoff in a deck that mills or sacrifices artifacts.", "source_urls": [], "source_titles": []}]}]}

